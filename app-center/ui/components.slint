// Shared components and UI elements used across all tabs
// This file defines reusable building blocks so we don't repeat code

import { LineEdit, Button, TextEdit, Spinner, ComboBox, GridBox } from "std-widgets.slint";

export struct AppItem {
    name: string,
    id: string,
    version: string,
    description: string,
    source: string,
    icon_path: string,
    homepage: string,
    votes: int,
    popularity: float,
    installed: bool,
    has-update: bool,
    selected: bool,
    update-progress: float,  // 0.0 to 1.0
}

export global Theme {
    in-out property <color> bg: #1e1e2e;
    in-out property <color> fg: #cdd6f4;
    in-out property <color> fg_dim: #a6adc8;
    in-out property <color> accent: #89b4fa;
    in-out property <color> bg_light: #45475a;
    in-out property <color> bg_lighter: #585b70;
    in-out property <color> danger: #f38ba8;
    in-out property <color> success: #a6e3a1;
    in-out property <color> warning: #f9e2af;
    in-out property <color> info: #94e2d5;
    in-out property <float> opacity: 0.40;
    in-out property <length> card_radius: 6px;
    in-out property <length> button_radius: 4px;
}

// -- Source badge --
export component SourceBadge inherits Rectangle {
    in property <string> label;
    in property <color> badge-color: Theme.accent;

    height: 18px;
    border-radius: 3px;
    background: root.badge-color.transparentize(0.8);
    width: badge-text.preferred-width + 10px;

    badge-text := Text {
        text: root.label;
        color: root.badge-color;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// -- Pill filter button --
export component FilterPill inherits Rectangle {
    in property <string> label;
    in-out property <bool> active: false;
    callback clicked();

    height: 26px;
    border-radius: 13px;
    background: root.active ? Theme.accent : Theme.bg_light;
    width: pill-text.preferred-width + 20px;

    pill-text := Text {
        text: root.label;
        color: root.active ? Theme.bg : Theme.fg;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.active = !root.active;
            root.clicked();
        }
        mouse-cursor: pointer;
    }
}

// -- Tab button (pluggable) --
export component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 28px;
    border-radius: 14px;
    background: root.active ? Theme.accent.transparentize(0.85) :
        (tab-touch.has-hover ? Theme.bg_light : transparent);
    width: tab-label.preferred-width + 20px;

    tab-label := Text {
        text: root.label;
        color: root.active ? Theme.accent : Theme.fg_dim;
        font-size: 11px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    tab-touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// -- Header button (close, help) --
export component HeaderButton inherits Rectangle {
    in property <string> label;
    in property <color> bg-color: Theme.bg_light;
    in property <color> hover-color: Theme.accent;
    callback clicked();

    border-radius: Theme.button_radius;
    background: btn-touch.has-hover ? root.hover-color : root.bg-color;
    min-width: 26px;
    height: 26px;

    HorizontalLayout {
        alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            color: btn-touch.has-hover ? Theme.bg : Theme.fg;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    btn-touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// -- Action button (install/remove/update) --
export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <color> btn-color: Theme.accent;
    in property <bool> busy: false;
    callback clicked();

    height: 30px;
    border-radius: Theme.button_radius;
    background: root.busy         ? Theme.bg_lighter :
        action-touch.pressed      ? root.btn-color.darker(0.15) :
        action-touch.has-hover    ? root.btn-color.brighter(0.25) :
                                    root.btn-color;
    width: action-label.preferred-width + 24px;

    action-label := Text {
        text: root.label;
        color: root.busy ? Theme.fg_dim : (action-touch.has-hover ? Theme.bg : Theme.fg);
        font-size: 10px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    action-touch := TouchArea {
        clicked => {
            if (!root.busy) { root.clicked(); }
        }
        mouse-cursor: root.busy ? default : pointer;
    }
}

// -- App card (list item) --
export component AppCard inherits Rectangle {
    in property <AppItem> item;
    in property <bool> is-selected: false;
    in property <bool> show-checkbox: false;
    in-out property <bool> checked: false;
    callback clicked();
    callback checkbox-toggled();

    height: 72px;
    background: root.is-selected ? Theme.accent.transparentize(0.9) : Theme.bg_light.transparentize(0.5);
    border-radius: Theme.card_radius;
    border-width: 1px;
    border-color: root.is-selected ? Theme.accent : Theme.bg_lighter;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;

        // Checkbox (if needed)
        if root.show-checkbox: Rectangle {
            width: 20px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 3px;
                    background: root.checked ? Theme.accent : Theme.bg_lighter;
                        border-width: 1px;
                        border-color: root.checked ? Theme.accent : Theme.fg_dim;
                            color: Theme.bg;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.checked = !root.checked;
                            root.checkbox-toggled();
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }

        // Icon
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 4px;
            background: root.item.source == "Pacman" ? Theme.info.transparentize(0.8) :
                root.item.source == "AUR" ? Theme.accent.transparentize(0.8) :
                root.item.source == "Flatpak" ? Theme.success.transparentize(0.8) :
                root.item.source == "AppImage" ? Theme.warning.transparentize(0.8) : Theme.bg_lighter;

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.item.icon_path != "" ? root.item.icon_path :
                        root.item.source == "Pacman" ? "P" :
                        root.item.source == "AUR" ? "A" :
                        root.item.source == "Flatpak" ? "F" :
                        root.item.source == "AppImage" ? "I" : "S";
                    color: root.item.source == "Pacman" ? Theme.info :
                        root.item.source == "AUR" ? Theme.accent :
                        root.item.source == "Flatpak" ? Theme.success :
                        root.item.source == "AppImage" ? Theme.warning : Theme.fg;
                    font-size: 20px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Content
        VerticalLayout {
            spacing: 4px;
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.item.name;
                    color: Theme.fg;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.item.version;
                    color: Theme.fg_dim;
                    font-size: 9px;
                    overflow: elide;
                }
            }

            SourceBadge {
                label: root.item.source;
                badge-color: root.item.source == "Pacman" ? Theme.info :
                    root.item.source == "AUR" ? Theme.accent :
                    root.item.source == "Flatpak" ? Theme.success :
                    root.item.source == "AppImage" ? Theme.warning : Theme.fg;
            }
        }

        // Update indicator (if has-update)
        if root.item.has-update: Rectangle {
            width: 12px;
            background: Theme.warning;
            border-radius: 6px;
        }

        Rectangle { horizontal-stretch: 1; }
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// -- Progress bar --
export component ProgressBar inherits Rectangle {
    in property <float> value: 0.0;  // 0.0 to 1.0
    in property <color> progress-color: Theme.accent;

    height: 4px;
    background: Theme.bg_lighter;
    border-radius: 2px;

    Rectangle {
        width: parent.width * root.value;
        height: parent.height;
        background: root.progress-color;
        border-radius: 2px;
    }
}
