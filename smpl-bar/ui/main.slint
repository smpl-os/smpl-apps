export global Theme {
    in-out property <color> bg: #1e1e2e;
    in-out property <color> fg: #cdd6f4;
    in-out property <color> fg-dim: #a6adc8;
    in-out property <color> accent: #89b4fa;
    in-out property <color> bg-light: #45475a;
    in-out property <color> bg-lighter: #585b70;
    in-out property <color> danger: #f38ba8;
    in-out property <color> success: #a6e3a1;
    in-out property <color> warning: #f9e2af;
    in-out property <color> info: #94e2d5;
    in-out property <float> opacity: 0.95;
    in-out property <float> popup-opacity: 0.92;
}

export struct WorkspaceUi {
    id: int,
    label: string,
    occupied: bool,
    visible: bool,
    focused: bool,
    temporary: bool,
}

export struct UsbUi {
    name: string,
    label: string,
    path: string,
    size: string,
    mounted: bool,
}

export struct MonitorUi {
    connector: string,
    description: string,
    active_workspace: int,
    focused: bool,
}

export struct TrayItemUi {
    key: string,
    title: string,
    icon_image: image,
    has_icon: bool,
    themed_icon: bool,
    overlay_image: image,
    has_overlay: bool,
    attention: bool,
    item_is_menu: bool,
}

export struct TrayMenuEntryUi {
    item_id: int,
    label: string,
    enabled: bool,
    checked: bool,
    separator: bool,
    level: int,
}

export struct KeypadItemUi {
    control: string,
    label: string,
    icon: string,
    active: bool,
    bound: bool,
    state: string,
    row: int,
    column: int,
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;
    callback secondary-clicked;
    callback scrolled(float);
    width: 24px;
    height: 28px;
    border-radius: 4px;
    background: root.enabled && touch.has-hover ? Theme.bg-light : transparent;
    accessible-role: button;
    accessible-label: tip;
    Text {
        x: 3px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.icon;
        font-size: 13px;
        font-family: "JetBrains Mono Nerd Font";
        color: root.active ? Theme.accent : Theme.fg;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.secondary-clicked();
            }
        }
        scroll-event(event) => {
            root.scrolled(event.delta-y / 1px);
            return accept;
        }
    }
}

component StartButton inherits Rectangle {
    callback clicked;
    width: 24px;
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.bg-light : transparent;
    accessible-role: button;
    accessible-label: "Start menu";
    Image {
        x: 3px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: @image-url("assets/start.svg");
        image-fit: contain;
        colorize: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => root.clicked();
    }
}

component WorkspaceButton inherits Rectangle {
    in property <WorkspaceUi> item;
    in property <bool> squares;
    in property <bool> active: item.focused;
    callback clicked(int);
    width: squares ? 9px : 22px;
    height: squares ? 9px : 24px;
    border-radius: squares ? 2px : 5px;
    border-width: squares && item.visible && !item.focused ? 1px : 0px;
    border-color: Theme.fg;
    background: item.focused ? Theme.accent
        : item.occupied ? Theme.accent.transparentize(0.55)
        : Theme.fg-dim.transparentize(squares ? 0.82 : 0.94);
    accessible-role: button;
    accessible-label: "Workspace " + item.id;
    if !squares: Text {
        text: item.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: item.focused ? 14px : 11px;
        color: item.focused ? Theme.bg : Theme.fg;
    }
    if item.temporary: Rectangle {
        y: parent.height - 2px;
        width: 100%;
        height: 1px;
        background: Theme.warning;
    }
    TouchArea {
        clicked => { root.clicked(item.id); }
    }
}

component TrayButton inherits Rectangle {
    in property <TrayItemUi> item;
    callback activate(string);
    callback secondary(string);
    callback scroll(string, float);
    width: 22px;
    height: 28px;
    border-radius: 4px;
    border-width: item.attention ? 1px : 0px;
    border-color: Theme.warning;
    background: touch.has-hover ? Theme.bg-light : transparent;
    accessible-role: button;
    accessible-label: item.title;
    if item.has-icon && item.themed-icon: Image {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: item.icon-image;
        image-fit: contain;
        colorize: Theme.fg;
    }
    if item.has-icon && !item.themed-icon: Image {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: item.icon-image;
        image-fit: contain;
    }
    if !item.has-icon: Text {
        text: item.item-is-menu ? "≡" : "·";
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 16px;
        color: item.attention ? Theme.warning : Theme.fg-dim;
    }
    if item.has-overlay: Image {
        width: 10px;
        height: 10px;
        x: parent.width - self.width - 1px;
        y: parent.height - self.height - 1px;
        source: item.overlay-image;
        image-fit: contain;
    }
    if item.attention: Rectangle {
        x: parent.width - 6px;
        y: 1px;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: Theme.warning;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => root.activate(item.key);
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.secondary(item.key);
            }
        }
        scroll-event(event) => {
            root.scroll(item.key, event.delta-y / 1px);
            return accept;
        }
    }
}

component PopupCloseButton inherits Rectangle {
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.bg-lighter.transparentize(0.55) : Theme.bg-light.transparentize(0.58);
    border-width: 1px;
    border-color: Theme.bg-lighter.transparentize(0.48);
    accessible-role: button;
    accessible-label: "Close";
    Text {
        text: "×";
        font-size: 18px;
        color: Theme.fg-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => root.clicked();
    }
}

component PopupHeader inherits Rectangle {
    in property <string> eyebrow: "SMPL / CONTROL";
    in property <string> title;
    callback close;
    height: 48px;
    HorizontalLayout {
        alignment: center;
        padding-left: 2px;
        padding-right: 2px;
        spacing: 10px;
        Rectangle {
            width: 3px;
            height: 28px;
            border-radius: 1.5px;
            background: Theme.accent;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: eyebrow;
                color: Theme.accent;
                font-size: 8px;
                font-weight: 700;
                letter-spacing: 1px;
                overflow: elide;
            }
            Text {
                text: title;
                color: Theme.fg;
                font-size: 16px;
                font-weight: 600;
                overflow: elide;
            }
        }
        PopupCloseButton { clicked => root.close(); }
    }
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.bg-lighter.transparentize(0.48);
    }
}

component QuickSettingCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> label;
    in property <string> detail;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    out property <length> icon-size: icon-box.width;
    out property <length> glyph-x: icon-glyph.x;
    out property <length> glyph-y: icon-glyph.y;
    out property <length> glyph-width: icon-glyph.width;
    out property <length> glyph-height: icon-glyph.height;
    out property <length> icon-center-offset-y: (icon-box.absolute-position.y + icon-box.height / 2)
        - (self.absolute-position.y + self.height / 2);
    min-width: 0px;
    height: 66px;
    border-radius: 10px;
    background: !enabled ? Theme.bg-light.transparentize(0.88)
        : active ? Theme.accent.transparentize(0.80)
        : touch.has-hover ? Theme.bg-light.transparentize(0.48)
        : Theme.bg-light.transparentize(0.68);
    border-width: 1px;
    border-color: active ? Theme.accent.transparentize(0.28)
        : Theme.bg-lighter.transparentize(0.52);
    accessible-role: button;
    accessible-label: title;
    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        alignment: center;
        padding: 10px;
        spacing: 9px;
        Rectangle {
            width: 34px;
            height: 100%;
            icon-box := Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: active ? Theme.accent.transparentize(0.68)
                    : Theme.bg-lighter.transparentize(0.64);
                icon-glyph := Text {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    text: icon;
                    font-family: "JetBrains Mono Nerd Font";
                    font-size: 17px;
                    color: enabled ? (active ? Theme.accent : Theme.fg) : Theme.fg-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            min-width: 0px;
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: label;
                color: enabled ? Theme.fg : Theme.fg-dim;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: detail;
                color: Theme.fg-dim;
                font-size: 9px;
                overflow: elide;
            }
        }
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: active ? Theme.accent
                : enabled ? Theme.fg-dim.transparentize(0.55)
                : transparent;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => root.clicked();
        mouse-cursor: root.enabled ? pointer : default;
    }
}

component QuickSlider inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in-out property <int> value;
    in property <bool> muted: false;
    in property <bool> mute-control: false;
    in property <int> minimum: 0;
    in-out property <bool> dragging: false;
    callback change(int);
    callback toggle-mute;
    out property <length> track-width: track.width;
    out property <length> track-x: track-touch.absolute-position.x;
    out property <length> track-y: track-touch.absolute-position.y;
    out property <length> icon-size: icon-box.width;
    out property <length> icon-glyph-x: icon-glyph.x;
    out property <length> icon-glyph-y: icon-glyph.y;
    out property <length> icon-glyph-width: icon-glyph.width;
    out property <length> icon-glyph-height: icon-glyph.height;
    out property <length> icon-center-offset-y: (icon-box.absolute-position.y + icon-box.height / 2)
        - (self.absolute-position.y + self.height / 2);
    out property <length> icon-column-width: icon-cell.width;
    out property <length> label-column-width: label-cell.width;
    out property <length> track-column-width: track-cell.width;
    out property <length> value-column-width: value-cell.width;
    out property <length> label-y: label-text.absolute-position.y;
    out property <length> label-height: label-text.height;
    out property <length> value-y: value-text.absolute-position.y;
    out property <length> value-height: value-text.height;
    out property <bool> columns-valid: icon-cell.width == 30px
        && label-cell.width == 64px
        && track-cell.width >= 72px
        && value-cell.width == 38px
        && label-cell.x == icon-cell.x + icon-cell.width + 8px
        && track-cell.x == label-cell.x + label-cell.width + 8px
        && value-cell.x == track-cell.x + track-cell.width + 8px
        && label-text.height == self.height
        && value-text.height == self.height
        && abs((label-text.absolute-position.y + label-text.height / 2)
            - (self.absolute-position.y + self.height / 2)) <= 0.5px
        && abs((value-text.absolute-position.y + value-text.height / 2)
            - (self.absolute-position.y + self.height / 2)) <= 0.5px;
    min-width: 0px;
    width: 100%;
    horizontal-stretch: 1;
    height: 42px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.bg-lighter.transparentize(0.56);
    background: Theme.bg-light.transparentize(0.74);
    GridLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        icon-cell := Rectangle {
            row: 0;
            col: 0;
            width: 30px;
            height: 100%;
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                icon-box := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 30px;
                    height: 30px;
                    border-radius: 7px;
                    background: muted ? Theme.danger.transparentize(0.80) : Theme.accent.transparentize(0.84);
                    icon-glyph := Text {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        text: icon;
                        color: muted ? Theme.danger : Theme.accent;
                        font-family: "JetBrains Mono Nerd Font";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 15px;
                    }
                    TouchArea {
                        enabled: root.mute-control;
                        mouse-cursor: root.mute-control ? pointer : default;
                        clicked => root.toggle-mute();
                    }
                }
            }
        }
        label-cell := Rectangle {
            row: 0;
            col: 1;
            width: 64px;
            height: 100%;
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                label-text := Text {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    text: label;
                    color: Theme.fg-dim;
                    font-size: 9px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        track-cell := Rectangle {
            row: 0;
            col: 2;
            min-width: 72px;
            horizontal-stretch: 1;
            height: 100%;
            track := Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                Rectangle {
                    x: 6px;
                    y: (parent.height - self.height) / 2;
                    width: max(0px, parent.width - 12px);
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.fg.transparentize(0.89);
                }
                Rectangle {
                    x: 6px;
                    y: (parent.height - self.height) / 2;
                    width: max(0px, parent.width - 12px) * clamp(root.value, root.minimum, 100) / 100;
                    height: 6px;
                    border-radius: 3px;
                    background: muted ? Theme.danger : Theme.accent;
                }
                Rectangle {
                    x: (parent.width - 12px) * clamp(root.value, root.minimum, 100) / 100;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: Theme.bg-light;
                    background: muted ? Theme.danger : Theme.accent;
                }
                track-touch := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    moved => {
                        if (self.pressed) {
                            root.value = clamp(round(((self.mouse-x - 6px) / max(1px, self.width - 12px)) * 100), root.minimum, 100);
                            root.change(root.value);
                        }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.dragging = true;
                            root.value = clamp(round(((self.mouse-x - 6px) / max(1px, self.width - 12px)) * 100), root.minimum, 100);
                            root.change(root.value);
                        } else if (event.kind == PointerEventKind.up && root.dragging) {
                            root.change(root.value);
                            root.dragging = false;
                        }
                    }
                    scroll-event(event) => {
                        if (event.delta-y != 0px) {
                            root.value = clamp(root.value + (event.delta-y < 0px ? 5 : -5), root.minimum, 100);
                            root.change(root.value);
                        }
                        return accept;
                    }
                }
            }
        }
        value-cell := Rectangle {
            row: 0;
            col: 3;
            width: 38px;
            height: 100%;
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                value-text := Text {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    text: value + "%";
                    color: Theme.fg;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component CommandAction inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> tint: Theme.accent;
    callback clicked;
    out property <length> icon-size: icon-box.width;
    out property <length> glyph-x: icon-glyph.x;
    out property <length> glyph-y: icon-glyph.y;
    out property <length> glyph-width: icon-glyph.width;
    out property <length> glyph-height: icon-glyph.height;
    out property <length> icon-center-offset-y: (icon-box.absolute-position.y + icon-box.height / 2)
        - (self.absolute-position.y + self.height / 2);
    min-width: 0px;
    height: 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.bg-lighter.transparentize(0.54);
    background: touch.has-hover ? Theme.bg-light.transparentize(0.42)
        : Theme.bg-light.transparentize(0.78);
    accessible-role: button;
    accessible-label: label;
    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;
        Rectangle {
            width: 26px;
            height: 100%;
            icon-box := Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 26px;
                height: 26px;
                icon-glyph := Text {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    text: icon;
                    color: tint;
                    font-family: "JetBrains Mono Nerd Font";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: label;
            color: Theme.fg;
            font-size: 10px;
            font-weight: 600;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => root.clicked();
    }
}

export component BarWindow inherits Window {
    in-out property <string> window-title-label: "smpl-bar";
    in-out property <[WorkspaceUi]> workspaces;
    in-out property <bool> workspace-squares: false;
    in-out property <bool> workspace-center: false;
    in-out property <length> workspace-spacing: 2px;
    in-out property <string> window-title;
    in-out property <string> monitor-label: "M1";
    in-out property <string> compositor: "native";
    in-out property <string> clock-main: "00:00";
    in-out property <string> clock-sub;
    in-out property <int> volume: 0;
    in-out property <bool> volume-muted: false;
    in-out property <int> battery: 0;
    in-out property <bool> battery-visible: false;
    in-out property <bool> battery-low: false;
    in-out property <bool> battery-charging: false;
    in-out property <bool> usb-visible: false;
    in-out property <bool> keypad-visible: false;
    in-out property <bool> sync-visible: false;
    in-out property <bool> dictation-visible: false;
    in-out property <bool> keyboard-visible: false;
    in-out property <bool> wifi-available: true;
    in-out property <bool> bluetooth-available: true;
    in-out property <bool> network-online: false;
    in-out property <bool> wifi-on: false;
    in-out property <bool> bluetooth-on: false;
    in-out property <bool> vpn-on: false;
    in-out property <int> notification-count: 0;
    in-out property <bool> notifications-paused: false;
    in-out property <string> keyboard-code;
    in-out property <bool> show-start: true;
    in-out property <bool> show-workspaces: true;
    in-out property <bool> show-title: true;
    in-out property <bool> show-usb: true;
    in-out property <bool> show-keypad: true;
    in-out property <bool> show-sync: true;
    in-out property <bool> show-dictation: true;
    in-out property <bool> show-keyboard: true;
    in-out property <bool> show-bluetooth: true;
    in-out property <bool> show-wifi: true;
    in-out property <bool> show-network: true;
    in-out property <bool> show-volume: true;
    in-out property <bool> show-battery: true;
    in-out property <bool> show-clock: true;
    in-out property <bool> show-notifications: true;
    in-out property <bool> show-sni: true;
    in-out property <[TrayItemUi]> sni-items;
    in-out property <bool> vertical: false;

    callback open-start;
    callback select-workspace(int);
    callback open-overview;
    callback open-quick-settings;
    callback open-usb;
    callback open-keypad;
    callback open-sync;
    callback toggle-dictation;
    callback next-keyboard;
    callback open-keyboard-settings;
    callback open-calendar;
    callback open-notifications;
    callback clear-notifications;
    callback volume-scroll(float);
    callback sni-activate(string);
    callback sni-secondary(string);
    callback sni-scroll(string, float);

    title: root.window-title-label;
    no-frame: true;
    min-width: 32px;
    min-height: 32px;
    preferred-width: 1600px;
    preferred-height: 32px;
    background: transparent;

    surface := Rectangle {
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: Theme.bg-lighter.transparentize(0.55);
        border-radius: 3px;
        background: Theme.bg.transparentize(1.0 - Theme.opacity);
        if !root.vertical: HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 3px;

            if show-start: StartButton {
                clicked => { root.open-start(); }
            }

            if show-workspaces && !workspace-center: HorizontalLayout {
                spacing: root.workspace-spacing;
                alignment: center;
                horizontal-stretch: 0;
                for workspace in root.workspaces: WorkspaceButton {
                    item: workspace;
                    squares: root.workspace-squares;
                    clicked(id) => { root.select-workspace(id); }
                }
                IconButton {
                    icon: "󰍹";
                    tip: "Workspace overview on " + root.monitor-label;
                    width: 34px;
                    clicked => { root.open-overview(); }
                }
            }

            if show-title && !workspace-center: Text {
                text: root.window-title;
                color: Theme.fg-dim;
                height: 28px;
                vertical-alignment: center;
                overflow: elide;
                max-width: 480px;
                horizontal-stretch: 1;
            }
            if root.workspace-center: Rectangle { horizontal-stretch: 1; }

            if show-workspaces && workspace-center: HorizontalLayout {
                spacing: root.workspace-spacing;
                alignment: center;
                horizontal-stretch: 0;
                for workspace in root.workspaces: WorkspaceButton {
                    item: workspace;
                    squares: root.workspace-squares;
                    clicked(id) => { root.select-workspace(id); }
                }
                IconButton {
                    icon: "󰍹";
                    tip: "Workspace overview on " + root.monitor-label;
                    width: 34px;
                    clicked => { root.open-overview(); }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            if show-usb && usb-visible: IconButton {
                icon: "󰕓";
                tip: "Removable drives";
                clicked => { root.open-usb(); }
            }
            if show-keypad && keypad-visible: IconButton {
                icon: "󰌌";
                tip: "Macro keypad";
                clicked => { root.open-keypad(); }
            }
            if show-sync && sync-visible: IconButton {
                icon: "󰓦";
                tip: "Sync in progress";
                clicked => { root.open-sync(); }
            }
            if show-dictation && dictation-visible: IconButton {
                icon: "󰍬";
                tip: "Toggle dictation";
                active: true;
                clicked => { root.toggle-dictation(); }
            }
            if show-keyboard && keyboard-visible: IconButton {
                icon: keyboard-code;
                tip: "Switch keyboard layout";
                clicked => { root.next-keyboard(); }
                secondary-clicked => { root.open-keyboard-settings(); }
            }
            if show-bluetooth && bluetooth-available: IconButton {
                icon: bluetooth-on ? "󰂯" : "󰂲";
                tip: "Bluetooth";
                active: bluetooth-on;
                clicked => { root.open-quick-settings(); }
            }
            if show-wifi && wifi-available: IconButton {
                icon: wifi-on ? "󰤨" : "󰤮";
                tip: "Wi-Fi";
                active: wifi-on;
                clicked => { root.open-quick-settings(); }
            }
            if show-network: IconButton {
                icon: vpn-on ? "󰖂" : (network-online ? "󰒍" : "󰣴");
                tip: vpn-on ? "VPN active" : (network-online ? "Network connected" : "Network offline");
                clicked => { root.open-quick-settings(); }
                active: network-online || vpn-on;
            }
            if show-volume: IconButton {
                icon: volume-muted || volume == 0 ? "󰖁" : (volume < 50 ? "󰖀" : "󰕾");
                tip: "Volume " + volume + "%";
                active: !volume-muted;
                clicked => { root.open-quick-settings(); }
                scrolled(delta) => { root.volume-scroll(delta); }
            }
            if show-battery && battery-visible: IconButton {
                icon: battery-charging ? "󰂄" : (battery-low ? "󰂃" : "󰁹");
                tip: "Battery " + battery + "%";
                active: !battery-low;
                clicked => { root.open-quick-settings(); }
            }
            if show-sni: HorizontalLayout {
                spacing: 1px;
                alignment: center;
                for item in root.sni-items: TrayButton {
                    item: item;
                    activate(key) => root.sni-activate(key);
                    secondary(key) => root.sni-secondary(key);
                    scroll(key, delta) => root.sni-scroll(key, delta);
                }
            }
            if show-clock: Rectangle {
                width: 62px;
                height: 28px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: clock-main;
                        horizontal-alignment: center;
                        color: Theme.fg;
                        font-size: 11px;
                    }
                    if clock-sub != "": Text {
                        text: clock-sub;
                        horizontal-alignment: center;
                        color: Theme.fg-dim;
                        font-size: 8px;
                    }
                }
                TouchArea {
                    clicked => { root.open-calendar(); }
                    mouse-cursor: pointer;
                }
            }
            if show-notifications: IconButton {
                icon: notifications-paused ? "󰂛" : (notification-count > 0 ? "󰂞" : "󰂜");
                tip: notification-count + " notifications";
                active: notification-count > 0;
                clicked => { root.open-notifications(); }
                secondary-clicked => { root.clear-notifications(); }
            }
        }

        if root.vertical: VerticalLayout {
            padding-left: 2px;
            padding-right: 2px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 3px;
            alignment: center;

            if show-start: StartButton {
                clicked => { root.open-start(); }
            }

            if show-workspaces && !workspace-center: VerticalLayout {
                spacing: root.workspace-spacing;
                alignment: center;
                for workspace in root.workspaces: WorkspaceButton {
                    item: workspace;
                    squares: root.workspace-squares;
                    clicked(id) => { root.select-workspace(id); }
                }
                IconButton {
                    icon: "󰍹";
                    tip: "Workspace overview on " + root.monitor-label;
                    clicked => { root.open-overview(); }
                }
            }

            if show-title: IconButton {
                icon: "󰖯";
                tip: root.window-title;
            }

            Rectangle { vertical-stretch: 1; }

            if show-workspaces && workspace-center: VerticalLayout {
                spacing: root.workspace-spacing;
                alignment: center;
                for workspace in root.workspaces: WorkspaceButton {
                    item: workspace;
                    squares: root.workspace-squares;
                    clicked(id) => { root.select-workspace(id); }
                }
                IconButton {
                    icon: "󰍹";
                    tip: "Workspace overview on " + root.monitor-label;
                    clicked => { root.open-overview(); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            if show-usb && usb-visible: IconButton {
                icon: "󰕓";
                tip: "Removable drives";
                clicked => { root.open-usb(); }
            }
            if show-keypad && keypad-visible: IconButton {
                icon: "󰌌";
                tip: "Macro keypad";
                clicked => { root.open-keypad(); }
            }
            if show-sync && sync-visible: IconButton {
                icon: "󰓦";
                tip: "Sync in progress";
                clicked => { root.open-sync(); }
            }
            if show-dictation && dictation-visible: IconButton {
                icon: "󰍬";
                tip: "Toggle dictation";
                active: true;
                clicked => { root.toggle-dictation(); }
            }
            if show-keyboard && keyboard-visible: IconButton {
                icon: keyboard-code;
                tip: "Switch keyboard layout";
                clicked => { root.next-keyboard(); }
                secondary-clicked => { root.open-keyboard-settings(); }
            }
            if show-bluetooth && bluetooth-available: IconButton {
                icon: bluetooth-on ? "󰂯" : "󰂲";
                tip: "Bluetooth";
                active: bluetooth-on;
                clicked => { root.open-quick-settings(); }
            }
            if show-wifi && wifi-available: IconButton {
                icon: wifi-on ? "󰤨" : "󰤮";
                tip: "Wi-Fi";
                active: wifi-on;
                clicked => { root.open-quick-settings(); }
            }
            if show-network: IconButton {
                icon: vpn-on ? "󰖂" : (network-online ? "󰒍" : "󰣴");
                tip: vpn-on ? "VPN active" : (network-online ? "Network connected" : "Network offline");
                active: network-online || vpn-on;
                clicked => { root.open-quick-settings(); }
            }
            if show-volume: IconButton {
                icon: volume-muted || volume == 0 ? "󰖁" : (volume < 50 ? "󰖀" : "󰕾");
                tip: "Volume " + volume + "%";
                active: !volume-muted;
                clicked => { root.open-quick-settings(); }
                scrolled(delta) => { root.volume-scroll(delta); }
            }
            if show-battery && battery-visible: IconButton {
                icon: battery-charging ? "󰂄" : (battery-low ? "󰂃" : "󰁹");
                tip: "Battery " + battery + "%";
                active: !battery-low;
                clicked => { root.open-quick-settings(); }
            }
            if show-sni: VerticalLayout {
                spacing: 1px;
                alignment: center;
                for item in root.sni-items: TrayButton {
                    item: item;
                    activate(key) => root.sni-activate(key);
                    secondary(key) => root.sni-secondary(key);
                    scroll(key, delta) => root.sni-scroll(key, delta);
                }
            }
            if show-clock: Rectangle {
                width: 24px;
                height: 34px;
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text {
                        text: clock-main;
                        horizontal-alignment: center;
                        color: Theme.fg;
                        font-size: 8px;
                    }
                    if clock-sub != "": Text {
                        text: clock-sub;
                        horizontal-alignment: center;
                        color: Theme.fg-dim;
                        font-size: 7px;
                    }
                }
                TouchArea {
                    clicked => { root.open-calendar(); }
                    mouse-cursor: pointer;
                }
            }
            if show-notifications: IconButton {
                icon: notifications-paused ? "󰂛" : (notification-count > 0 ? "󰂞" : "󰂜");
                tip: notification-count + " notifications";
                active: notification-count > 0;
                clicked => { root.open-notifications(); }
                secondary-clicked => { root.clear-notifications(); }
            }
        }
    }
}

export component QuickSettingsWindow inherits Window {
    in-out property <bool> wifi-available;
    in-out property <bool> bluetooth-available;
    in-out property <bool> wired-available;
    in-out property <bool> wifi-on;
    in-out property <bool> bluetooth-on;
    in-out property <bool> wired-on;
    in-out property <bool> vpn-on;
    in-out property <bool> airplane-on;
    in-out property <bool> nightlight-on;
    in-out property <bool> nightlight-available;
    in-out property <bool> dnd-on;
    in-out property <bool> dictation-on;
    in-out property <bool> dictation-available;
    in-out property <int> volume: 50;
    in-out property <bool> volume-muted: false;
    in-out property <int> brightness: 100;
    in-out property <bool> volume-dragging: false;
    in-out property <bool> brightness-dragging: false;
    in-out property <string> network-label: "Offline";
    in-out property <string> bluetooth-label: "Off";
    in-out property <string> action-error: "";
    in-out property <bool> logout-confirmation: false;
    callback close;
    callback toggle(string);
    callback open-tool(string);
    callback set-volume(int);
    callback set-brightness(int);
    callback action(string);
    out property <int> layout-columns: root.width >= 560px ? 3 : root.width >= 340px ? 2 : 1;
    out property <length> layout-content-width: quick-content.width;
    out property <length> layout-content-height: quick-content.height;
    out property <length> layout-viewport-width: quick-scroll.width;
    out property <length> layout-viewport-height: quick-scroll.height;
    out property <length> layout-volume-track-width: volume-slider.track-width;
    out property <length> layout-volume-track-x: volume-slider.track-x;
    out property <length> layout-volume-track-y: volume-slider.track-y;
    out property <length> layout-slider-icon-size: volume-slider.icon-size;
    out property <length> layout-slider-glyph-x: volume-slider.icon-glyph-x;
    out property <length> layout-slider-glyph-y: volume-slider.icon-glyph-y;
    out property <length> layout-slider-glyph-width: volume-slider.icon-glyph-width;
    out property <length> layout-slider-glyph-height: volume-slider.icon-glyph-height;
    out property <length> layout-slider-icon-offset-y: volume-slider.icon-center-offset-y;
    out property <length> layout-slider-icon-column-width: volume-slider.icon-column-width;
    out property <length> layout-slider-label-column-width: volume-slider.label-column-width;
    out property <length> layout-slider-track-column-width: volume-slider.track-column-width;
    out property <length> layout-slider-value-column-width: volume-slider.value-column-width;
    out property <length> layout-brightness-icon-column-width: brightness-slider.icon-column-width;
    out property <length> layout-brightness-label-column-width: brightness-slider.label-column-width;
    out property <length> layout-brightness-track-column-width: brightness-slider.track-column-width;
    out property <length> layout-brightness-value-column-width: brightness-slider.value-column-width;
    out property <length> layout-card-icon-size: wifi-card.icon-size;
    out property <length> layout-card-glyph-x: wifi-card.glyph-x;
    out property <length> layout-card-glyph-y: wifi-card.glyph-y;
    out property <length> layout-card-glyph-width: wifi-card.glyph-width;
    out property <length> layout-card-glyph-height: wifi-card.glyph-height;
    out property <length> layout-card-icon-offset-y: wifi-card.icon-center-offset-y;
    out property <length> layout-action-icon-size: settings-action.icon-size;
    out property <length> layout-action-glyph-x: settings-action.glyph-x;
    out property <length> layout-action-glyph-y: settings-action.glyph-y;
    out property <length> layout-action-glyph-width: settings-action.glyph-width;
    out property <length> layout-action-glyph-height: settings-action.glyph-height;
    out property <length> layout-action-icon-offset-y: settings-action.icon-center-offset-y;
    out property <bool> layout-sliders-valid: volume-slider.columns-valid
        && brightness-slider.columns-valid
        && volume-slider.height == 42px
        && brightness-slider.height == 42px
        && volume-slider.absolute-position.x >= quick-content.absolute-position.x - 0.5px
        && volume-slider.absolute-position.x + volume-slider.width
            <= quick-content.absolute-position.x + quick-content.width + 0.5px
        && brightness-slider.absolute-position.x + brightness-slider.width
            <= quick-content.absolute-position.x + quick-content.width + 0.5px
        && brightness-slider.absolute-position.y + brightness-slider.height
            <= quick-content.absolute-position.y + quick-content.height + 0.5px
        && abs(brightness-slider.absolute-position.y
            - volume-slider.absolute-position.y - 50px) <= 0.5px;
    out property <bool> layout-cards-valid: wifi-card.height == 66px
        && bluetooth-card.height == 66px
        && wired-card.height == 66px
        && airplane-card.height == 66px
        && nightlight-card.height == 66px
        && dnd-card.height == 66px
        && vpn-card.height == 66px
        && dictation-card.height == 66px
        && wifi-card.width > 0px
        && bluetooth-card.width > 0px
        && wired-card.width > 0px
        && airplane-card.width > 0px
        && nightlight-card.width > 0px
        && dnd-card.width > 0px
        && vpn-card.width > 0px
        && dictation-card.width > 0px
        && wifi-card.absolute-position.x >= quick-content.absolute-position.x - 0.5px
        && wifi-card.absolute-position.y + wifi-card.height
            <= quick-content.absolute-position.y + quick-content.height + 0.5px
        && bluetooth-card.absolute-position.x + bluetooth-card.width
            <= quick-content.absolute-position.x + quick-content.width + 0.5px
        && bluetooth-card.absolute-position.y + bluetooth-card.height
            <= quick-content.absolute-position.y + quick-content.height + 0.5px
        && wired-card.absolute-position.x + wired-card.width
            <= quick-content.absolute-position.x + quick-content.width + 0.5px
        && airplane-card.absolute-position.x + airplane-card.width
            <= quick-content.absolute-position.x + quick-content.width + 0.5px
        && nightlight-card.absolute-position.x + nightlight-card.width
            <= quick-content.absolute-position.x + quick-content.width + 0.5px
        && dnd-card.absolute-position.x + dnd-card.width
            <= quick-content.absolute-position.x + quick-content.width + 0.5px
        && vpn-card.absolute-position.y + vpn-card.height
            <= quick-content.absolute-position.y + quick-content.height + 0.5px
        && dictation-card.absolute-position.x + dictation-card.width
            <= quick-content.absolute-position.x + quick-content.width + 0.5px
        && dictation-card.absolute-position.y + dictation-card.height
            <= quick-content.absolute-position.y + quick-content.height + 0.5px;
    out property <bool> layout-actions-valid: settings-action.height == 38px
        && logout-action.height == 38px
        && power-action.height == 38px
        && settings-action.width > 0px
        && logout-action.width > 0px
        && power-action.width > 0px
        && settings-action.absolute-position.x >= shell.absolute-position.x
        && settings-action.absolute-position.y + settings-action.height
            <= shell.absolute-position.y + shell.height
        && logout-action.absolute-position.y + logout-action.height
            <= shell.absolute-position.y + shell.height
        && power-action.absolute-position.x + power-action.width
            <= shell.absolute-position.x + shell.width;
    out property <bool> layout-overflows-width: quick-content.width > quick-scroll.width + 0.5px;
    out property <bool> layout-scrolls: quick-content.height > quick-scroll.height + 0.5px;
    out property <bool> layout-scroll-indicator-visible: quick-scroll-indicator.visible;
    title: "smpl-bar:quick-settings";
    no-frame: true;
    min-width: 1px;
    min-height: 1px;
    preferred-width: 480px;
    preferred-height: 500px;
    background: transparent;
    forward-focus: quick-scope;
    quick-scope := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            return reject;
        }
        shell := Rectangle {
            x: 1px;
            y: 1px;
            width: max(0px, parent.width - 2px);
            height: max(0px, parent.height - 2px);
            background: Theme.bg.transparentize(1.0 - Theme.popup-opacity);
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.accent.transparentize(0.48);
            clip: true;
            VerticalLayout {
            padding: 12px;
            spacing: 8px;
            quick-scroll-frame := Rectangle {
                min-width: 0px;
                min-height: 0px;
                vertical-stretch: 1;
                background: transparent;
                quick-scroll := Flickable {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    viewport-width: self.width;
                    viewport-height: max(self.height, quick-content.min-height);
                    quick-content := VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: parent.viewport-width;
                        height: self.min-height;
                        min-width: 0px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        spacing: 8px;
                    Text {
                        text: "OUTPUT + DISPLAY";
                        color: Theme.fg-dim;
                        font-size: 8px;
                        font-weight: 700;
                        letter-spacing: 0.8px;
                    }
                    volume-slider := QuickSlider {
                        icon: root.volume-muted || root.volume == 0 ? "󰖁" : "󰕾";
                        label: "VOLUME";
                        value <=> root.volume;
                        dragging <=> root.volume-dragging;
                        muted: root.volume-muted;
                        mute-control: true;
                        change(value) => root.set-volume(value);
                        toggle-mute => root.toggle("volume");
                    }
                    brightness-slider := QuickSlider {
                        icon: "󰃠";
                        label: "BRIGHTNESS";
                        value <=> root.brightness;
                        dragging <=> root.brightness-dragging;
                        minimum: 1;
                        change(value) => root.set-brightness(value);
                    }
                    Text {
                        text: "CONNECTIVITY + MODES";
                        color: Theme.fg-dim;
                        font-size: 8px;
                        font-weight: 700;
                        letter-spacing: 0.8px;
                    }
                    GridLayout {
                        min-width: 0px;
                        spacing: 7px;
                        wifi-card := QuickSettingCard {
                            row: 0;
                            col: 0;
                            icon: "󰤨";
                            title: "Wi-Fi";
                            label: network-label;
                            detail: wifi-on ? "Active link" : wifi-available ? "Wireless ready" : "Unavailable";
                            active: wifi-on;
                            enabled: wifi-available;
                            clicked => root.toggle("wifi");
                        }
                        bluetooth-card := QuickSettingCard {
                            row: 1 / root.layout-columns;
                            col: Math.mod(1, root.layout-columns);
                            icon: "󰂯";
                            title: "Bluetooth";
                            label: "Bluetooth";
                            detail: bluetooth-on ? bluetooth-label + " · connected" : bluetooth-label + " · standby";
                            active: bluetooth-on;
                            enabled: bluetooth-available;
                            clicked => root.toggle("bluetooth");
                        }
                        wired-card := QuickSettingCard {
                            row: 2 / root.layout-columns;
                            col: Math.mod(2, root.layout-columns);
                            icon: "󰈁";
                            title: "Wired network";
                            label: "Wired";
                            detail: wired-on ? "Link active" : wired-available ? "Disconnected" : "Unavailable";
                            active: wired-on;
                            enabled: wired-available;
                            clicked => root.toggle("wired");
                        }
                        airplane-card := QuickSettingCard {
                            row: 3 / root.layout-columns;
                            col: Math.mod(3, root.layout-columns);
                            icon: "󰀝";
                            title: "Airplane mode";
                            label: "Airplane";
                            detail: airplane-on ? "Radios suspended" : "Radios available";
                            active: airplane-on;
                            enabled: wifi-available || bluetooth-available;
                            clicked => root.toggle("airplane");
                        }
                        nightlight-card := QuickSettingCard {
                            row: 4 / root.layout-columns;
                            col: Math.mod(4, root.layout-columns);
                            icon: "󰛨";
                            title: "Night light";
                            label: "Night light";
                            detail: nightlight-on ? "Warm display" : nightlight-available ? "Display neutral" : "Unavailable";
                            active: nightlight-on;
                            enabled: nightlight-available;
                            clicked => root.toggle("nightlight");
                        }
                        dnd-card := QuickSettingCard {
                            row: 5 / root.layout-columns;
                            col: Math.mod(5, root.layout-columns);
                            icon: "󰂛";
                            title: "Do not disturb";
                            label: "Do not disturb";
                            detail: dnd-on ? "Alerts silenced" : "Alerts enabled";
                            active: dnd-on;
                            clicked => root.toggle("dnd");
                        }
                        vpn-card := QuickSettingCard {
                            row: 6 / root.layout-columns;
                            col: Math.mod(6, root.layout-columns);
                            icon: "󰖂";
                            title: "VPN and network editor";
                            label: vpn-on ? "VPN / Mullvad" : "VPN";
                            detail: vpn-on ? "Secure tunnel active" : "Open network editor";
                            active: vpn-on;
                            clicked => root.open-tool("network");
                        }
                        dictation-card := QuickSettingCard {
                            row: 7 / root.layout-columns;
                            col: Math.mod(7, root.layout-columns);
                            icon: "󰍬";
                            title: "Dictation";
                            label: dictation-on ? "Recording" : "Dictation";
                            detail: dictation-on ? "Voice capture live" : dictation-available ? "Ready for input" : "Unavailable";
                            active: dictation-on;
                            enabled: dictation-available;
                            clicked => root.toggle("dictation");
                        }
                    }
                }
                }
                quick-scroll-indicator := Rectangle {
                        x: parent.width - self.width;
                        y: 4px;
                        width: 4px;
                        height: max(0px, parent.height - 8px);
                        visible: root.layout-scrolls;
                        border-radius: 2px;
                        background: Theme.bg-lighter.transparentize(0.48);
                        Rectangle {
                            x: 0px;
                            y: clamp(
                                -quick-scroll.viewport-y
                                    / max(1px, quick-scroll.viewport-height - quick-scroll.height)
                                    * (parent.height - self.height),
                                0px,
                                max(0px, parent.height - self.height)
                            );
                            width: 100%;
                            height: max(
                                20px,
                                parent.height
                                    * min(1.0, quick-scroll.height / max(1px, quick-scroll.viewport-height))
                            );
                            border-radius: 2px;
                            background: Theme.fg-dim;
                        }
                    }
                }
            HorizontalLayout {
                min-height: 40px;
                spacing: 7px;
                settings-action := CommandAction {
                    horizontal-stretch: 1;
                    icon: "󰒓";
                    label: "Settings";
                    clicked => root.open-tool("settings");
                }
                logout-action := CommandAction {
                    horizontal-stretch: 1;
                    icon: "󰗽";
                    label: "Log out";
                    clicked => root.action("logout-request");
                }
                power-action := CommandAction {
                    horizontal-stretch: 1;
                    icon: "⏻";
                    label: "Power";
                    tint: Theme.danger;
                    clicked => root.action("poweroff");
                }
            }
            if action-error != "": Text {
                text: action-error;
                color: Theme.danger;
                font-size: 11px;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: action-error;
            }
            }
            if logout-confirmation: Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                background: Theme.bg.transparentize(0.14);
                border-radius: 14px;
                Rectangle {
                    x: 24px;
                    y: (parent.height - self.height) / 2;
                    width: max(240px, min(360px, parent.width - 48px));
                    height: 164px;
                    background: Theme.bg-light;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.danger.transparentize(0.38);
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        Text {
                            text: "Log out of smplOS?";
                            color: Theme.fg;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Save your work first. This ends only the current desktop session.";
                            color: Theme.fg-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-stretch: 1;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            CommandAction {
                                horizontal-stretch: 1;
                                icon: "×";
                                label: "Cancel";
                                clicked => root.action("logout-cancel");
                            }
                            CommandAction {
                                horizontal-stretch: 1;
                                icon: "󰗽";
                                label: "Log out";
                                tint: Theme.danger;
                                clicked => root.action("logout-confirmed");
                            }
                        }
                    }
                }
            }
        }
    }
}

export component UsbWindow inherits Window {
    in-out property <[UsbUi]> devices;
    callback close;
    callback eject(string, bool);
    title: "smpl-bar:usb";
    no-frame: true;
    preferred-width: 360px;
    preferred-height: 220px;
    background: transparent;
    Rectangle {
        x: 1px;
        y: 1px;
        width: max(0px, parent.width - 2px);
        height: max(0px, parent.height - 2px);
        background: Theme.bg.transparentize(1.0 - Theme.popup-opacity);
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.accent.transparentize(0.50);
        clip: true;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            PopupHeader {
                eyebrow: "STORAGE / DEVICES";
                title: "Removable Drives";
                close => root.close();
            }
            if devices.length == 0: Text {
                text: "No mounted removable drives";
                color: Theme.fg-dim;
                vertical-alignment: center;
                vertical-stretch: 1;
            }
            if devices.length > 0: VerticalLayout {
                spacing: 6px;
                for device in devices: Rectangle {
                    height: 54px;
                    border-radius: 6px;
                    background: Theme.bg-light.transparentize(0.72);
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { text: "󰕓"; font-size: 18px; color: Theme.info; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: device.label; color: Theme.fg; overflow: elide; font-size: 12px; }
                            Text { text: device.size + " · " + device.path; color: Theme.fg-dim; overflow: elide; font-size: 9px; }
                        }
                        IconButton {
                            icon: "󰆴";
                            tip: device.mounted ? "Safely eject" : "Power off";
                            clicked => root.eject(device.name, device.mounted);
                        }
                    }
                }
            }
        }
    }
}

export component WorkspaceOverviewWindow inherits Window {
    in-out property <[WorkspaceUi]> workspaces;
    in-out property <[MonitorUi]> monitors;
    in-out property <string> focused-monitor;
    in-out property <string> error;
    callback close;
    callback select(int);
    title: "smpl-bar:workspace-overview";
    no-frame: true;
    preferred-width: 620px;
    preferred-height: 220px;
    background: transparent;
    Rectangle {
        x: 1px;
        y: 1px;
        width: max(0px, parent.width - 2px);
        height: max(0px, parent.height - 2px);
        background: Theme.bg.transparentize(1.0 - Theme.popup-opacity);
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.accent.transparentize(0.50);
        clip: true;
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            PopupHeader {
                eyebrow: "DESKTOP / " + focused-monitor;
                title: "Workspace Overview";
                close => root.close();
            }
            if error != "": Text { text: error; color: Theme.warning; wrap: word-wrap; }
            for monitor in monitors: Rectangle {
                height: 44px;
                border-radius: 6px;
                border-width: monitor.focused ? 2px : 1px;
                border-color: monitor.focused ? Theme.accent : Theme.bg-lighter;
                background: Theme.bg-light.transparentize(0.78);
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        text: monitor.connector;
                        color: monitor.focused ? Theme.accent : Theme.fg;
                        font-weight: monitor.focused ? 600 : 400;
                        vertical-alignment: center;
                    }
                    Text {
                        text: monitor.description;
                        color: Theme.fg-dim;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "WS " + monitor.active-workspace;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                for workspace in workspaces: WorkspaceButton {
                    item: workspace;
                    width: 48px;
                    height: 42px;
                    clicked(id) => root.select(id);
                }
            }
            Text {
                text: "Filled: focused · Outline: visible · Accent dot: occupied";
                color: Theme.fg-dim;
                horizontal-alignment: center;
                font-size: 10px;
            }
        }
    }
}

export component KeypadCheatsheetWindow inherits Window {
    in-out property <string> sheet-title: "Keypad";
    in-out property <string> notice;
    in-out property <[KeypadItemUi]> keys;
    in-out property <bool> click-through: false;
    callback close;
    title: "smpl-bar:keypad-cheatsheet";
    no-frame: true;
    preferred-width: 720px;
    preferred-height: 360px;
    background: transparent;
    Rectangle {
        background: Theme.bg.transparentize(0.68);
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.bg-lighter.transparentize(0.45);
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            Text { text: sheet-title; color: Theme.fg; font-size: 16px; font-weight: 600; }
            if notice != "": Text { text: notice; color: Theme.warning; wrap: word-wrap; }
            GridLayout {
                spacing: 6px;
                for item in keys: Rectangle {
                    row: item.row;
                    col: item.column;
                    min-width: 100px;
                    height: 74px;
                    border-radius: 6px;
                    border-width: item.active ? 2px : 1px;
                    border-color: item.active ? Theme.accent : Theme.fg-dim.transparentize(0.45);
                    background: item.active ? Theme.accent.transparentize(0.86) : transparent;
                    VerticalLayout {
                        padding: 7px;
                        spacing: 2px;
                        Text { text: item.control; color: Theme.fg-dim; font-size: 9px; }
                        Text { text: item.bound ? item.label : "·"; color: Theme.fg; font-size: 11px; overflow: elide; }
                        Text { text: item.state; color: Theme.fg-dim; font-size: 8px; overflow: elide; }
                    }
                }
            }
            Text {
                text: click-through ? "Hides automatically or with the cheatsheet key" : "Click to close";
                color: Theme.fg-dim;
                font-size: 10px;
            }
        }
        TouchArea {
            enabled: !click-through;
            clicked => root.close();
        }
    }
}

export component IdentifyWindow inherits Window {
    in-out property <string> label: "Monitor";
    in-out property <string> window-title-label: "smpl-bar:identify";
    title: window-title-label;
    no-frame: true;
    preferred-width: 380px;
    preferred-height: 140px;
    background: transparent;
    Rectangle {
        background: Theme.bg.transparentize(0.06);
        border-radius: 20px;
        border-width: 2px;
        border-color: Theme.accent;
        Text {
            text: label;
            color: Theme.accent;
            font-size: 42px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component TrayMenuWindow inherits Window {
        in-out property <string> menu-title: "Status item";
        in-out property <string> item-key;
        in-out property <[TrayMenuEntryUi]> entries;
        callback close;
        callback select(int);
        title: "smpl-bar:tray-menu";
        no-frame: true;
        preferred-width: 300px;
        preferred-height: 360px;
        background: transparent;
        Rectangle {
            x: 1px;
            y: 1px;
            width: max(0px, parent.width - 2px);
            height: max(0px, parent.height - 2px);
            background: Theme.bg.transparentize(1.0 - Theme.popup-opacity);
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.accent.transparentize(0.50);
            clip: true;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                PopupHeader {
                    eyebrow: "STATUS / ACTIONS";
                    title: menu-title;
                    close => root.close();
                }
                Flickable {
                    vertical-stretch: 1;
                    viewport-height: entries.length * 34px;
                    VerticalLayout {
                        spacing: 4px;
                        for entry in entries: Rectangle {
                            width: 100%;
                            height: 30px;
                            if entry.separator: Rectangle {
                                x: 4px;
                                y: parent.height / 2;
                                width: parent.width - 8px;
                                height: 1px;
                                background: Theme.bg-lighter;
                            }
                            if !entry.separator: Rectangle {
                                border-radius: 4px;
                                background: touch.has-hover && entry.enabled ? Theme.bg-light : transparent;
                                HorizontalLayout {
                                    padding-left: 8px + entry.level * 10px;
                                    padding-right: 8px;
                                    Text {
                                        text: entry.checked ? "✓" : " ";
                                        width: 18px;
                                        color: entry.enabled ? Theme.accent : Theme.fg-dim;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: entry.label;
                                        color: entry.enabled ? Theme.fg : Theme.fg-dim;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                }
                                touch := TouchArea {
                                    enabled: entry.enabled;
                                    mouse-cursor: entry.enabled ? pointer : default;
                                    clicked => root.select(entry.item-id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
