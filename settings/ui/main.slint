// Keypad icons (outline Tabler Icons subset, MIT): see assets/TABLER-ICONS-LICENSE.txt.
import "assets/keypad-icons.ttf";

// ── Data structs ─────────────────────────────────────────────────────────────

struct KeyData {
    base: string,
    english: string,
    w: float,
    is-modifier: bool,
}

struct LayoutEntry {
    code: string,
    variant: string,
    description: string,
}

struct ModelEntry {
    label: string,
    size: string,
    note: string,
    english-only: bool,
    downloaded: bool,
}

/// One managed display exactly as Rust last verified or edited it. Every
/// Display control reads the selected row; nothing duplicates these values.
struct MonitorInfo {
    name: string,
    description: string,
    width: int,
    height: int,
    refresh-rate: float,
    pos-x: int,
    pos-y: int,
    scale: float,
    // Exact Hyprland transform 0–7.
    transform: int,
    is-primary: bool,
    canvas-x: float,
    canvas-y: float,
    canvas-w: float,
    canvas-h: float,
    available-modes: [string],
    current-mode-index: int,
    orientation-options: [string],
    current-orientation-index: int,
    // Rotated size, e.g. "1080×1920" for portrait, and a two-line variant.
    size-label: string,
    size-label-two-line: string,
}

struct SearchResult {
    label: string,
    tab-name: string,
    tab-index: int,
}

struct BindingEntry {
    idx: int,
    combo: string,
    description: string,
    dispatcher: string,
    args: string,
    section: string,
    submap: string,
    is-exec: bool,
}

/// A discovered Wi-Fi access point (mirrors wifi::WifiNetwork on the Rust side).
struct WifiEntry {
    ssid: string,
    /// Signal strength 0–100.
    signal: int,
    /// Security string: "WPA2", "WPA3", "WPA2 WPA3", "WEP", or "Open".
    security: string,
    /// True when this is the currently active connection.
    connected: bool,
    /// True when a saved NetworkManager profile exists for this SSID.
    saved: bool,
}

/// A discovered or paired Bluetooth device.
struct BtDevice {
    address: string,
    name: string,
    connected: bool,
    paired: bool,
    trusted: bool,
    icon: string,
    signal: int,
}

/// One key or knob of the keypad layout (Settings > Keypad).
struct KeypadControl {
    id: string,
    label: string,
    knob: bool,
    col: int,
    row: int,
    summary: string,
    selected: bool,
    // Flashes while live input reports this control.
    active: bool,
    // Confirmed in the firmware wizard's input test.
    seen: bool,
    // Icon glyph(s) in KeypadIcons.family: a key's, or a knob's ccw/press/cw.
    glyph: string,
}

/// A keypad variant (board profile) with what its schematic needs.
struct KeypadVariant {
    name: string,
    keys: int,
    knobs: int,
    cols: int,
}

/// One line of a knob in the cheatsheet preview (turn left, press, turn right).
struct KeypadSheetLine {
    dir: string,
    glyph: string,
    text: string,
    bound: bool,
    active: bool,
}

/// One cell of the cheatsheet preview: a key, or a knob with its three lines.
struct KeypadSheetCell {
    num: string,
    text: string,
    glyph: string,
    knob: bool,
    lines: [KeypadSheetLine],
    col: int,
    row: int,
    bound: bool,
    // Would do something now (e.g. false while Kdenlive's interface is off).
    active: bool,
}

/// One engine setting in Keypad > Advanced (a slider).
struct KeypadTuning {
    key: string,
    label: string,
    help: string,
    min: float,
    max: float,
    step: float,
    value: float,
    // The value with its unit ("3×", "40 ms"), and "(default)" when unset.
    display: string,
}

/// An icon in Settings' icon picker.
struct KeypadIcon {
    name: string,
    glyph: string,
}

/// A binding of the selected keypad profile ("knob1.cw" -> "Media key").
struct KeypadBindingRow {
    slot: string,
    label: string,
    summary: string,
    advanced: bool,
    glyph: string,
}

// Outline keypad icons (Tabler Icons subset, MIT), embedded; see
// assets/TABLER-ICONS-LICENSE.txt.
global KeypadIcons {
    out property <string> family: "smplOS Keypad Icons";
}

// ── Theme ────────────────────────────────────────────────────────────────────

global Typography {
    out property <length> caption: 12px;
    out property <length> secondary: 13px;
    out property <length> body: 14px;
    out property <length> heading: 16px;
    out property <length> title: 18px;
    out property <length> compact-control: 32px;
    out property <length> row: 40px;
    out property <length> choice-row: 52px;
    out property <length> dropdown-spacing: 1px;
}

export global Theme {
    in property <color> bg: #1e1e2e;
    in property <color> fg: #cdd6f4;
    in property <color> fg_dim: #a6adc8;
    in property <color> accent: #89b4fa;
    in property <color> bg_light: #45475a;
    in property <color> bg_lighter: #585b70;
    in property <color> danger: #f38ba8;
    in property <color> success: #a6e3a1;
    in property <color> warning: #f9e2af;
    in property <color> info: #94e2d5;
    in property <float> opacity: 1.0;
    out property <color> panel: bg_light.transparentize(88%);
    out property <color> hover: bg_lighter.transparentize(80%);
}

// ── Key cap component ────────────────────────────────────────────────────────

component KeyCap inherits Rectangle {
    in property <string> base;
    in property <string> english;
    in property <float> w: 1.0;
    in property <bool> is-modifier: false;

    height: 38px;
    width: Math.max(38px, 38px * root.w + (root.w - 1) * 3px);
    border-radius: 4px;
    background: root.is-modifier ? Theme.bg_lighter.transparentize(40%) : Theme.bg_light;

    VerticalLayout {
        padding: 2px;
        padding-left: 4px;

        if root.english != "": Text {
            text: root.english;
            color: Theme.fg_dim;
            font-size: Typography.caption;
            overflow: elide;
        }

        Text {
            text: root.base;
            color: root.is-modifier ? Theme.fg_dim : Theme.fg;
            font-size: root.is-modifier ? Typography.caption : Typography.body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// ── Sidebar tab button ───────────────────────────────────────────────────────

component TabButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <image> outline-icon;
    in property <bool> use-outline-icon: false;
    in property <bool> active: false;
    callback clicked();

    height: Typography.row;
    border-radius: 4px;
    background: active ? Theme.accent.transparentize(70%)
        : tab-touch.has-hover ? Theme.bg_lighter : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            width: 3px;
            Rectangle {
                width: 3px;
                height: 20px;
                border-radius: 2px;
                background: active ? Theme.accent : transparent;
            }
        }

        if !root.use-outline-icon: Text {
            text: root.icon;
            color: active ? Theme.accent : Theme.fg_dim;
            font-size: Typography.heading;
            vertical-alignment: center;
            width: 18px;
        }

        if root.use-outline-icon: VerticalLayout {
            alignment: center;
            width: 18px;
            Image {
                source: root.outline-icon;
                colorize: active ? Theme.accent : Theme.fg_dim;
                width: 18px;
                height: 18px;
            }
        }

        Text {
            text: root.label;
            color: active ? Theme.fg : Theme.fg_dim;
            font-size: Typography.body;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    tab-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ── Display dropdown (resolution / orientation picker) ───────────────────────
// Controlled: `current-index` is only ever bound by the parent. Choosing an
// item emits `selected`; the verified state then flows back through the
// binding, so the dropdown can never show a value that isn't in the model.

component ResDropdown inherits Rectangle {
    in property <[string]> model: [];
    in property <int> current-index: -1;
    in property <bool> enabled: true;
    callback selected(int);

    height: Typography.compact-control;
    border-radius: 4px;
    background: Theme.panel;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Text {
            text: root.model.length > 0 && root.current-index >= 0 && root.current-index < root.model.length
                ? root.model[root.current-index] : "---";
            color: root.enabled ? Theme.fg : Theme.fg_dim;
            font-size: Typography.secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: "\u{25bc}";
            color: Theme.fg_dim;
            font-size: Typography.caption;
            vertical-alignment: center;
            width: 16px;
            horizontal-alignment: center;
        }
    }

    drop-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: parent.height + 2px;
        width: root.width;
        height: min(240px, root.model.length * Typography.compact-control + 4px);
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: 4px;
            background: Theme.bg_light;
            border-width: 1px;
            border-color: Theme.bg_lighter;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000066;

            Flickable {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                viewport-width: self.width;

                VerticalLayout {
                    spacing: 0;
                    for item[idx] in root.model: Rectangle {
                        height: Typography.compact-control;
                        border-radius: 3px;
                        background: idx == root.current-index ? Theme.accent
                                  : opt-touch.has-hover ? Theme.bg_lighter
                                  : transparent;

                        Text {
                            text: item;
                            color: idx == root.current-index ? Theme.bg : Theme.fg;
                            font-size: Typography.secondary;
                            vertical-alignment: center;
                            x: 6px;
                        }

                        opt-touch := TouchArea {
                            clicked => {
                                root.selected(idx);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── Slider ───────────────────────────────────────────────────────────────────
// Controlled: `value` is only ever bound by the parent. Dragging emits
// `changed` with the stepped value; the parent stores it (XR) or Rust snaps
// it (display scale) and the binding moves the knob.

component ThemeSlider inherits Rectangle {
    in property <float> value: 1.0;
    in property <float> minimum: 0.5;
    in property <float> maximum: 3.0;
    in property <float> step: 0.25;
    in property <bool> enabled: true;
    callback changed(float);
    private property <float> fraction: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);

    pure function value-at(position: length) -> float {
        return root.stepped(clamp(root.minimum + (position / root.width) * (root.maximum - root.minimum), root.minimum, root.maximum));
    }

    pure function stepped(raw: float) -> float {
        return root.step > 0 ? clamp(round(raw / root.step) * root.step, root.minimum, root.maximum) : raw;
    }

    height: 20px;

    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.bg_lighter;

        // Starts at the left edge so fill and knob always agree.
        Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            height: parent.height;
            border-radius: parent.border-radius;
            background: root.enabled ? Theme.accent : Theme.fg_dim;
        }
    }

    Rectangle {
        x: (parent.width - 14px) * root.fraction;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: !root.enabled ? Theme.fg_dim
            : slider-touch.pressed ? Theme.accent.darker(0.2) : Theme.accent;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000044;
    }

    slider-touch := TouchArea {
        enabled: root.enabled;
        moved => {
            if (self.pressed) {
                root.changed(root.value-at(self.mouse-x));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.changed(root.value-at(self.mouse-x));
            }
        }
    }
}

// ── Draggable monitor rectangle ──────────────────────────────────────────────

component MonitorRect inherits Rectangle {
    in property <string> label;
    in property <string> sublabel;
    in property <string> sublabel-two-line;
    in property <bool> selected;
    in property <bool> is-primary;
    in property <bool> interactive: true;

    in property <float> base-x;
    in property <float> base-y;
    in property <float> canvas-max-x;
    in property <float> canvas-max-y;
    in-out property <float> offset-x: 0;
    in-out property <float> offset-y: 0;
    private property <bool> dragging: false;
    // Narrow (usually portrait) rectangles show the size on two lines; labels
    // are centered at their natural width so they are never truncated.
    private property <bool> narrow: size-measure.preferred-width + 8px > root.width;
    private property <length> block-height: name-text.preferred-height + size-text.preferred-height
        + (root.is-primary ? badge-text.preferred-height : 0px);

    callback clicked();
    callback drag-finished(float, float);
    callback dragging-changed(bool);
    callback press-changed(bool);

    x: (base-x + offset-x) * 1px;
    y: (base-y + offset-y) * 1px;

    border-radius: 6px;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.bg_lighter;
    background: dragging ? Theme.hover
              : selected ? Theme.panel
              : Theme.bg_light.darker(0.3).transparentize(90%);
    drop-shadow-blur: dragging ? 12px : selected ? 8px : 2px;
    drop-shadow-color: #00000066;

    size-measure := Text {
        visible: false;
        text: root.sublabel;
        font-size: Typography.secondary;
    }

    name-text := Text {
        x: (root.width - self.width) / 2;
        y: (root.height - root.block-height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        text: root.label;
        color: Theme.fg;
        font-size: Typography.heading;
        font-weight: 700;
        horizontal-alignment: center;
    }

    size-text := Text {
        x: (root.width - self.width) / 2;
        y: name-text.y + name-text.height;
        width: self.preferred-width;
        height: self.preferred-height;
        text: root.narrow ? root.sublabel-two-line : root.sublabel;
        color: Theme.fg_dim;
        font-size: Typography.secondary;
        horizontal-alignment: center;
    }

    badge-text := Text {
        visible: root.is-primary;
        x: (root.width - self.width) / 2;
        y: size-text.y + size-text.height;
        width: self.preferred-width;
        height: self.preferred-height;
        text: "Primary";
        color: Theme.accent;
        font-size: Typography.caption;
        font-weight: 600;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.dragging ? pointer : default;

        clicked => {
            if (!root.dragging) { root.clicked(); }
        }

        moved => {
            if (self.pressed) {
                if (!root.dragging) {
                    root.dragging = true;
                    root.dragging-changed(true);
                }
                root.offset-x += (self.mouse-x - self.pressed-x) / 1px;
                root.offset-y += (self.mouse-y - self.pressed-y) / 1px;
                // Clamp inside the canvas so the rect can't cover the cards below.
                if (root.base-x + root.offset-x < 0) { root.offset-x = -root.base-x; }
                if (root.base-x + root.offset-x > root.canvas-max-x) {
                    root.offset-x = root.canvas-max-x - root.base-x;
                }
                if (root.base-y + root.offset-y < 0) { root.offset-y = -root.base-y; }
                if (root.base-y + root.offset-y > root.canvas-max-y) {
                    root.offset-y = root.canvas-max-y - root.base-y;
                }
            }
        }

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.press-changed(true);
            }
            if (event.kind == PointerEventKind.up) {
                root.press-changed(false);
                if (root.dragging) {
                    root.dragging = false;
                    root.drag-finished(root.base-x + root.offset-x,
                                       root.base-y + root.offset-y);
                }
                root.dragging = false;
                root.offset-x = 0;
                root.offset-y = 0;
            }
        }
    }
}

// ══════════════════════════════════════════════════════════════════════════════
// SCROLL INDICATOR — thin scrollbar thumb overlay for Flickable
// ══════════════════════════════════════════════════════════════════════════════

component ScrollIndicator inherits Rectangle {
    in property <length> viewport-height;
    in property <length> viewport-y;
    in property <length> visible-height;

    property <float> ratio: self.visible-height <= 0px ? 1.0 :
        clamp(self.visible-height / max(self.viewport-height, 1px), 0.0, 1.0);
    property <float> scroll-frac: self.viewport-height <= self.visible-height ? 0.0 :
        clamp(-self.viewport-y / (self.viewport-height - self.visible-height), 0.0, 1.0);
    property <bool> needed: self.viewport-height > self.visible-height + 4px;

    width: 4px;
    visible: self.needed;

    // Track
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 2px;
        background: Theme.bg_lighter.transparentize(70%);
    }

    // Thumb
    Rectangle {
        x: 0px;
        y: parent.scroll-frac * (parent.height - self.height);
        width: 100%;
        height: max(20px, parent.height * parent.ratio);
        border-radius: 2px;
        background: Theme.fg_dim;
    }
}

component HorizontalScrollIndicator inherits Rectangle {
    in property <length> viewport-width;
    in property <length> visible-width;
    in-out property <length> viewport-x;

    height: 8px;
    visible: viewport-width > visible-width + 4px;
    border-radius: 4px;
    background: Theme.bg_lighter;

    Rectangle {
        width: max(24px, parent.width * root.visible-width / max(root.viewport-width, 1px));
        height: parent.height;
        x: -root.viewport-x / max(root.viewport-width - root.visible-width, 1px) * (parent.width - self.width);
        border-radius: 4px;
        background: Theme.fg_dim;
    }

    TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.viewport-x = -clamp(self.mouse-x / self.width, 0, 1) * (root.viewport-width - root.visible-width);
            }
        }
        moved => {
            if self.pressed {
                root.viewport-x = -clamp(self.mouse-x / self.width, 0, 1) * (root.viewport-width - root.visible-width);
            }
        }
    }
}

// ── Wi-Fi signal strength bars ────────────────────────────────────────────────

component SignalBars inherits HorizontalLayout {
    in property <int> signal: 0;  // 0–100
    spacing: 2px;
    alignment: center;

    // Bar 1 — always shown (very weak)
    Rectangle {
        width: 4px; height: 8px; border-radius: 1px;
        background: signal >= 1 ? Theme.accent : Theme.bg_lighter;
    }
    // Bar 2 — fair
    Rectangle {
        width: 4px; height: 12px; border-radius: 1px;
        background: signal >= 30 ? Theme.accent : Theme.bg_lighter;
    }
    // Bar 3 — good
    Rectangle {
        width: 4px; height: 17px; border-radius: 1px;
        background: signal >= 55 ? Theme.accent : Theme.bg_lighter;
    }
    // Bar 4 — excellent
    Rectangle {
        width: 4px; height: 22px; border-radius: 1px;
        background: signal >= 75 ? Theme.accent : Theme.bg_lighter;
    }
}

// ══════════════════════════════════════════════════════════════════════════════
// MAIN WINDOW
// ══════════════════════════════════════════════════════════════════════════════

// ── Keypad components (Settings > Keypad) ────────────────────────────────────

component KeypadButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: Typography.compact-control;
    min-width: label.preferred-width + 24px;
    border-radius: 4px;
    // Disabled buttons are outlined instead of filled (shape, not only color).
    border-width: root.enabled ? 0px : 1px;
    border-color: Theme.bg_lighter;
    background: !root.enabled ? transparent
        : root.primary ? (touch.has-hover ? Theme.accent.brighter(15%) : Theme.accent)
        : touch.has-hover ? Theme.bg_lighter : Theme.bg_light;

    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.fg_dim : root.primary ? Theme.bg : Theme.fg;
        font-size: Typography.secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component KeypadToggle inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.bg_lighter;

    // The knob's side (not only its color) shows the state.
    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        animate x { duration: 150ms; easing: ease-in-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

// Keys in a grid (row-major, `cols` per row) and knobs in a column to the right.
component KeypadCanvas inherits Rectangle {
    in property <[KeypadControl]> controls;
    in property <int> cols: 5;
    in property <int> rows: 3;
    in property <int> knobs: 0;
    in property <bool> show-summary: true;
    callback clicked(string);

    property <length> cell: 72px;
    property <length> gap: 8px;
    height: max(root.rows, 1) * root.cell;
    min-width: root.cols * root.cell + (root.knobs > 0 ? root.cell + 16px : 0px);

    for control in root.controls: Rectangle {
        x: control.knob ? root.cols * root.cell + 16px : control.col * root.cell;
        y: control.row * root.cell;
        width: root.cell - root.gap;
        height: root.cell - root.gap;
        border-radius: control.knob ? (root.cell - root.gap) / 2 : 6px;
        background: control.active ? Theme.accent
            : control.selected ? Theme.accent.transparentize(75%)
            : cell-touch.has-hover ? Theme.hover : Theme.bg;
        border-width: control.selected || control.seen ? 2px : 1px;
        border-color: control.seen ? Theme.success : control.selected ? Theme.accent : Theme.bg_lighter;

        Text {
            x: control.knob ? (parent.width - self.width) / 2 : 6px;
            y: control.knob ? 8px : 4px;
            text: control.label;
            color: control.active ? Theme.bg : Theme.fg_dim;
            font-size: Typography.caption;
        }

        if control.glyph != "": Text {
            x: (parent.width - self.width) / 2;
            y: control.knob ? 24px : 19px;
            text: control.glyph;
            font-family: KeypadIcons.family;
            font-size: control.knob ? 12px : 18px;
            color: control.active ? Theme.bg : Theme.accent;
        }

        if root.show-summary: Text {
            x: 4px;
            y: parent.height - self.height - (control.knob ? 9px : 4px);
            width: parent.width - 8px;
            text: control.summary;
            color: control.active ? Theme.bg : Theme.fg;
            font-size: Typography.caption;
            horizontal-alignment: center;
            overflow: elide;
        }

        // Check mark shape (not only the green border) for confirmed inputs.
        if control.seen: Text {
            x: control.knob ? (parent.width - self.width) / 2 : parent.width - self.width - 6px;
            y: control.knob ? parent.height - self.height - 10px : 4px;
            text: "\u{2713}";
            color: Theme.success;
            font-size: Typography.secondary;
            font-weight: 700;
        }

        cell-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(control.id); }
        }
    }
}

// Small schematic of a keypad variant: keys row-major in `cols` columns,
// knobs (round) stacked in one extra column on the right.
component KeypadMiniPad inherits Rectangle {
    in property <int> keys;
    in property <int> knobs;
    in property <int> cols: 1;
    in property <color> ink: Theme.fg_dim;
    // Fits any variant into this box; cells shrink for tall or wide grids.
    in property <length> box-width: 60px;
    in property <length> box-height: 30px;

    property <int> columns: max(root.cols, 1);
    property <int> rows: max(Math.ceil(root.keys / root.columns), root.knobs, 1);
    property <length> cell: max(4px, min(7px, root.box-height / root.rows,
        (root.box-width - (root.knobs > 0 ? 3px : 0px)) / (root.columns + (root.knobs > 0 ? 1 : 0))));
    width: root.columns * root.cell + (root.knobs > 0 ? root.cell + 3px : 0px);
    height: root.rows * root.cell;

    for i in root.keys: Rectangle {
        x: Math.mod(i, root.columns) * root.cell;
        y: Math.floor(i / root.columns) * root.cell;
        width: root.cell - 1px;
        height: root.cell - 1px;
        border-radius: 1px;
        background: root.ink;
    }
    for j in root.knobs: Rectangle {
        x: root.columns * root.cell + 3px;
        y: j * root.cell;
        width: root.cell - 1px;
        height: root.cell - 1px;
        border-radius: (root.cell - 1px) / 2;
        border-width: 1px;
        border-color: root.ink;
    }
}

// Variant picker: like ResDropdown, with a schematic next to every entry.
component KeypadVariantDropdown inherits Rectangle {
    in property <[KeypadVariant]> model: [];
    in property <int> current-index: -1;
    callback selected(int);

    property <length> item-height: 40px;
    height: root.item-height;
    border-radius: 4px;
    background: Theme.bg;
    border-width: 1px;
    border-color: drop-touch.has-hover ? Theme.accent : Theme.bg_lighter;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;

        if root.current-index >= 0 && root.current-index < root.model.length: VerticalLayout {
            alignment: center;
            width: 64px;
            KeypadMiniPad {
                keys: root.model[root.current-index].keys;
                knobs: root.model[root.current-index].knobs;
                cols: root.model[root.current-index].cols;
                ink: Theme.accent;
            }
        }
        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length
                ? root.model[root.current-index].name : "Choose your keypad";
            color: Theme.fg;
            font-size: Typography.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: "\u{25bc}";
            color: Theme.fg_dim;
            font-size: Typography.caption;
            vertical-alignment: center;
            width: 16px;
        }
    }

    drop-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: parent.height + 2px;
        width: root.width;
        height: min(320px, root.model.length * root.item-height + 4px);
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: 4px;
            background: Theme.bg_light;
            border-width: 1px;
            border-color: Theme.bg_lighter;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000066;

            Flickable {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                viewport-width: self.width;
                viewport-height: root.model.length * root.item-height;

                for item[idx] in root.model: Rectangle {
                    y: idx * root.item-height;
                    height: root.item-height;
                    width: parent.width;
                    border-radius: 3px;
                    background: idx == root.current-index ? Theme.accent
                              : opt-touch.has-hover ? Theme.bg_lighter
                              : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            width: 64px;
                            KeypadMiniPad {
                                keys: item.keys;
                                knobs: item.knobs;
                                cols: item.cols;
                                ink: idx == root.current-index ? Theme.bg : Theme.fg_dim;
                            }
                        }
                        Text {
                            text: item.name;
                            color: idx == root.current-index ? Theme.bg : Theme.fg;
                            font-size: Typography.secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    opt-touch := TouchArea {
                        clicked => {
                            root.selected(idx);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// "−  7  +" for a bounded number.
component KeypadStepper inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 16;
    callback changed(int);

    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.fg_dim;
        font-size: Typography.secondary;
        vertical-alignment: center;
    }
    KeypadButton {
        text: "\u{2212}";
        enabled: root.value > root.minimum;
        clicked => { root.changed(root.value - 1); }
    }
    Text {
        text: root.value;
        color: Theme.fg;
        font-size: Typography.body;
        horizontal-alignment: center;
        vertical-alignment: center;
        min-width: 24px;
    }
    KeypadButton {
        text: "+";
        enabled: root.value < root.maximum;
        clicked => { root.changed(root.value + 1); }
    }
}

// The cheatsheet as the overlay will show it. Shape carries state: solid
// border = does something now, thin dim border + italic = inactive now,
// no border and a dot = unbound.
component KeypadSheetPreview inherits Rectangle {
    in property <[KeypadSheetCell]> cells;
    in property <int> cols: 5;
    in property <int> rows: 3;
    in property <string> title;
    in property <string> notice;
    in property <float> sheet-opacity: 0.35;

    property <length> key-w: 92px;
    property <length> key-h: 62px;
    property <length> knob-w: 160px;
    property <length> knob-h: 66px;
    property <length> gap: 6px;
    property <length> pitch: max(root.key-h, root.knob-h) + root.gap;
    property <length> header: root.notice != "" ? 44px : 26px;

    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.bg_lighter;
    // Opacity applies to the background only, as on screen.
    background: Theme.bg.transparentize(1 - root.sheet-opacity);
    min-width: root.cols * (root.key-w + root.gap) + root.knob-w + 20px;
    height: root.header + root.rows * root.pitch + 8px;

    Text {
        x: 10px;
        y: 6px;
        text: root.title;
        color: Theme.fg;
        font-size: Typography.secondary;
        font-weight: 600;
    }
    if root.notice != "": Text {
        x: 10px;
        y: 24px;
        width: parent.width - 20px;
        text: "! " + root.notice;
        color: Theme.warning;
        font-size: Typography.caption;
        overflow: elide;
    }
    for c in root.cells: Rectangle {
        x: 10px + c.col * (root.key-w + root.gap);
        y: root.header + c.row * root.pitch;
        width: c.knob ? root.knob-w : root.key-w;
        height: c.knob ? root.knob-h : root.key-h;
        border-radius: c.knob ? 12px : 5px;
        border-width: c.bound ? 1px : 0px;
        border-color: c.active ? Theme.accent : Theme.fg_dim;

        Text {
            x: 5px;
            y: 2px;
            text: c.num;
            color: Theme.fg_dim;
            font-size: Typography.caption;
        }
        // A key: its icon, large, with the label under it (or the label alone).
        if !c.knob && c.bound && c.glyph != "": Text {
            x: (parent.width - self.width) / 2;
            y: 12px;
            text: c.glyph;
            font-family: KeypadIcons.family;
            font-size: 22px;
            color: c.active ? Theme.accent : Theme.fg_dim;
        }
        if !c.knob: Text {
            x: 5px;
            y: c.bound && c.glyph != "" ? 38px : 15px;
            width: parent.width - 10px;
            height: parent.height - self.y - 2px;
            text: c.bound ? c.text : "·";
            color: c.bound && c.active ? Theme.fg : Theme.fg_dim;
            font-italic: c.bound && !c.active;
            font-size: Typography.caption;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
        // A knob: one line per direction, with the direction's and the action's icons.
        for line[i] in c.lines: Rectangle {
            x: 5px;
            y: 16px + i * 16px;
            width: parent.width - 10px;
            height: 16px;
            Text {
                x: 0px;
                height: parent.height;
                vertical-alignment: center;
                text: line.dir;
                font-family: KeypadIcons.family;
                font-size: 12px;
                color: Theme.fg_dim;
            }
            Text {
                x: 15px;
                height: parent.height;
                vertical-alignment: center;
                text: line.bound ? line.glyph : "";
                font-family: KeypadIcons.family;
                font-size: 13px;
                color: line.active ? Theme.accent : Theme.fg_dim;
            }
            Text {
                x: 33px;
                width: parent.width - 33px;
                height: parent.height;
                vertical-alignment: center;
                text: line.bound ? line.text : "·";
                color: line.bound && line.active ? Theme.fg : Theme.fg_dim;
                font-italic: line.bound && !line.active;
                font-size: Typography.caption;
                overflow: elide;
            }
        }
    }
}

// Where the overlay appears: a 3x3 grid standing for the screen.
component KeypadPositionPicker inherits Rectangle {
    in property <int> current: 4;
    callback selected(int);

    width: 3 * 34px + 8px;
    height: 3 * 22px + 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.bg_lighter;
    background: Theme.bg;

    for i in 9: Rectangle {
        x: 4px + Math.mod(i, 3) * 34px;
        y: 4px + Math.floor(i / 3) * 22px;
        width: 32px;
        height: 20px;
        border-radius: 3px;
        border-width: 1px;
        border-color: i == root.current ? Theme.accent : (cell-touch.has-hover ? Theme.fg_dim : transparent);
        background: i == root.current ? Theme.accent : Theme.panel;
        cell-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(i); }
        }
    }
}

component KeypadInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback accepted();
    callback edited(string);

    height: Typography.compact-control;
    border-radius: 4px;
    background: Theme.bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.bg_lighter;

    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        color: Theme.fg;
        font-size: Typography.secondary;
        text <=> root.text;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }

    if root.text == "": Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.fg_dim;
        font-size: Typography.secondary;
        overflow: elide;
    }
}

// Searchable grid of the outline keypad icons, plus "Automatic" and "No icon".
component KeypadIconPicker inherits Rectangle {
    in property <[KeypadIcon]> icons;
    in property <string> current;
    in-out property <string> query;
    callback search(string);
    callback picked(string);

    property <length> cell: 40px;
    property <int> cols: max(1, Math.floor((self.width - 16px) / self.cell));
    property <string> hovered;

    border-radius: 6px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.bg_lighter;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            KeypadInput {
                horizontal-stretch: 1;
                text <=> root.query;
                placeholder: "Search: volume, play, folder, github";
                edited(t) => { root.search(t); }
            }
            KeypadButton {
                text: "Automatic";
                primary: root.current == "";
                clicked => { root.picked(""); }
            }
            KeypadButton {
                text: "No icon";
                primary: root.current == "none";
                clicked => { root.picked("none"); }
            }
        }
        Flickable {
            height: 4 * root.cell + 12px;
            viewport-width: self.width;
            viewport-height: max(self.height, Math.ceil(root.icons.length / root.cols) * root.cell);
            for icon[i] in root.icons: Rectangle {
                x: Math.mod(i, root.cols) * root.cell;
                y: Math.floor(i / root.cols) * root.cell;
                width: root.cell - 4px;
                height: root.cell - 4px;
                border-radius: 4px;
                // The chosen icon is outlined, not only tinted.
                background: icon.name == root.current ? Theme.accent.transparentize(70%) : touch.has-hover ? Theme.hover : transparent;
                border-width: icon.name == root.current ? 2px : 0px;
                border-color: Theme.accent;
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: icon.glyph;
                    font-family: KeypadIcons.family;
                    font-size: 20px;
                    color: Theme.fg;
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(icon.name); }
                    changed has-hover => {
                        if self.has-hover {
                            root.hovered = icon.name;
                        }
                    }
                }
            }
        }
        Text {
            text: root.icons.length == 0 ? "No icon matches."
                : root.hovered != "" ? root.hovered
                : root.icons.length + " outline icons (Tabler Icons, MIT)";
            color: Theme.fg_dim;
            font-size: Typography.caption;
        }
    }
}

export component MainWindow inherits Window {
    title: "Settings";
    default-font-family: "Noto Sans";
    default-font-size: Typography.body;
    preferred-width: 900px;
    preferred-height: 560px;
    min-width: 500px;
    min-height: 350px;
    no-frame: true;
    background: Theme.bg.transparentize(1.0 - Theme.opacity);

    // ── Tab state ──
    in-out property <int> active-tab: 0;
    callback dropdown-scroll-offset(int, float, float, float, float, float) -> float;

    // ── Deep-link highlight ──
    in property <string> highlight-setting: "";
    in-out property <bool> highlight-blink-on: false;

    // ── Keyboard tab properties ──
    in property <[KeyData]> row0;
    in property <[KeyData]> row1;
    in property <[KeyData]> row2;
    in property <[KeyData]> row3;
    in property <[KeyData]> row4;
    in property <string> layout-name: "Loading...";
    in property <[string]> available-layouts;
    in-out property <[LayoutEntry]> active-layouts;
    in property <bool> loading: true;

    property <bool> dropdown-open: false;
    in-out property <int> selected-dropdown-index: -1;
    property <int> highlighted-dropdown-index: 0;
    property <string> search-text: "";
    property <bool> show-help: false;
    property <string> global-search-text: "";
    property <int> search-selected-index: 0;
    in property <[SearchResult]> search-results;

    // ── Dictation tab properties ──
    in property <bool> dictation-installed: false;
    in property <string> dictation-language: "unknown";
    in property <string> dictation-model: "unknown";
    in property <bool> dictation-service-running: false;
    in property <bool> dictation-installing: false;
    in property <bool> dictation-install-error: false;
    in property <float> dictation-progress: 0;
    in property <string> dictation-progress-text: "Starting...";
    in-out property <bool> dictation-configuring: false;
    in property <[string]> dictation-lang-list;
    in property <string> dictation-selected-lang-name: "English (recommended)";
    in property <bool> dictation-show-also-english: false;
    property <bool> dictation-lang-dropdown-open: false;
    property <string> dictation-lang-search: "";
    property <int> dictation-lang-highlighted-idx: 0;
    in property <[ModelEntry]> dictation-model-list;
    in-out property <int> dictation-selected-model-idx: 0;
    property <ModelEntry> dictation-selected-model: root.dictation-model-list[root.dictation-selected-model-idx];
    in-out property <bool> dictation-also-english: true;
    in property <bool> dictation-config-missing: false;
    // Set by Rust when the configured model can't be loaded; empty when it's ready.
    in property <string> dictation-model-problem: "";
    in property <string> dictation-model-help: "";
    in property <bool> dictation-model-downloadable: false;
    property <bool> dictation-selected-lang-is-english:
        root.dictation-selected-lang-name == "English (recommended)";

    // ── Display tab properties ──
    // Rust publishes verified rows. The controls below only read the selected
    // row through these derived properties; no separate copies exist.
    in property <[MonitorInfo]> disp-monitors: [];
    in-out property <int> disp-selected-index: -1;
    in-out property <bool> disp-dragging: false;
    out property <bool> disp-selection-valid: root.disp-selected-index >= 0 && root.disp-selected-index < root.disp-monitors.length;
    out property <[string]> disp-selected-modes: root.disp-selection-valid ? root.disp-monitors[root.disp-selected-index].available-modes : [];
    out property <int> disp-selected-mode-index: root.disp-selection-valid ? root.disp-monitors[root.disp-selected-index].current-mode-index : -1;
    out property <float> disp-selected-scale: root.disp-selection-valid ? root.disp-monitors[root.disp-selected-index].scale : 1.0;
    out property <[string]> disp-selected-orientations: root.disp-selection-valid ? root.disp-monitors[root.disp-selected-index].orientation-options : [];
    out property <int> disp-selected-orientation: root.disp-selection-valid ? root.disp-monitors[root.disp-selected-index].current-orientation-index : -1;
    in property <string> disp-status-text: "";
    in property <bool> disp-status-warning: false;
    in property <bool> disp-has-changes: false;
    // A display task (apply, reload, refresh…) is running.
    in property <bool> disp-busy: false;
    // The live configuration changed while edits were pending.
    in property <bool> disp-stale: false;
    in property <bool> disp-available: true;
    in property <string> disp-unavailable-reason: "";
    // Saved rules that differ from the active configuration, one per line.
    in property <string> disp-drift-text: "";
    in property <bool> disp-workspace-policy: false;
    // The display currently showing workspace 1.
    in property <string> disp-primary-name: "";
    out property <bool> disp-can-apply: root.disp-has-changes && !root.disp-busy && !root.disp-stale;
    out property <bool> disp-can-revert: root.disp-has-changes && !root.disp-busy;
    out property <bool> disp-drift-actionable: !root.disp-has-changes && !root.disp-busy && !root.disp-stale;
    out property <bool> disp-primary-movable: root.disp-selection-valid && !root.disp-workspace-policy && !root.disp-busy
        && !root.disp-monitors[root.disp-selected-index].is-primary;

    // ── Power tab properties ──
    in property <int> power-profile-index: -1;
    // -1 means custom/unavailable, not the nearest preset.
    in property <int> idle-lock-index: -1;
    in property <int> idle-dpms-index: -1;
    in property <int> idle-suspend-index: -1;
    in property <int> idle-shutdown-index: -1;
    in property <string> idle-lock-custom-label: "Custom";
    in property <string> idle-dpms-custom-label: "Custom";
    in property <string> idle-suspend-custom-label: "Custom";
    in property <string> idle-shutdown-custom-label: "Custom";
    in property <bool> idle-available: false;
    in property <bool> power-busy: false;
    in property <bool> power-profiles-available: false;
    in property <string> power-config-status: "";
    in property <string> power-config-revision: "";
    in property <string> power-runtime-status: "";
    in property <string> power-profile-status: "";
    in property <string> power-action-status: "";

    // ── About tab properties ──
    in property <string> app-version: "dev";
    in property <string> about-version: "dev";
    in property <string> about-kernel: "";
    in property <string> about-uptime: "";
    in property <string> about-hostname: "smplOS";
    in property <string> about-cpu: "";
    in property <string> about-ram: "";
    in property <string> about-gpu: "";

    // ── Keybindings tab properties ──
    in property <[BindingEntry]> kb-bindings: [];
    in property <[string]> kb-sections: [];
    in-out property <int> kb-selected-section: 0;
    in-out property <string> kb-filter-text: "";
    in-out property <int> kb-edit-idx: -1;
    in property <string> kb-status-text: "";
    in property <bool> kb-has-changes: false;
    in-out property <bool> kb-capturing: false;
    in-out property <int> kb-capture-idx: -1;
    in property <string> kb-capture-combo: "";
    property <bool> kb-adding: false;
    in-out property <string> kb-new-desc: "";
    in-out property <string> kb-new-cmd: "";

    // ── Taskbar tab properties ──
    in-out property <string> tb-status;
    in-out property <bool> tb-busy: false;
    in-out property <int>  tb-ws-count: 4;
    in-out property <int>  tb-ws-position-index: 0;      // 0 = center, 1 = left
    in-out property <int>  tb-ws-spacing: 1;             // pixel gap between dots (1-10)
    in-out property <int>  tb-ws-style-index: 0;         // 0 = numbers, 1 = squares
    // Clock
    in-out property <int>  tb-clock-format-index: 0;    // 0=time, 1=dow, 2=date
    in-out property <bool> tb-clock-24h: false;          // true=24h, false=AM/PM
    in-out property <int>  tb-clock-date-fmt-index: 0;  // 0=M/D, 1=D/M, 2=ISO, 3=Mon D

    // ── Wi-Fi tab properties ──
    in property <[WifiEntry]> wifi-networks: [];
    in-out property <int>    wifi-selected-idx: -1;
    in-out property <string> wifi-password-input: "";
    in-out property <bool>   wifi-show-password: false;
    in property <bool>       wifi-scanning: false;
    in property <bool>       wifi-connecting: false;
    in property <string>     wifi-status: "";
    in property <bool>       wifi-status-is-error: false;
    in property <string>     wifi-current-ssid: "";
    in property <bool>       wifi-airplane-mode: false;
    in property <bool>       wifi-no-hardware: false;
    in property <image>      wifi-qr-image;
    in-out property <bool>   wifi-qr-visible: false;
    in property <string>     wifi-qr-error: "";
    in-out property <string> wifi-uri-input: "";
    // All saved 802-11-wireless profiles known to NetworkManager,
    // regardless of whether they are currently in range.
    in property <[string]>   wifi-saved-networks: [];

    // ── Bluetooth tab properties ──
    in property <[BtDevice]> bt-devices: [];
    in-out property <int>    bt-selected-idx: -1;
    in property <bool>       bt-scanning: false;
    in property <bool>       bt-connecting: false;
    in property <string>     bt-status: "";
    in property <bool>       bt-status-is-error: false;
    in property <bool>       bt-powered: false;
    in property <bool>       bt-no-hardware: false;
    in property <bool>       bt-discoverable: false;

    // ── Glasses (XR) tab properties ──
    in property <bool>       xr-glasses-connected: false;  // VITURE USB device present
    in property <bool>       xr-running: false;            // renderer process alive
    in property <bool>       xr-live: false;               // control socket reachable
    in property <string>     xr-status: "";
    in property <bool>       xr-status-is-error: false;
    in-out property <bool>   xr-enabled: false;            // auto-launch service enabled
    in-out property <int>    xr-monitor-count: 3;          // 1 or 3
    in-out property <int>    xr-layout-index: 0;           // 0=arc, 1=flat
    in-out property <float>  xr-radius: 2.0;
    in-out property <float>  xr-fov: 46.0;
    in-out property <float>  xr-curvature: 0.0;
    in-out property <float>  xr-smoothing: 0.0;
    in-out property <bool>   xr-stereo: false;
    in-out property <int>    xr-capture-index: 0;          // 0=auto, 1=ext, 2=wlr
    in-out property <bool>   xr-prefer-dmabuf: true;
    in-out property <bool>   xr-headtracking: false;

    // ── Hints (Vimium-style keyboard navigation) tab properties ──
    // The `hints` daemon shows two-letter labels over every clickable
    // widget on screen when the user hits Super+;. This toggle drives
    // enable/disable at runtime; see settings/src/hints.rs.
    in-out property <bool> hints-enabled: true;

    // ── Callbacks ──
    callback close();
    callback move-window(float, float);

    // Keyboard
    callback add-layout(int);
    callback remove-layout(int);
    callback preview-layout(int);
    callback preview-dropdown(int);
    callback filter-layouts(string);

    // Dictation
    callback filter-dictation-langs(string);
    callback select-dictation-lang(int);
    callback start-dictation-install();
    callback start-dictation-reconfigure();
    callback download-dictation-model();
    callback open-dictation-config();
    callback restart-dictation-service();
    callback cancel-dictation-install();

    // Display
    callback disp-select-monitor(int);
    callback disp-drag-finished(int, float, float);
    callback disp-change-resolution(int, int);
    callback disp-change-scale(int, float);
    callback disp-change-orientation(int, int);
    callback disp-set-primary(int);
    callback disp-apply-changes();
    callback disp-revert-changes();
    callback disp-refresh-monitors();
    callback disp-tab-entered();
    callback disp-identify-monitors();
    callback disp-use-saved();             // reload monitors.conf as saved
    callback disp-keep-current();          // save the active layout

    // Power
    callback set-power-profile(int);
    callback set-idle-lock(int);
    callback set-idle-dpms(int);
    callback set-idle-suspend(int);
    callback set-idle-shutdown(int);
    callback power-refresh();               // re-read hypridle.conf + power profile from disk

    // Keybindings
    callback kb-load();
    callback kb-filter(string, int);
    callback kb-edit-combo(int);
    callback kb-save-combo(int, string, string);
    callback kb-edit-args(int, string);
    callback kb-remove(int);
    callback kb-add(string, string);
    callback kb-save();
    callback kb-revert();
    callback kb-open-editor();
    callback kb-cancel-capture();

    // Taskbar
    callback tb-refresh();
    callback tb-set-ws-count(int);
    callback tb-set-ws-position(int);
    callback tb-set-ws-spacing(int);
    callback tb-set-ws-style(int);
    callback tb-set-clock-format(int);     // 0=time, 1=dow, 2=date
    callback tb-set-clock-24h(bool);       // true=24h, false=AM/PM
    callback tb-set-clock-date-fmt(int);   // 0=M/D, 1=D/M, 2=ISO, 3=Mon D

    // Wi-Fi
    callback wifi-list();                  // fast refresh (no active rescan)
    callback wifi-scan();                  // active rescan (background thread)
    callback wifi-connect(int, string, int); // (network_idx, password, security_idx)
    callback wifi-disconnect();
    callback wifi-forget(int);             // network_idx
    callback wifi-generate-qr(int);        // network_idx → renders QR into wifi-qr-image
    callback wifi-apply-uri(string);       // connect from a WIFI: URI string
    callback wifi-scan-screenshot();       // grim + zbarimg screen scan
    callback wifi-export-qr(int);          // save QR SVG to ~/Downloads/
    callback wifi-set-airplane(bool);       // enable/disable airplane mode
    callback wifi-list-saved();            // refresh wifi-saved-networks
    callback wifi-forget-by-ssid(string);  // delete saved profile by SSID
    callback wifi-forget-all();            // delete every saved 802-11-wireless profile

    // Bluetooth
    callback bt-list();                    // refresh devices list
    callback bt-scan();                    // active scan (blocking ~4s)
    callback bt-connect(int);              // device index
    callback bt-disconnect(int);           // device index
    callback bt-pair(int);                 // device index
    callback bt-trust(int);                // device index
    callback bt-forget(int);               // device index
    callback bt-set-powered(bool);         // power on/off
    callback bt-set-discoverable(bool);    // discoverable on/off

    // Glasses (XR)
    callback xr-refresh();                  // detect glasses + load config/state
    callback xr-set-enabled(bool);          // enable/disable auto-launch + start/stop now
    callback xr-set-monitors(int);          // 1 or 3 virtual monitors
    callback xr-set-layout(int);            // 0=arc, 1=flat
    callback xr-set-radius(float);          // arc radius
    callback xr-set-fov(float);             // horizontal FOV degrees
    callback xr-set-curvature(float);       // 0=flat..1=curved
    callback xr-set-smoothing(float);       // 0=raw..1=heavy slerp
    callback xr-set-stereo(bool);           // side-by-side 3D
    callback xr-set-capture(int);           // 0=auto, 1=ext, 2=wlr
    callback xr-set-prefer-dmabuf(bool);    // zero-copy capture
    callback xr-set-headtracking(bool);     // mode B head-look output
    callback xr-recenter();                 // snap origin to current head dir

    // Hints (Vimium-style keyboard navigation)
    callback hints-set-enabled(bool);

    // ── Keypad (CH552 macro keypads, control-surface daemon) ──────────────
    in property <bool> kp-connected: false;
    in property <bool> kp-bootloader: false;
    in property <string> kp-device-title;
    in property <string> kp-device-detail;
    in property <string> kp-firmware;
    in property <string> kp-firmware-text;
    // Keypad app (control-surfaced): running state and the Start offer.
    in property <string> kp-app-text;
    in property <bool> kp-show-start: false;
    // Variant: detected (read-only) for self-describing keypads, else a menu.
    in property <string> kp-variant-detected;
    in property <bool> kp-variant-picker: true;
    in property <[KeypadVariant]> kp-variants;
    in property <int> kp-variant-index: 0;
    in property <bool> kp-custom: false;
    in property <int> kp-custom-keys: 15;
    in property <int> kp-custom-knobs: 3;
    in property <int> kp-custom-cols: 5;
    in property <string> kp-layout-note;
    in property <[KeypadControl]> kp-controls;
    in property <int> kp-cols: 5;
    in property <int> kp-rows: 3;
    in property <int> kp-knobs: 3;
    in property <bool> kp-identify: false;
    in property <string> kp-live-note;
    in property <[string]> kp-profile-names;
    in property <int> kp-profile-index: 0;
    in property <bool> kp-profile-global: true;
    in-out property <string> kp-profile-class;
    in property <bool> kp-profile-kdenlive: false;
    in property <bool> kp-profile-key-fallback: false;
    in property <string> kp-profile-note;
    in property <bool> kp-adding-profile: false;
    in property <[string]> kp-app-classes;
    in-out property <string> kp-new-app;
    in property <string> kp-selected-title;
    in property <bool> kp-selected-knob: false;
    in property <int> kp-knob-event: 0;
    in property <[string]> kp-action-names;
    in property <int> kp-action-index: 0;
    in-out property <string> kp-action-text;
    in property <[string]> kp-choice-names;
    in property <int> kp-choice-index: -1;
    // 0 = explanation only, 1 = text field, 2 = choice list, 3 = advanced (read-only)
    in property <int> kp-editor-mode: 0;
    in property <string> kp-editor-hint;
    in property <string> kp-advanced-text;
    in property <[KeypadBindingRow]> kp-binding-rows;
    in property <bool> kp-dirty: false;
    in property <bool> kp-saving: false;
    in property <string> kp-config-path;
    in property <bool> kp-config-exists: false;
    in property <string> kp-status;
    in property <bool> kp-status-is-error: false;
    in property <bool> kp-wizard-open: false;
    in property <int> kp-wizard-step: 0;
    in property <string> kp-wizard-title;
    in property <bool> kp-wizard-ack: false;
    in property <[string]> kp-fw-names;
    in property <int> kp-fw-index: -1;
    in property <string> kp-fw-detail;
    in property <string> kp-wizard-hint;
    in property <bool> kp-wizard-can-next: false;
    in property <[string]> kp-flash-log;
    in property <bool> kp-flash-running: false;
    in property <bool> kp-dry-run: true;
    // Cheatsheet: per-binding label, options and preview.
    in-out property <string> kp-label-text;
    // "ifInstalled" of the binding being edited (space-separated names).
    in-out property <string> kp-needs-text;
    in property <string> kp-needs-placeholder;
    // Profile details.
    in-out property <string> kp-profile-name;
    in-out property <string> kp-profile-title;
    in property <bool> kp-profile-fallthrough: true;
    // Advanced: input mode (index into Automatic, Keymap, Raw) and its state.
    in property <int> kp-input-index: 0;
    in property <string> kp-input-help;
    in property <string> kp-input-now;
    in property <string> kp-input-health;
    in property <bool> kp-input-healthy: true;
    in property <[KeypadTuning]> kp-knob-tunings;
    in property <[KeypadTuning]> kp-kdenlive-tunings;
    in property <bool> kp-tunings-custom: false;
    in property <bool> kp-sheet-overlay: true;
    in-out property <bool> kp-advanced-open: false;
    // Icon of the binding being edited: "" automatic, "none", or a name.
    in property <string> kp-icon-name;
    in property <string> kp-icon-glyph;
    in property <string> kp-icon-caption;
    in property <bool> kp-icon-picker-open: false;
    in-out property <string> kp-icon-query;
    in property <[KeypadIcon]> kp-icon-results;
    // The keypad app draws icons on the cheatsheet (else they are only saved).
    in property <bool> kp-icons-shown: false;
    in property <bool> kp-label-enabled: false;
    in property <bool> kp-sheet-supported: false;
    in property <float> kp-sheet-opacity: 0.35;
    in property <bool> kp-sheet-click-through: false;
    in property <[string]> kp-sheet-hide-names;
    in property <int> kp-sheet-hide-index: 0;
    in property <int> kp-sheet-position: 4;
    in property <[string]> kp-sheet-contexts;
    in property <int> kp-sheet-context: 0;
    in property <string> kp-sheet-title;
    in property <string> kp-sheet-notice;
    in property <[KeypadSheetCell]> kp-sheet-cells;
    in property <int> kp-sheet-cols: 5;
    in property <int> kp-sheet-rows: 3;
    in property <int> kp-verify-seen: 0;
    in property <int> kp-verify-total: 0;
    callback kp-refresh();
    callback kp-start-app();
    callback kp-open-scope-help();
    callback kp-override-variant();
    callback kp-select-variant(int);
    callback kp-set-custom(int, int, int);
    callback kp-select-control(string);
    callback kp-select-knob-event(int);
    callback kp-select-profile(int);
    callback kp-start-add-profile();
    callback kp-pick-app(int);
    callback kp-confirm-add-profile();
    callback kp-cancel-add-profile();
    callback kp-remove-profile();
    callback kp-apply-profile-details();
    callback kp-set-fallthrough(bool);
    callback kp-set-input-mode(int);
    callback kp-set-tuning(string, float);
    callback kp-reset-tunings();
    callback kp-set-sheet-overlay(bool);
    callback kp-set-kdenlive(bool);
    callback kp-set-key-fallback(bool);
    callback kp-load-kdenlive-preset();
    callback kp-select-action(int);
    callback kp-select-choice(int);
    callback kp-apply-binding();
    callback kp-toggle-icon-picker();
    callback kp-search-icons(string);
    callback kp-pick-icon(string);
    callback kp-save();
    callback kp-revert();
    callback kp-open-config();
    callback kp-toggle-identify();
    callback kp-open-wizard();
    callback kp-set-wizard-ack(bool);
    callback kp-select-firmware(int);
    callback kp-wizard-next();
    callback kp-wizard-back();
    callback kp-close-wizard();
    callback kp-flash();
    callback kp-set-sheet-opacity(float);
    callback kp-set-sheet-hide(int);
    callback kp-set-sheet-click-through(bool);
    callback kp-set-sheet-position(int);
    callback kp-set-sheet-context(int);
    callback kp-show-sheet();

    // Search
    callback filter-search(string);

    // ── Keep UI in sync with on-disk configuration ────────────────────────
    // Every path that changes `active-tab` (sidebar click, keyboard shortcut,
    // search-jump Enter, programmatic set from Rust) fires this handler, so
    // whichever tab the user lands on re-reads its config from disk instead
    // of showing stale values captured at startup.
    changed active-tab => {
        if root.active-tab == 3 { root.disp-tab-entered(); }
        if root.active-tab == 4 { root.power-refresh(); }
        if root.active-tab == 5 { root.kb-load(); }
        if root.active-tab == 6 { root.tb-refresh(); }
        if root.active-tab == 7 { root.wifi-list(); }
        if root.active-tab == 8 { root.bt-list(); }
        if root.active-tab == 9 { root.xr-refresh(); }
        if root.active-tab == 11 { root.kp-refresh(); }
    }

    // ── Keyboard shortcuts ──
    focus-scope := FocusScope {
        // Grab focus on launch so shortcuts work immediately
        init => { self.focus(); }
        key-pressed(e) => {
            // Key capture mode for keybinding editing
            if root.kb-capturing {
                if e.text == Key.Escape {
                    root.kb-capturing = false;
                    root.kb-capture-idx = -1;
                    root.kb-cancel-capture();
                    return accept;
                }
                // Build modifier+key combo display and send to backend
                // Skip pure modifier presses (they have no printable text beyond the mod key names)
                if e.text != Key.Control && e.text != Key.Alt && e.text != Key.Shift && e.text != Key.Meta {
                    // Build mods string for Hyprland format
                    root.kb-save-combo(
                        root.kb-capture-idx,
                        (e.modifiers.meta ? "SUPER " : "")
                            + (e.modifiers.control ? "CTRL " : "")
                            + (e.modifiers.alt ? "ALT " : "")
                            + (e.modifiers.shift ? "SHIFT " : ""),
                        e.text
                    );
                    root.kb-capturing = false;
                    root.kb-capture-idx = -1;
                    return accept;
                }
                return accept;
            }
            if e.text == Key.Escape {
                if root.dropdown-open {
                    root.dropdown-open = false;
                    return accept;
                }
                if root.dictation-lang-dropdown-open {
                    root.dictation-lang-dropdown-open = false;
                    return accept;
                }
                if root.show-help {
                    root.show-help = false;
                    return accept;
                }
                if root.dictation-configuring {
                    root.dictation-configuring = false;
                    return accept;
                }
                if root.kb-edit-idx >= 0 {
                    root.kb-edit-idx = -1;
                    root.kb-capture-idx = -1;
                    root.kb-capturing = false;
                    return accept;
                }
                if root.kb-adding {
                    root.kb-adding = false;
                    return accept;
                }
                root.close();
                return accept;
            }
            if e.modifiers.alt && (e.text == "a" || e.text == "A") && root.active-tab == 1 {
                if root.available-layouts.length > 0 && root.selected-dropdown-index >= 0 {
                    root.add-layout(root.selected-dropdown-index);
                }
                return accept;
            }
            if e.modifiers.alt && (e.text == "c" || e.text == "C") && root.active-tab == 1 {
                root.dropdown-open = !root.dropdown-open;
                root.search-text = "";
                root.highlighted-dropdown-index = 0;
                if root.dropdown-open {
                    search-input.focus();
                }
                return accept;
            }
            if e.modifiers.alt && (e.text == "d" || e.text == "D") && root.active-tab == 1 {
                if root.active-layouts.length > 1 {
                    root.remove-layout(1);
                }
                return accept;
            }
            // Display tab hotkeys
            if e.modifiers.alt && root.active-tab == 3 {
                if e.text == "i" && root.disp-available && !root.disp-busy {
                    root.disp-identify-monitors();
                    return accept;
                }
                if e.text == "r" && !root.disp-busy {
                    root.disp-refresh-monitors();
                    return accept;
                }
                if e.text == "p" && root.disp-selection-valid && !root.disp-workspace-policy && !root.disp-busy {
                    root.disp-set-primary(root.disp-selected-index);
                    return accept;
                }
                if e.text == "a" && root.disp-can-apply {
                    root.disp-apply-changes();
                    return accept;
                }
                if e.text == "v" && root.disp-has-changes && !root.disp-busy {
                    root.disp-revert-changes();
                    return accept;
                }
            }
            if e.text == "?" {
                root.show-help = !root.show-help;
                root.dropdown-open = false;
                return accept;
            }
            // Ctrl+F — focus search box
            if e.modifiers.control && (e.text == "f" || e.text == "F") {
                global-search-input.focus();
                return accept;
            }
            // Search results keyboard navigation
            if root.global-search-text != "" && root.search-results.length > 0 {
                if e.text == Key.DownArrow {
                    if root.search-selected-index < root.search-results.length - 1 {
                        root.search-selected-index += 1;
                    }
                    return accept;
                }
                if e.text == Key.UpArrow {
                    if root.search-selected-index > 0 {
                        root.search-selected-index -= 1;
                    }
                    return accept;
                }
                if e.text == Key.Return {
                    root.active-tab = root.search-results[root.search-selected-index].tab-index;
                    root.global-search-text = "";
                    root.search-selected-index = 0;
                    root.filter-search("");
                    return accept;
                }
            }
            if root.global-search-text != "" && e.text == Key.Escape {
                root.global-search-text = "";
                root.search-selected-index = 0;
                root.filter-search("");
                focus-scope.focus();
                return accept;
            }
            // Tab switching: 1-8
            if !root.dropdown-open && !root.dictation-lang-dropdown-open {
                if e.text == "1" { root.active-tab = 0; return accept; }
                if e.text == "2" { root.active-tab = 1; return accept; }
                if e.text == "3" { root.active-tab = 2; return accept; }
                if e.text == "4" { root.active-tab = 3; return accept; }
                if e.text == "5" { root.active-tab = 4; return accept; }
                if e.text == "6" { root.active-tab = 5; root.kb-load(); return accept; }
                if e.text == "7" { root.active-tab = 6; return accept; }
                if e.text == "8" { root.active-tab = 7; root.wifi-list(); return accept; }
                if e.text == "9" { root.active-tab = 8; root.bt-list(); return accept; }
            }
            reject
        }
    }

    // ── Layout ───────────────────────────────────────────────────────────────

    VerticalLayout {
        visible: !root.show-help;
        padding: 10px;
        spacing: 6px;

        // ── Header ──
        HorizontalLayout {
            height: 32px;
            spacing: 8px;

            // Search input (doubles as title bar)
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                // "Settings" title, centered
                Text {
                    text: "Settings";
                    color: Theme.fg;
                    font-size: Typography.title;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                // Drag area (full header, but search box sits on top to block it)
                drag-area := TouchArea {
                    moved => {
                        root.move-window(
                            (self.mouse-x - self.pressed-x) / 1px,
                            (self.mouse-y - self.pressed-y) / 1px,
                        );
                    }
                    mouse-cursor: move;
                }
            }

            // Inline search box (right edge of title bar)
            Rectangle {
                width: 200px;
                height: Typography.compact-control;
                border-radius: 4px;
                background: Theme.panel;

                HorizontalLayout {
                    spacing: 4px;
                    padding-left: 6px;
                    padding-right: 6px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "\u{1F50D}";
                            font-size: Typography.secondary;
                            color: Theme.fg_dim;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        Rectangle {
                            // Placeholder
                            Text {
                                visible: root.global-search-text == "";
                                text: "Search...";
                                font-size: Typography.secondary;
                                color: Theme.fg_dim;
                                vertical-alignment: center;
                            }

                            global-search-input := TextInput {
                                font-size: Typography.secondary;
                                color: Theme.fg;
                                text <=> root.global-search-text;
                                edited => {
                                    root.search-selected-index = 0;
                                    root.filter-search(self.text);
                                }
                                accepted => {
                                    if root.search-results.length > 0 {
                                        root.active-tab = root.search-results[root.search-selected-index].tab-index;
                                        self.text = "";
                                        root.global-search-text = "";
                                        root.search-selected-index = 0;
                                        root.filter-search("");
                                        focus-scope.focus();
                                    }
                                }
                            }
                        }
                    }
                }

                // Block drag on the search box
                TouchArea {
                    mouse-cursor: text;
                    clicked => {
                        global-search-input.focus();
                    }
                }
            }

            // Help button
            Rectangle {
                width: Typography.compact-control;
                height: Typography.compact-control;
                border-radius: 4px;
                background: help-area.has-hover ? Theme.accent : Theme.bg_light;

                Text {
                    width: 100%; height: 100%;
                    text: "?";
                    color: help-area.has-hover ? Theme.bg : Theme.fg;
                    font-size: Typography.body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                help-area := TouchArea {
                    clicked => {
                        root.show-help = !root.show-help;
                        root.dropdown-open = false;
                        focus-scope.focus();
                    }
                }
            }

            // Close button
            Rectangle {
                width: Typography.compact-control;
                height: Typography.compact-control;
                border-radius: 4px;
                background: close-area.has-hover ? Theme.danger : Theme.bg_light;

                Text {
                    width: 100%; height: 100%;
                    text: "\u{2715}";
                    color: close-area.has-hover ? Theme.bg : Theme.fg;
                    font-size: Typography.body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-area := TouchArea {
                    clicked => { root.close(); }
                }
            }
        }

        // Separator
        Rectangle { height: 1px; background: Theme.bg_lighter; }

        // ── Main content: sidebar + tab content ──
        HorizontalLayout {
            spacing: 0px;

            // ── Left sidebar ──
            Rectangle {
                width: 168px;

                sidebar-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: self.width;
                VerticalLayout {
                    padding: 4px;
                    spacing: 4px;
                    alignment: start;

                    TabButton {
                        label: "About";
                        icon: "\u{2139}";
                        active: root.active-tab == 0;
                        clicked => {
                            root.active-tab = 0;
                            root.dropdown-open = false;
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Keyboard";
                        icon: "\u{2328}";
                        active: root.active-tab == 1;
                        clicked => {
                            root.active-tab = 1;
                            root.dropdown-open = false;
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Keypad";
                        icon: "\u{1F39B}";
                        active: root.active-tab == 11;
                        clicked => {
                            root.active-tab = 11;
                            root.dropdown-open = false;
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Dictation";
                        icon: "\u{1F399}";
                        active: root.active-tab == 2;
                        clicked => {
                            root.active-tab = 2;
                            root.dropdown-open = false;
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Display";
                        icon: "\u{1F5B5}";
                        active: root.active-tab == 3;
                        clicked => {
                            root.active-tab = 3;
                            root.dropdown-open = false;
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Power";
                        icon: "\u{26A1}";
                        active: root.active-tab == 4;
                        clicked => {
                            root.active-tab = 4;
                            root.dropdown-open = false;
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Keybindings";
                        icon: "\u{2318}";
                        active: root.active-tab == 5;
                        clicked => {
                            root.active-tab = 5;
                            root.dropdown-open = false;
                            root.kb-load();
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Taskbar";
                        icon: "\u{2261}";
                        active: root.active-tab == 6;
                        clicked => {
                            root.active-tab = 6;
                            root.dropdown-open = false;
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Wi-Fi";
                        use-outline-icon: true;
                        outline-icon: @image-url("assets/wifi-outline.svg");
                        active: root.active-tab == 7;
                        clicked => {
                            root.active-tab = 7;
                            root.dropdown-open = false;
                            root.wifi-list();
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Bluetooth";
                        use-outline-icon: true;
                        outline-icon: @image-url("assets/bluetooth-outline.svg");
                        active: root.active-tab == 8;
                        clicked => {
                            root.active-tab = 8;
                            root.dropdown-open = false;
                            root.bt-list();
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Glasses";
                        icon: "\u{1F576}";
                        active: root.active-tab == 9;
                        clicked => {
                            root.active-tab = 9;
                            root.dropdown-open = false;
                            root.xr-refresh();
                            focus-scope.focus();
                        }
                    }

                    TabButton {
                        label: "Hints";
                        use-outline-icon: true;
                        outline-icon: @image-url("assets/hints-outline.svg");
                        active: root.active-tab == 10;
                        clicked => {
                            root.active-tab = 10;
                            root.dropdown-open = false;
                            focus-scope.focus();
                        }
                    }
                }
                }
                ScrollIndicator {
                    x: parent.width - 5px;
                    height: parent.height;
                    viewport-height: sidebar-flick.viewport-height;
                    viewport-y: sidebar-flick.viewport-y;
                    visible-height: sidebar-flick.height;
                }
            }

            // Sidebar separator
            Rectangle { width: 1px; background: Theme.bg_lighter; }

            // ══════════════════════════════════════════════════════════════
            // KEYBOARD TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 1: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab1-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                VerticalLayout {
                    padding-left: 10px;
                    spacing: 6px;

                // ── Add layout row ──
                HorizontalLayout {
                    height: Typography.compact-control;
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: Typography.compact-control;
                        border-radius: 4px;
                        background: dropdown-touch.has-hover ? Theme.bg_lighter : Theme.bg_light;
                        border-width: (root.highlight-setting == "Keyboard Layout" || root.highlight-setting == "Add Layout" || root.highlight-setting == "Remove Layout" || root.highlight-setting == "XKB Layout" || root.highlight-setting == "Input Language") && root.highlight-blink-on ? 2px : 0px;
                        border-color: (root.highlight-setting == "Keyboard Layout" || root.highlight-setting == "Add Layout" || root.highlight-setting == "Remove Layout" || root.highlight-setting == "XKB Layout" || root.highlight-setting == "Input Language") && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;

                            Text {
                                horizontal-stretch: 1;
                                text: root.available-layouts.length <= 0
                                    ? "No layouts found"
                                    : root.selected-dropdown-index >= 0 && root.selected-dropdown-index < root.available-layouts.length
                                        ? root.available-layouts[root.selected-dropdown-index]
                                        : "Select a layout... (Alt+C)";
                                color: root.selected-dropdown-index >= 0 ? Theme.fg : Theme.fg_dim;
                                font-size: Typography.body;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: root.dropdown-open ? "\u{25B2}" : "\u{25BC}";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                vertical-alignment: center;
                            }
                        }

                        dropdown-touch := TouchArea {
                            clicked => {
                                root.dropdown-open = !root.dropdown-open;
                                root.search-text = "";
                                root.highlighted-dropdown-index = 0;
                                if root.dropdown-open {
                                    search-input.focus();
                                }
                            }
                        }
                    }

                    if root.active-layouts.length >= 2: Text {
                        text: "Max 2 layouts";
                        color: Theme.fg_dim;
                        font-size: Typography.secondary;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        visible: root.active-layouts.length < 2;
                        height: Typography.compact-control;
                        min-width: 32px;
                        border-radius: 4px;
                        background: root.available-layouts.length <= 0 || root.selected-dropdown-index < 0
                            ? Theme.bg_lighter.transparentize(60%)
                            : add-touch.has-hover ? Theme.success : Theme.bg_light;

                        HorizontalLayout {
                            alignment: center;
                            padding-left: 10px;
                            padding-right: 10px;

                            Rectangle {
                                width: 9px;
                                height: parent.height;
                                Text {
                                    text: "A";
                                    color: add-touch.has-hover ? Theme.bg : Theme.fg;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                Rectangle {
                                    x: 1px;
                                    y: parent.height / 2 + 7px;
                                    width: 7px;
                                    height: 1px;
                                    background: add-touch.has-hover ? Theme.bg : Theme.fg;
                                }
                            }

                            Text {
                                text: "dd Layout";
                                color: add-touch.has-hover ? Theme.bg : Theme.fg;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }
                        }

                        add-touch := TouchArea {
                            clicked => {
                                if root.available-layouts.length > 0 && root.selected-dropdown-index >= 0 {
                                    root.add-layout(root.selected-dropdown-index);
                                }
                            }
                            mouse-cursor: root.available-layouts.length > 0 && root.selected-dropdown-index >= 0 ? pointer : default;
                        }
                    }
                }

                // ── Active layouts list ──
                if root.active-layouts.length > 0: VerticalLayout {
                    spacing: 3px;
                    padding-top: 2px;
                    padding-bottom: 2px;

                    for entry[idx] in root.active-layouts: Rectangle {
                        height: Typography.compact-control;
                        border-radius: 4px;
                        background: layout-row-touch.has-hover ? Theme.bg_lighter : Theme.bg_light;

                        layout-row-touch := TouchArea {
                            clicked => { root.preview-layout(idx); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 6px;

                            Text {
                                horizontal-stretch: 1;
                                text: entry.description;
                                color: Theme.fg;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }

                            Text {
                                text: entry.code;
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 4px;
                                background: preview-touch.has-hover ? Theme.accent : transparent;

                                Text {
                                    width: 100%; height: 100%;
                                    text: "\u{2328}";
                                    color: preview-touch.has-hover ? Theme.bg : Theme.fg_dim;
                                    font-size: Typography.heading;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                preview-touch := TouchArea {
                                    clicked => { root.preview-layout(idx); }
                                }
                            }

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 4px;
                                background: remove-touch.has-hover ? Theme.danger : transparent;
                                visible: root.active-layouts.length > 1 && entry.code != "us";

                                Text {
                                    width: 100%; height: 100%;
                                    text: "\u{2715}";
                                    color: remove-touch.has-hover ? Theme.bg : Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                remove-touch := TouchArea {
                                    clicked => { root.remove-layout(idx); }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.bg_lighter; }

                HorizontalLayout {
                    height: 20px;
                    Text {
                        text: root.layout-name;
                        color: Theme.fg_dim;
                        font-size: Typography.secondary;
                        vertical-alignment: center;
                    }
                }

                // ── Keyboard rows ──
                Rectangle {
                    border-radius: 6px;
                    border-width: root.highlight-setting == "Keyboard Preview" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Keyboard Preview" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }

                VerticalLayout {
                    spacing: 3px;

                    HorizontalLayout {
                        spacing: 3px;
                        for key in root.row0: KeyCap {
                            base: key.base; english: key.english;
                            w: key.w; is-modifier: key.is-modifier;
                        }
                    }
                    HorizontalLayout {
                        spacing: 3px;
                        for key in root.row1: KeyCap {
                            base: key.base; english: key.english;
                            w: key.w; is-modifier: key.is-modifier;
                        }
                    }
                    HorizontalLayout {
                        spacing: 3px;
                        for key in root.row2: KeyCap {
                            base: key.base; english: key.english;
                            w: key.w; is-modifier: key.is-modifier;
                        }
                    }
                    HorizontalLayout {
                        spacing: 3px;
                        for key in root.row3: KeyCap {
                            base: key.base; english: key.english;
                            w: key.w; is-modifier: key.is-modifier;
                        }
                    }
                    HorizontalLayout {
                        spacing: 3px;
                        for key in root.row4: KeyCap {
                            base: key.base; english: key.english;
                            w: key.w; is-modifier: key.is-modifier;
                        }
                    }
                }
                }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab1-flick.viewport-width;
                    viewport-x <=> tab1-flick.viewport-x;
                    visible-width: tab1-flick.width;
                }

                ScrollIndicator {
                    x: parent.width - 5px;
                    y: 0;
                    height: parent.height;
                    viewport-height: tab1-flick.viewport-height;
                    viewport-y: tab1-flick.viewport-y;
                    visible-height: tab1-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // DICTATION TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 2: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab2-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 10px;

                // ── Installing view ──
                if root.dictation-installing: VerticalLayout {
                    spacing: 12px;

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: root.dictation-install-error
                            ? "Setup Failed"
                            : root.dictation-progress >= 1.0
                                ? "Complete!" : "Setting Up Dictation";
                        color: root.dictation-install-error ? Theme.danger : Theme.fg;
                        font-size: Typography.heading;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    if !root.dictation-install-error: HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;

                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.panel;

                            Rectangle {
                                y: 0;
                                width: parent.width * root.dictation-progress;
                                height: parent.height;
                                border-radius: 3px;
                                background: root.dictation-progress >= 1.0
                                    ? Theme.success : Theme.accent;
                                animate width { duration: 400ms; easing: ease-in-out; }
                            }
                        }
                    }

                    Text {
                        text: root.dictation-progress-text;
                        color: root.dictation-install-error ? Theme.danger : Theme.fg_dim;
                        font-size: Typography.body;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if !root.dictation-install-error && root.dictation-progress < 1.0: Text {
                        text: "Follow any prompts in the terminal window";
                        color: Theme.fg_dim;
                        font-size: Typography.secondary;
                        horizontal-alignment: center;
                    }

                    if root.dictation-progress < 1.0: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 80px;
                            height: Typography.compact-control;
                            border-radius: 4px;
                            background: cancel-install-touch.has-hover
                                ? Theme.bg_lighter : Theme.bg_light;

                            Text {
                                width: 100%; height: 100%;
                                text: root.dictation-install-error ? "Back" : "Cancel";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cancel-install-touch := TouchArea {
                                clicked => { root.cancel-dictation-install(); }
                                mouse-cursor: pointer;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // ── Setup / Reconfigure view ──
                if (!root.dictation-installed || root.dictation-configuring) && !root.dictation-installing: VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: root.dictation-installed ? "Reconfigure Dictation" : "Set Up Dictation";
                        color: Theme.fg;
                        font-size: Typography.heading;
                        font-weight: 600;
                    }

                    if !root.dictation-installed: Text {
                        text: "Local AI speech-to-text using Whisper.\nFully offline -- no cloud services.";
                        color: Theme.fg_dim;
                        font-size: Typography.body;
                        wrap: word-wrap;
                    }

                    // Language picker
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: (root.highlight-setting == "Language Model" || root.highlight-setting == "Dictation" || root.highlight-setting == "Speech to Text" || root.highlight-setting == "Microphone") && root.highlight-blink-on ? 2px : 0px;
                        border-color: (root.highlight-setting == "Language Model" || root.highlight-setting == "Dictation" || root.highlight-setting == "Speech to Text" || root.highlight-setting == "Microphone") && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            Text {
                                text: "Language";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: lang-pick-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;

                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.dictation-selected-lang-name;
                                        color: Theme.fg;
                                        font-size: Typography.body;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.dictation-lang-dropdown-open ? "\u{25B2}" : "\u{25BC}";
                                        color: Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                lang-pick-touch := TouchArea {
                                    clicked => {
                                        root.dictation-lang-dropdown-open = !root.dictation-lang-dropdown-open;
                                        root.dictation-lang-search = "";
                                        root.dictation-lang-highlighted-idx = 0;
                                        if root.dictation-lang-dropdown-open {
                                            dictation-lang-search-input.focus();
                                        }
                                    }
                                    mouse-cursor: pointer;
                                }
                            }

                            if root.dictation-show-also-english: HorizontalLayout {
                                spacing: 6px;
                                height: 24px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 16px;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: root.dictation-also-english ? Theme.accent : Theme.fg_dim;
                                        background: root.dictation-also-english ? Theme.accent : transparent;

                                        Text {
                                            visible: root.dictation-also-english;
                                            text: "\u{2713}";
                                            color: Theme.bg;
                                            font-size: Typography.secondary;
                                            width: 100%;
                                            height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.dictation-also-english = !root.dictation-also-english;
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: "Also detect English";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Model picker
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: (root.highlight-setting == "Whisper" || root.highlight-setting == "Voice Input") && root.highlight-blink-on ? 2px : 0px;
                        border-color: (root.highlight-setting == "Whisper" || root.highlight-setting == "Voice Input") && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;

                            Text {
                                text: "Model";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }

                            for model[idx] in root.dictation-model-list: model-row := Rectangle {
                                property <bool> disabled: model.english-only && !root.dictation-selected-lang-is-english;
                                height: 32px;
                                border-radius: 4px;
                                background: self.disabled
                                    ? transparent
                                    : idx == root.dictation-selected-model-idx
                                        ? Theme.accent.transparentize(70%)
                                        : model-item-touch.has-hover ? Theme.bg_lighter : transparent;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 14px;
                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 7px;
                                            border-width: 1.5px;
                                            border-color: idx == root.dictation-selected-model-idx
                                                ? Theme.accent : Theme.fg_dim;
                                            background: transparent;

                                            Rectangle {
                                                visible: idx == root.dictation-selected-model-idx;
                                                x: 3px;
                                                y: 3px;
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: Theme.accent;
                                            }
                                        }
                                    }

                                    Text {
                                        text: model.label;
                                        color: model-row.disabled ? Theme.fg_dim : Theme.fg;
                                        font-size: Typography.body;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: model.size;
                                        color: Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: model.note;
                                        color: Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                }

                                model-item-touch := TouchArea {
                                    clicked => {
                                        if !parent.disabled {
                                            root.dictation-selected-model-idx = idx;
                                        }
                                    }
                                    mouse-cursor: parent.disabled ? default : pointer;
                                }
                            }
                        }
                    }

                    // Where the selected model comes from, until it's downloaded
                    if root.dictation-selected-model.label != "" && !root.dictation-selected-model.downloaded: Text {
                        text: root.dictation-installed
                            ? root.dictation-selected-model.label + " isn't downloaded yet. Save & Download Model gets it ("
                                + root.dictation-selected-model.size + ") from Hugging Face; needs internet."
                            : "Install Dictation also downloads " + root.dictation-selected-model.label + " ("
                                + root.dictation-selected-model.size + ") from Hugging Face; needs internet.";
                        color: Theme.fg_dim;
                        font-size: Typography.secondary;
                        wrap: word-wrap;
                    }

                    // Action buttons
                    HorizontalLayout {
                        spacing: 8px;

                        if root.dictation-configuring: Rectangle {
                            horizontal-stretch: 1;
                            height: 34px;
                            border-radius: 4px;
                            background: cancel-reconfig-touch.has-hover
                                ? Theme.bg_lighter : Theme.bg_light;

                            Text {
                                width: 100%; height: 100%;
                                text: "Cancel";
                                color: Theme.fg_dim;
                                font-size: Typography.body;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cancel-reconfig-touch := TouchArea {
                                clicked => { root.dictation-configuring = false; }
                                mouse-cursor: pointer;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 34px;
                            border-radius: 6px;
                            background: go-touch.has-hover
                                ? Theme.accent.darker(0.1) : Theme.accent;

                            Text {
                                width: 100%; height: 100%;
                                text: !root.dictation-installed ? "Install Dictation"
                                    : root.dictation-selected-model.downloaded ? "Save" : "Save & Download Model";
                                color: Theme.bg;
                                font-size: Typography.body;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            go-touch := TouchArea {
                                clicked => {
                                    if root.dictation-installed {
                                        root.start-dictation-reconfigure();
                                    } else {
                                        root.start-dictation-install();
                                    }
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }

                // ── Installed status view ──
                if root.dictation-installed && !root.dictation-configuring && !root.dictation-installing: VerticalLayout {
                    spacing: 10px;

                    if root.dictation-config-missing: Rectangle {
                        border-radius: 6px;
                        background: Theme.warning.transparentize(85%);

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            Text {
                                text: "Configuration file missing";
                                color: Theme.warning;
                                font-size: Typography.body;
                                font-weight: 600;
                            }

                            Text {
                                text: "Click Reconfigure to set up language and model.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Model not downloaded (or not loadable): where to get it
                    if root.dictation-model-problem != "": Rectangle {
                        border-radius: 6px;
                        background: Theme.warning.transparentize(85%);

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 10px;

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.dictation-model-problem;
                                    color: Theme.warning;
                                    font-size: Typography.body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }

                                if root.dictation-model-downloadable: Rectangle {
                                    width: download-model-text.preferred-width + 20px;
                                    height: Typography.compact-control;
                                    border-radius: 4px;
                                    background: download-model-touch.has-hover
                                        ? Theme.accent.darker(0.1) : Theme.accent;

                                    download-model-text := Text {
                                        width: 100%; height: 100%;
                                        text: "Download model";
                                        color: Theme.bg;
                                        font-size: Typography.body;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    download-model-touch := TouchArea {
                                        clicked => { root.download-dictation-model(); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }

                            Text {
                                text: root.dictation-model-help;
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        height: Typography.compact-control;
                        spacing: 8px;

                        Text {
                            text: "Dictation";
                            color: Theme.fg;
                            font-size: Typography.heading;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 18px;
                                width: installed-badge-text.preferred-width + 10px;
                                border-radius: 3px;
                                background: Theme.success.transparentize(80%);

                                installed-badge-text := Text {
                                    width: 100%; height: 100%;
                                    text: "Installed";
                                    color: Theme.success;
                                    font-size: Typography.secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 22px;
                                min-width: 70px;
                                border-radius: 11px;
                                background: root.dictation-service-running
                                    ? Theme.success.transparentize(80%)
                                    : Theme.fg_dim.transparentize(80%);

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;

                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: root.dictation-service-running
                                            ? Theme.success : Theme.fg_dim;
                                    }

                                    Text {
                                        text: root.dictation-service-running
                                            ? "Running" : "Stopped";
                                        color: root.dictation-service-running
                                            ? Theme.success : Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // How to use
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.accent.transparentize(90%);

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;

                            Text {
                                text: "Press";
                                color: Theme.fg_dim;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                height: 22px;
                                width: shortcut-text.preferred-width + 12px;
                                border-radius: 4px;
                                background: Theme.bg_lighter;

                                shortcut-text := Text {
                                    width: 100%; height: 100%;
                                    text: "Super + Ctrl + X";
                                    color: Theme.accent;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "to start/stop dictation";
                                color: Theme.fg_dim;
                                font-size: Typography.body;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    // Config info
                    if !root.dictation-config-missing: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: (root.highlight-setting == "Dictation" || root.highlight-setting == "Speech to Text" || root.highlight-setting == "Whisper" || root.highlight-setting == "Voice Input" || root.highlight-setting == "Language Model" || root.highlight-setting == "Microphone") && root.highlight-blink-on ? 2px : 0px;
                        border-color: (root.highlight-setting == "Dictation" || root.highlight-setting == "Speech to Text" || root.highlight-setting == "Whisper" || root.highlight-setting == "Voice Input" || root.highlight-setting == "Language Model" || root.highlight-setting == "Microphone") && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Language"; color: Theme.fg_dim; font-size: Typography.body; vertical-alignment: center; width: 70px; }
                                Text { text: root.dictation-language; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Model"; color: Theme.fg_dim; font-size: Typography.body; vertical-alignment: center; width: 70px; }
                                Text { text: root.dictation-model; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                            }
                        }
                    }

                    // Service stopped hint (starting it can't help while the model is missing)
                    if !root.dictation-service-running && !root.dictation-config-missing && root.dictation-model-problem == "": Rectangle {
                        border-radius: 6px;
                        background: Theme.warning.transparentize(90%);

                        HorizontalLayout {
                            padding: 8px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;

                            Text {
                                text: "Service is stopped.";
                                color: Theme.warning;
                                font-size: Typography.secondary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: start-hint-text.preferred-width + 16px;
                                height: 24px;
                                border-radius: 4px;
                                background: start-hint-touch.has-hover
                                    ? Theme.success : Theme.success.transparentize(70%);

                                start-hint-text := Text {
                                    width: 100%; height: 100%;
                                    text: "Start";
                                    color: start-hint-touch.has-hover ? Theme.bg : Theme.success;
                                    font-size: Typography.secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                start-hint-touch := TouchArea {
                                    clicked => { root.restart-dictation-service(); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    // Action buttons
                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 32px;
                            border-radius: 4px;
                            background: reconfig-touch.has-hover
                                ? Theme.accent : Theme.bg_light;

                            Text {
                                width: 100%; height: 100%;
                                text: "Reconfigure";
                                color: reconfig-touch.has-hover ? Theme.bg : Theme.fg;
                                font-size: Typography.body;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            reconfig-touch := TouchArea {
                                clicked => { root.dictation-configuring = true; }
                                mouse-cursor: pointer;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 32px;
                            border-radius: 4px;
                            background: config-touch.has-hover
                                ? Theme.bg_lighter : Theme.bg_light;

                            Text {
                                width: 100%; height: 100%;
                                text: "Edit Config";
                                color: config-touch.has-hover ? Theme.fg : Theme.fg_dim;
                                font-size: Typography.body;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            config-touch := TouchArea {
                                clicked => { root.open-dictation-config(); }
                                mouse-cursor: pointer;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 32px;
                            border-radius: 4px;
                            background: restart-touch.has-hover
                                ? (root.dictation-service-running
                                    ? Theme.warning : Theme.success)
                                : Theme.bg_light;

                            Text {
                                width: 100%; height: 100%;
                                text: root.dictation-service-running
                                    ? "Restart" : "Start";
                                color: restart-touch.has-hover ? Theme.bg : Theme.fg_dim;
                                font-size: Typography.body;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            restart-touch := TouchArea {
                                clicked => { root.restart-dictation-service(); }
                                mouse-cursor: pointer;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab2-flick.viewport-width;
                    viewport-x <=> tab2-flick.viewport-x;
                    visible-width: tab2-flick.width;
                }

                ScrollIndicator {
                    x: parent.width - 5px;
                    y: 0;
                    height: parent.height;
                    viewport-height: tab2-flick.viewport-height;
                    viewport-y: tab2-flick.viewport-y;
                    visible-height: tab2-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // DISPLAY TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 3: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab3-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                // Packed at the top: cards keep their natural height in tall windows.
                VerticalLayout {
                    alignment: start;
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 10px;

                // Display header with buttons
                HorizontalLayout {
                    height: Typography.compact-control;
                    spacing: 8px;

                    Text {
                        text: "Display";
                        color: Theme.fg;
                        font-size: Typography.heading;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // Identify button
                    Rectangle {
                        height: Typography.compact-control;
                        min-width: disp-identify-layout.preferred-width + 20px;
                        border-radius: 4px;
                        background: disp-identify-touch.has-hover ? Theme.accent : Theme.bg_light;

                        disp-identify-layout := HorizontalLayout {
                            alignment: center;
                            padding-left: 10px;
                            padding-right: 10px;

                            Rectangle {
                                width: 6px;
                                height: parent.height;
                                Text {
                                    text: "I";
                                    color: !disp-identify-touch.enabled ? Theme.fg_dim : disp-identify-touch.has-hover ? Theme.bg : Theme.fg;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                Rectangle {
                                    x: 0px;
                                    y: parent.height / 2 + 7px;
                                    width: parent.width;
                                    height: 1px;
                                    background: !disp-identify-touch.enabled ? Theme.fg_dim : disp-identify-touch.has-hover ? Theme.bg : Theme.fg;
                                }
                            }
                            Text {
                                text: "dentify";
                                color: !disp-identify-touch.enabled ? Theme.fg_dim : disp-identify-touch.has-hover ? Theme.bg : Theme.fg;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }
                        }

                        disp-identify-touch := TouchArea {
                            enabled: root.disp-available && root.disp-monitors.length > 0 && !root.disp-busy;
                            clicked => { root.disp-identify-monitors(); }
                            mouse-cursor: self.enabled ? pointer : default;
                        }
                    }

                    // Refresh button
                    Rectangle {
                        height: Typography.compact-control;
                        min-width: disp-refresh-layout.preferred-width + 20px;
                        border-radius: 4px;
                        background: disp-refresh-touch.has-hover ? Theme.accent : Theme.bg_light;

                        disp-refresh-layout := HorizontalLayout {
                            alignment: center;
                            padding-left: 10px;
                            padding-right: 10px;

                            Rectangle {
                                width: 9px;
                                height: parent.height;
                                Text {
                                    text: "R";
                                    color: !disp-refresh-touch.enabled ? Theme.fg_dim : disp-refresh-touch.has-hover ? Theme.bg : Theme.fg;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                Rectangle {
                                    x: 1px;
                                    y: parent.height / 2 + 7px;
                                    width: 7px;
                                    height: 1px;
                                    background: !disp-refresh-touch.enabled ? Theme.fg_dim : disp-refresh-touch.has-hover ? Theme.bg : Theme.fg;
                                }
                            }
                            Text {
                                text: "efresh";
                                color: !disp-refresh-touch.enabled ? Theme.fg_dim : disp-refresh-touch.has-hover ? Theme.bg : Theme.fg;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }
                        }

                        disp-refresh-touch := TouchArea {
                            enabled: !root.disp-busy;
                            clicked => { root.disp-refresh-monitors(); }
                            mouse-cursor: self.enabled ? pointer : default;
                        }
                    }
                }

                // ── Unavailable: say why instead of showing invented displays ──
                if !root.disp-available: Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;

                        Text {
                            text: "Display settings are unavailable";
                            color: Theme.fg;
                            font-size: Typography.body;
                            font-weight: 600;
                        }

                        Text {
                            text: root.disp-unavailable-reason;
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                // ── Monitor Canvas card ──
                if root.disp-available: Rectangle {
                    background: Theme.bg.darker(0.3).transparentize(88%);
                    border-radius: 6px;
                    border-width: (root.highlight-setting == "Display" || root.highlight-setting == "Monitor" || root.highlight-setting == "Screen Layout") && root.highlight-blink-on ? 2px : 1px;
                    border-color: (root.highlight-setting == "Display" || root.highlight-setting == "Monitor" || root.highlight-setting == "Screen Layout") && root.highlight-blink-on ? Theme.accent : Theme.bg_lighter;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }
                    height: 200px;

                    if root.disp-monitors.length == 0: Text {
                        text: root.disp-busy ? "Reading displays…" : "No displays to show";
                        color: Theme.fg_dim;
                        font-size: Typography.heading;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    for mon[i] in root.disp-monitors: MonitorRect {
                        width: mon.canvas-w * 1px;
                        height: mon.canvas-h * 1px;
                        base-x: mon.canvas-x;
                        base-y: mon.canvas-y;
                        canvas-max-x: parent.width / 1px - mon.canvas-w;
                        canvas-max-y: parent.height / 1px - mon.canvas-h;
                        label: mon.name;
                        sublabel: mon.size-label;
                        sublabel-two-line: mon.size-label-two-line;
                        selected: i == root.disp-selected-index;
                        is-primary: mon.is-primary;
                        interactive: !root.disp-busy;

                        clicked => {
                            root.disp-selected-index = i;
                            root.disp-select-monitor(i);
                        }

                        dragging-changed(d) => {
                            root.disp-dragging = d;
                        }

                        press-changed(p) => {
                            root.disp-dragging = p;
                        }

                        drag-finished(cx, cy) => {
                            root.disp-selected-index = i;
                            root.disp-drag-finished(i, cx, cy);
                        }
                    }
                }

                // ── The live configuration changed while edits were pending ──
                if root.disp-stale: Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.warning;

                    VerticalLayout {
                        padding: 10px;

                        Text {
                            text: "Displays changed since you started editing. Refresh to load the active layout, or Revert to discard your changes.";
                            color: Theme.warning;
                            font-size: Typography.secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                // ── Saved settings differ from what is active ──
                if root.disp-drift-text != "": Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.warning;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Text {
                            text: root.disp-drift-text;
                            color: Theme.warning;
                            font-size: Typography.secondary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            if root.disp-has-changes: Text {
                                text: "Apply or Revert your changes first.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                vertical-alignment: center;
                            }

                            // Use saved: reload monitors.conf as saved
                            Rectangle {
                                height: Typography.compact-control;
                                min-width: disp-use-saved-layout.preferred-width + 20px;
                                border-radius: 4px;
                                background: !root.disp-drift-actionable ? Theme.bg_light.darker(0.2)
                                    : disp-use-saved-touch.has-hover ? Theme.accent : Theme.bg_light;

                                disp-use-saved-layout := HorizontalLayout {
                                    alignment: center;
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    Text {
                                        text: "Use saved";
                                        color: !root.disp-drift-actionable ? Theme.fg_dim.darker(0.3)
                                            : disp-use-saved-touch.has-hover ? Theme.bg : Theme.fg;
                                        font-size: Typography.body;
                                        vertical-alignment: center;
                                    }
                                }

                                disp-use-saved-touch := TouchArea {
                                    enabled: root.disp-drift-actionable;
                                    mouse-cursor: root.disp-drift-actionable ? pointer : default;
                                    clicked => { root.disp-use-saved(); }
                                }
                            }

                            // Keep current: save the active layout
                            Rectangle {
                                height: Typography.compact-control;
                                min-width: disp-keep-current-layout.preferred-width + 20px;
                                border-radius: 4px;
                                background: !root.disp-drift-actionable ? Theme.bg_light.darker(0.2)
                                    : disp-keep-current-touch.has-hover ? Theme.success : Theme.bg_light;

                                disp-keep-current-layout := HorizontalLayout {
                                    alignment: center;
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    Text {
                                        text: "Keep current";
                                        color: !root.disp-drift-actionable ? Theme.fg_dim.darker(0.3)
                                            : disp-keep-current-touch.has-hover ? Theme.bg : Theme.fg;
                                        font-size: Typography.body;
                                        vertical-alignment: center;
                                    }
                                }

                                disp-keep-current-touch := TouchArea {
                                    enabled: root.disp-drift-actionable;
                                    mouse-cursor: root.disp-drift-actionable ? pointer : default;
                                    clicked => { root.disp-keep-current(); }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                // ── Monitor settings cards (shown when a monitor is selected) ──
                // Every control reads the selected row through the derived
                // disp-selected-* properties and only emits change requests.
                if root.disp-available && root.disp-selection-valid: VerticalLayout {
                    spacing: 10px;

                    // Monitor name header
                    Text {
                        text: "Monitor: " + root.disp-monitors[root.disp-selected-index].name + "  \u{2014}  " + root.disp-monitors[root.disp-selected-index].description;
                        color: Theme.fg_dim;
                        font-size: Typography.secondary;
                        overflow: elide;
                    }

                    // ── Resolution & Refresh Rate card ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: (root.highlight-setting == "Resolution" || root.highlight-setting == "Refresh Rate") && root.highlight-blink-on ? 2px : 0px;
                        border-color: (root.highlight-setting == "Resolution" || root.highlight-setting == "Refresh Rate") && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        VerticalLayout {
                            padding: 10px;

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Resolution";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    width: 90px;
                                }

                                ResDropdown {
                                    model: root.disp-selected-modes;
                                    current-index: root.disp-selected-mode-index;
                                    enabled: !root.disp-busy;
                                    selected(idx) => {
                                        root.disp-change-resolution(root.disp-selected-index, idx);
                                    }
                                }
                            }
                        }
                    }

                    // ── Scale card ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: root.highlight-setting == "Scale" && root.highlight-blink-on ? 2px : 0px;
                        border-color: root.highlight-setting == "Scale" && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        VerticalLayout {
                            padding: 10px;

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Scale: " + round(root.disp-selected-scale * 100) / 100;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    width: 90px;
                                }

                                // Rust snaps each request to a scale Hyprland keeps for this mode.
                                ThemeSlider {
                                    value: root.disp-selected-scale;
                                    minimum: 0.5;
                                    maximum: 3.0;
                                    enabled: !root.disp-busy;
                                    changed(v) => {
                                        root.disp-change-scale(root.disp-selected-index, v);
                                    }
                                }
                            }
                        }
                    }

                    // ── Orientation card ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: root.highlight-setting == "Orientation" && root.highlight-blink-on ? 2px : 0px;
                        border-color: root.highlight-setting == "Orientation" && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        VerticalLayout {
                            padding: 10px;

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Orientation";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    width: 90px;
                                }

                                ResDropdown {
                                    model: root.disp-selected-orientations;
                                    current-index: root.disp-selected-orientation;
                                    enabled: !root.disp-busy;
                                    selected(idx) => {
                                        root.disp-change-orientation(root.disp-selected-index, idx);
                                    }
                                }
                            }
                        }
                    }

                    // ── Primary Monitor card: the display showing workspace 1 ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: root.highlight-setting == "Primary Monitor" && root.highlight-blink-on ? 2px : 0px;
                        border-color: root.highlight-setting == "Primary Monitor" && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                alignment: center;

                                Text {
                                    text: "Primary Monitor";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                }

                                Text {
                                    text: root.disp-workspace-policy
                                        ? "Workspace placement follows the display arrangement. Change it in Taskbar settings."
                                        : root.disp-monitors[root.disp-selected-index].is-primary
                                            ? "Workspace 1 is on this display."
                                            : root.disp-primary-name != ""
                                                ? "Workspace 1 is on " + root.disp-primary-name + ". Moving it takes effect now and is not saved."
                                                : "Workspace 1 is not open on any display.";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                            }

                            if !root.disp-workspace-policy: VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    height: Typography.compact-control;
                                    min-width: disp-primary-layout.preferred-width + 20px;
                                    border-radius: 4px;
                                    background: !root.disp-primary-movable
                                        ? Theme.bg_light.darker(0.2)
                                        : disp-primary-touch.has-hover ? Theme.accent : Theme.bg_lighter;

                                    disp-primary-layout := HorizontalLayout {
                                        alignment: center;
                                        padding-left: 10px;
                                        padding-right: 10px;

                                        Text {
                                            text: "Move workspace 1 here";
                                            color: !root.disp-primary-movable
                                                ? Theme.fg_dim.darker(0.3)
                                                : disp-primary-touch.has-hover ? Theme.bg : Theme.fg;
                                            font-size: Typography.body;
                                            vertical-alignment: center;
                                        }
                                    }

                                    disp-primary-touch := TouchArea {
                                        enabled: root.disp-primary-movable;
                                        mouse-cursor: root.disp-primary-movable ? pointer : default;
                                        clicked => {
                                            root.disp-set-primary(root.disp-selected-index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }

                // Status and actions scroll with the cards so they remain reachable at minimum height.
                if root.disp-status-text != "": Text {
                    text: root.disp-status-text;
                    color: root.disp-status-warning ? Theme.warning : Theme.fg_dim;
                    font-size: Typography.secondary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    height: Typography.compact-control;
                    spacing: 8px;
                    alignment: end;

                    // Revert
                    Rectangle {
                        height: Typography.compact-control;
                        min-width: disp-revert-layout.preferred-width + 20px;
                        border-radius: 4px;
                        background: !root.disp-can-revert
                            ? Theme.bg_light.darker(0.2)
                            : disp-revert-touch.has-hover ? Theme.warning : Theme.bg_light;

                        disp-revert-layout := HorizontalLayout {
                            alignment: center;
                            padding-left: 10px;
                            padding-right: 10px;

                            Text {
                                text: "Re";
                                color: !root.disp-can-revert ? Theme.fg_dim.darker(0.3)
                                    : disp-revert-touch.has-hover ? Theme.bg : Theme.fg;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 8px;
                                height: parent.height;
                                Text {
                                    text: "v";
                                    color: !root.disp-can-revert ? Theme.fg_dim.darker(0.3)
                                        : disp-revert-touch.has-hover ? Theme.bg : Theme.fg;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                Rectangle {
                                    x: 0px;
                                    y: parent.height / 2 + 7px;
                                    width: parent.width;
                                    height: 1px;
                                    background: !root.disp-can-revert ? Theme.fg_dim.darker(0.3)
                                        : disp-revert-touch.has-hover ? Theme.bg : Theme.fg;
                                }
                            }

                            Text {
                                text: "ert";
                                color: !root.disp-can-revert ? Theme.fg_dim.darker(0.3)
                                    : disp-revert-touch.has-hover ? Theme.bg : Theme.fg;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }
                        }

                        disp-revert-touch := TouchArea {
                            enabled: root.disp-can-revert;
                            mouse-cursor: root.disp-can-revert ? pointer : default;
                            clicked => { root.disp-revert-changes(); }
                        }
                    }

                    // Apply: write monitors.conf, reload Hyprland, verify the result
                    Rectangle {
                        height: Typography.compact-control;
                        min-width: disp-apply-layout.preferred-width + 20px;
                        border-radius: 4px;
                        background: !root.disp-can-apply
                            ? Theme.bg_light.darker(0.2)
                            : disp-apply-touch.has-hover ? Theme.success : Theme.bg_light;

                        disp-apply-layout := HorizontalLayout {
                            alignment: center;
                            padding-left: 10px;
                            padding-right: 10px;

                            Rectangle {
                                width: 9px;
                                height: parent.height;
                                Text {
                                    text: "A";
                                    color: !root.disp-can-apply ? Theme.fg_dim.darker(0.3)
                                        : disp-apply-touch.has-hover ? Theme.bg : Theme.fg;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                Rectangle {
                                    x: 1px;
                                    y: parent.height / 2 + 7px;
                                    width: 7px;
                                    height: 1px;
                                    background: !root.disp-can-apply ? Theme.fg_dim.darker(0.3)
                                        : disp-apply-touch.has-hover ? Theme.bg : Theme.fg;
                                }
                            }

                            Text {
                                text: "pply";
                                color: !root.disp-can-apply ? Theme.fg_dim.darker(0.3)
                                    : disp-apply-touch.has-hover ? Theme.bg : Theme.fg;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }
                        }

                        disp-apply-touch := TouchArea {
                            enabled: root.disp-can-apply;
                            mouse-cursor: root.disp-can-apply ? pointer : default;
                            clicked => { root.disp-apply-changes(); }
                        }
                    }
                }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab3-flick.viewport-width;
                    viewport-x <=> tab3-flick.viewport-x;
                    visible-width: tab3-flick.width;
                }

                ScrollIndicator {
                    x: parent.width - 5px;
                    y: 0;
                    height: parent.height;
                    viewport-height: tab3-flick.viewport-height;
                    viewport-y: tab3-flick.viewport-y;
                    visible-height: tab3-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // POWER TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 4: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab4-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 12px;

                Text {
                    text: "Power";
                    color: Theme.fg;
                    font-size: Typography.heading;
                    font-weight: 600;
                }

                // ── Power Profile card ──
                if root.power-config-status != "": Text {
                    text: root.power-config-status;
                    color: Theme.fg_dim;
                    font-size: Typography.secondary;
                    wrap: word-wrap;
                }
                if root.power-runtime-status != "": Text {
                    text: root.power-runtime-status;
                    color: Theme.fg_dim;
                    font-size: Typography.secondary;
                    wrap: word-wrap;
                }
                if root.power-action-status != "": Text {
                    text: root.power-action-status;
                    color: Theme.fg;
                    font-size: Typography.secondary;
                    wrap: word-wrap;
                }
                if root.power-busy: Text {
                    text: "Saving...";
                    color: Theme.fg_dim;
                    font-size: Typography.secondary;
                    wrap: word-wrap;
                }
                if root.power-profile-status != "": Text {
                    text: root.power-profile-status;
                    color: Theme.fg_dim;
                    font-size: Typography.secondary;
                    wrap: word-wrap;
                }
                if root.power-profiles-available: Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Power Profile" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Power Profile" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Power Profile";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        // Power saver
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.power-profile-index == 0
                                ? Theme.accent.transparentize(70%)
                                : power-saver-touch.has-hover ? Theme.bg_lighter : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px;
                                        border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.power-profile-index == 0 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.power-profile-index == 0;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Power Saver"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Maximize battery life"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }

                            power-saver-touch := TouchArea {
                                clicked => {
                                    root.set-power-profile(0);
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Balanced
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.power-profile-index == 1
                                ? Theme.accent.transparentize(70%)
                                : power-balanced-touch.has-hover ? Theme.bg_lighter : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px;
                                        border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.power-profile-index == 1 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.power-profile-index == 1;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Balanced"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Default performance and battery"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }

                            power-balanced-touch := TouchArea {
                                clicked => {
                                    root.set-power-profile(1);
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Performance
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.power-profile-index == 2
                                ? Theme.accent.transparentize(70%)
                                : power-perf-touch.has-hover ? Theme.bg_lighter : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px;
                                        border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.power-profile-index == 2 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.power-profile-index == 2;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Performance"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Maximum performance, higher power use"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }

                            power-perf-touch := TouchArea {
                                clicked => {
                                    root.set-power-profile(2);
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }

                // ── Lock Screen Timeout card ──
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Lock Screen Timeout" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Lock Screen Timeout" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Lock screen after";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 4px;

                            for preset[idx] in ["1 min", "5 min", "10 min", "30 min", "Never"]: Rectangle {
                                height: Typography.compact-control;
                                min-width: 50px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: root.idle-lock-index == idx
                                    ? Theme.accent
                                    : lock-chip-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: preset;
                                        color: root.idle-lock-index == idx ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                lock-chip-touch := TouchArea {
                                    enabled: root.idle-available;
                                    clicked => {
                                        root.set-idle-lock(idx);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }

                            // Custom dropdown
                            Rectangle {
                                height: Typography.compact-control;
                                min-width: 56px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: root.idle-available && (root.idle-lock-index >= 5 || root.idle-lock-index == -1)
                                    ? Theme.accent
                                    : lock-custom-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: root.idle-lock-index == -1 ? root.idle-lock-custom-label
                                            : root.idle-lock-index == 5 ? "1h"
                                            : root.idle-lock-index == 6 ? "2h"
                                            : root.idle-lock-index == 7 ? "3h"
                                            : root.idle-lock-index == 8 ? "5h"
                                            : root.idle-lock-index == 9 ? "8h"
                                            : "Custom";
                                        color: root.idle-available && (root.idle-lock-index >= 5 || root.idle-lock-index == -1) ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                lock-custom-touch := TouchArea {
                                    enabled: root.idle-available;
                                    clicked => {
                                        root.set-idle-lock(root.idle-lock-index >= 5 ?
                                            (root.idle-lock-index >= 9 ? 5 : root.idle-lock-index + 1) : 5);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                // ── Screen Off Timeout card ──
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Screen Off Timeout" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Screen Off Timeout" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }
                    private property <string> _hl: root.highlight-setting;
                    init => { if _hl == "Screen Off Timeout" { tab4-flick.viewport-y = -max(0px, self.y - 20px); } }
                    changed _hl => { if _hl == "Screen Off Timeout" { tab4-flick.viewport-y = -max(0px, self.y - 20px); } }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Turn off screen after";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 4px;

                            for preset[idx] in ["1 min", "5 min", "10 min", "30 min", "Never"]: Rectangle {
                                height: Typography.compact-control;
                                min-width: 50px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: root.idle-dpms-index == idx
                                    ? Theme.accent
                                    : dpms-chip-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: preset;
                                        color: root.idle-dpms-index == idx ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                dpms-chip-touch := TouchArea {
                                    enabled: root.idle-available;
                                    clicked => {
                                        root.set-idle-dpms(idx);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }

                            // Custom dropdown
                            Rectangle {
                                height: Typography.compact-control;
                                min-width: 56px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: root.idle-available && (root.idle-dpms-index >= 5 || root.idle-dpms-index == -1)
                                    ? Theme.accent
                                    : dpms-custom-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: root.idle-dpms-index == -1 ? root.idle-dpms-custom-label
                                            : root.idle-dpms-index == 5 ? "1h"
                                            : root.idle-dpms-index == 6 ? "2h"
                                            : root.idle-dpms-index == 7 ? "3h"
                                            : root.idle-dpms-index == 8 ? "5h"
                                            : root.idle-dpms-index == 9 ? "8h"
                                            : "Custom";
                                        color: root.idle-available && (root.idle-dpms-index >= 5 || root.idle-dpms-index == -1) ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                dpms-custom-touch := TouchArea {
                                    enabled: root.idle-available;
                                    clicked => {
                                        root.set-idle-dpms(root.idle-dpms-index >= 5 ?
                                            (root.idle-dpms-index >= 9 ? 5 : root.idle-dpms-index + 1) : 5);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                // ── Suspend Timeout card ──
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Suspend Timeout" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Suspend Timeout" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }
                    private property <string> _hl: root.highlight-setting;
                    init => { if _hl == "Suspend Timeout" { tab4-flick.viewport-y = -max(0px, self.y - 20px); } }
                    changed _hl => { if _hl == "Suspend Timeout" { tab4-flick.viewport-y = -max(0px, self.y - 20px); } }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Suspend after";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 4px;

                            for preset[idx] in ["1 min", "5 min", "10 min", "30 min", "Never"]: Rectangle {
                                height: Typography.compact-control;
                                min-width: 50px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: root.idle-suspend-index == idx
                                    ? Theme.accent
                                    : susp-chip-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: preset;
                                        color: root.idle-suspend-index == idx ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                susp-chip-touch := TouchArea {
                                    enabled: root.idle-available;
                                    clicked => {
                                        root.set-idle-suspend(idx);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }

                            // Custom dropdown
                            Rectangle {
                                height: Typography.compact-control;
                                min-width: 56px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: root.idle-available && (root.idle-suspend-index >= 5 || root.idle-suspend-index == -1)
                                    ? Theme.accent
                                    : susp-custom-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: root.idle-suspend-index == -1 ? root.idle-suspend-custom-label
                                            : root.idle-suspend-index == 5 ? "1h"
                                            : root.idle-suspend-index == 6 ? "2h"
                                            : root.idle-suspend-index == 7 ? "3h"
                                            : root.idle-suspend-index == 8 ? "5h"
                                            : root.idle-suspend-index == 9 ? "8h"
                                            : "Custom";
                                        color: root.idle-available && (root.idle-suspend-index >= 5 || root.idle-suspend-index == -1) ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                susp-custom-touch := TouchArea {
                                    enabled: root.idle-available;
                                    clicked => {
                                        root.set-idle-suspend(root.idle-suspend-index >= 5 ?
                                            (root.idle-suspend-index >= 9 ? 5 : root.idle-suspend-index + 1) : 5);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                // ── Shutdown After card ──
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Shutdown After" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Shutdown After" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }
                    private property <string> _hl: root.highlight-setting;
                    init => { if _hl == "Shutdown After" { tab4-flick.viewport-y = -max(0px, self.y - 20px); } }
                    changed _hl => { if _hl == "Shutdown After" { tab4-flick.viewport-y = -max(0px, self.y - 20px); } }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Shutdown after";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 4px;

                            for preset[idx] in ["1 min", "5 min", "10 min", "30 min", "Never"]: Rectangle {
                                height: Typography.compact-control;
                                min-width: 50px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: root.idle-shutdown-index == idx
                                    ? Theme.accent
                                    : shutdown-chip-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: preset;
                                        color: root.idle-shutdown-index == idx ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                shutdown-chip-touch := TouchArea {
                                    enabled: root.idle-available;
                                    clicked => {
                                        root.set-idle-shutdown(idx);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }

                            // Custom dropdown
                            Rectangle {
                                height: Typography.compact-control;
                                min-width: 56px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: root.idle-available && (root.idle-shutdown-index >= 5 || root.idle-shutdown-index == -1)
                                    ? Theme.accent
                                    : shutdown-custom-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: root.idle-shutdown-index == -1 ? root.idle-shutdown-custom-label
                                            : root.idle-shutdown-index == 5 ? "1h"
                                            : root.idle-shutdown-index == 6 ? "2h"
                                            : root.idle-shutdown-index == 7 ? "3h"
                                            : root.idle-shutdown-index == 8 ? "5h"
                                            : root.idle-shutdown-index == 9 ? "8h"
                                            : "Custom";
                                        color: root.idle-available && (root.idle-shutdown-index >= 5 || root.idle-shutdown-index == -1) ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                shutdown-custom-touch := TouchArea {
                                    enabled: root.idle-available;
                                    clicked => {
                                        root.set-idle-shutdown(root.idle-shutdown-index >= 5 ?
                                            (root.idle-shutdown-index >= 9 ? 5 : root.idle-shutdown-index + 1) : 5);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab4-flick.viewport-width;
                    viewport-x <=> tab4-flick.viewport-x;
                    visible-width: tab4-flick.width;
                }

                ScrollIndicator {
                    x: parent.width - 5px;
                    y: 0;
                    height: parent.height;
                    viewport-height: tab4-flick.viewport-height;
                    viewport-y: tab4-flick.viewport-y;
                    visible-height: tab4-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // KEYBINDINGS TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 5: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab5-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 8px;

                // Header row: title + filter + section picker
                HorizontalLayout {
                    height: Typography.compact-control;
                    spacing: 8px;

                    Text {
                        text: "Keybindings";
                        color: Theme.fg;
                        font-size: Typography.heading;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: Typography.compact-control;
                        border-radius: 4px;
                        background: Theme.panel;

                        kb-filter-input := TextInput {
                            x: 8px;
                            y: 0px;
                            width: parent.width - 16px;
                            height: parent.height;
                            color: Theme.fg;
                            font-size: Typography.body;
                            text <=> root.kb-filter-text;
                            edited => {
                                root.kb-filter(self.text, root.kb-selected-section);
                            }
                        }

                        Text {
                            visible: root.kb-filter-text == "";
                            x: 8px;
                            y: 0px;
                            height: parent.height;
                            text: "Filter keybindings...";
                            color: Theme.fg_dim;
                            font-size: Typography.body;
                            vertical-alignment: center;
                        }
                    }
                }

                // Section tabs (chip bar)
                HorizontalLayout {
                    height: Typography.compact-control;
                    spacing: 4px;

                    for sec[idx] in root.kb-sections: Rectangle {
                        height: 24px;
                        min-width: kb-sec-text.preferred-width + 16px;
                        border-radius: 12px;
                        background: root.kb-selected-section == idx
                            ? Theme.accent
                            : kb-sec-touch.has-hover ? Theme.bg_lighter : Theme.bg_light;

                        kb-sec-text := Text {
                            text: sec;
                            color: root.kb-selected-section == idx ? Theme.bg : Theme.fg;
                            font-size: Typography.secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                        }

                        kb-sec-touch := TouchArea {
                            clicked => {
                                root.kb-selected-section = idx;
                                root.kb-filter(root.kb-filter-text, idx);
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }

                // Binding list
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: (root.highlight-setting == "Keybindings" || root.highlight-setting == "Keyboard Shortcuts" || root.highlight-setting == "Hotkeys" || root.highlight-setting == "Shortcut") && root.highlight-blink-on ? 2px : 0px;
                    border-color: (root.highlight-setting == "Keybindings" || root.highlight-setting == "Keyboard Shortcuts" || root.highlight-setting == "Hotkeys" || root.highlight-setting == "Shortcut") && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }
                    clip: true;

                    Flickable {
                        width: parent.width;
                        height: parent.height;

                        VerticalLayout {
                            spacing: 1px;
                            padding: 4px;

                            for entry[idx] in root.kb-bindings: Rectangle {
                                height: root.kb-edit-idx == entry.idx ? 96px : Typography.row;
                                border-radius: 4px;
                                background: root.kb-edit-idx == entry.idx
                                    ? Theme.bg.transparentize(50%)
                                    : kb-row-touch.has-hover ? Theme.bg_lighter.transparentize(60%) : transparent;
                                clip: true;

                                // Normal view
                                if root.kb-edit-idx != entry.idx: HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    height: Typography.row;

                                    // Key combo badge — click to rebind directly
                                    Rectangle {
                                        width: 180px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: root.kb-capturing && root.kb-capture-idx == entry.idx
                                            ? Theme.warning.transparentize(50%)
                                            : kb-combo-touch.has-hover ? Theme.accent.transparentize(70%) : Theme.bg;

                                        Text {
                                            text: root.kb-capturing && root.kb-capture-idx == entry.idx
                                                ? "Press keys..."
                                                : entry.combo;
                                            color: root.kb-capturing && root.kb-capture-idx == entry.idx
                                                ? Theme.bg : Theme.accent;
                                            font-size: Typography.secondary;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                            overflow: elide;
                                        }

                                        kb-combo-touch := TouchArea {
                                            clicked => {
                                                root.kb-capture-idx = entry.idx;
                                                root.kb-capturing = true;
                                                root.kb-edit-combo(entry.idx);
                                            }
                                            mouse-cursor: pointer;
                                        }

                                        y: 5px;
                                    }

                                    // Description
                                    Text {
                                        horizontal-stretch: 1;
                                        text: entry.description;
                                        color: Theme.fg;
                                        font-size: Typography.body;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    // Submap tag
                                    if entry.submap != "": Rectangle {
                                        width: 60px;
                                        height: 18px;
                                        border-radius: 3px;
                                        background: Theme.warning.transparentize(70%);
                                        y: 8px;

                                        Text {
                                            text: entry.submap;
                                            color: Theme.warning;
                                            font-size: Typography.caption;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }

                                    // Edit button (expand for args/delete)
                                    Rectangle {
                                        width: 28px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: kb-edit-touch.has-hover ? Theme.bg_lighter : transparent;
                                        y: 5px;

                                        Text {
                                            text: "\u{270E}";
                                            color: Theme.fg_dim;
                                            font-size: Typography.body;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }

                                        kb-edit-touch := TouchArea {
                                            clicked => { root.kb-edit-idx = entry.idx; }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }

                                // Edit view
                                if root.kb-edit-idx == entry.idx: VerticalLayout {
                                    padding: 6px;
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: Typography.compact-control;

                                        // Rebind button
                                        Rectangle {
                                            width: 160px;
                                            height: Typography.compact-control;
                                            border-radius: 4px;
                                            background: root.kb-capturing
                                                ? Theme.warning.transparentize(50%)
                                                : kb-rebind-touch.has-hover ? Theme.accent : Theme.bg;

                                            Text {
                                                text: root.kb-capturing
                                                    ? (root.kb-capture-combo != "" ? root.kb-capture-combo : "Press keys...")
                                                    : entry.combo;
                                                color: root.kb-capturing ? Theme.bg : Theme.accent;
                                                font-size: Typography.secondary;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                width: parent.width;
                                                height: parent.height;
                                            }

                                            kb-rebind-touch := TouchArea {
                                                clicked => {
                                                    root.kb-capture-idx = entry.idx;
                                                    root.kb-capturing = true;
                                                    root.kb-edit-combo(entry.idx);
                                                }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        Text {
                                            text: entry.description;
                                            color: Theme.fg;
                                            font-size: Typography.body;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: Typography.compact-control;

                                        // Command field (for exec bindings)
                                        if entry.is-exec: Rectangle {
                                            horizontal-stretch: 1;
                                            height: Typography.compact-control;
                                            border-radius: 4px;
                                            background: Theme.bg;

                                            kb-args-input := TextInput {
                                                x: 8px;
                                                y: 5px;
                                                width: parent.width - 16px;
                                                height: parent.height;
                                                color: Theme.fg;
                                                font-size: Typography.secondary;
                                                text: entry.args;
                                                accepted => {
                                                    root.kb-edit-args(entry.idx, self.text);
                                                }
                                            }
                                        }

                                        if !entry.is-exec: Text {
                                            horizontal-stretch: 1;
                                            text: entry.dispatcher + " " + entry.args;
                                            color: Theme.fg_dim;
                                            font-size: Typography.secondary;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        // Delete button
                                        Rectangle {
                                            width: 60px;
                                            height: Typography.compact-control;
                                            border-radius: 4px;
                                            background: kb-del-touch.has-hover ? Theme.danger : Theme.bg;

                                            Text {
                                                text: "Delete";
                                                color: kb-del-touch.has-hover ? white : Theme.danger;
                                                font-size: Typography.secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                width: parent.width;
                                                height: parent.height;
                                            }

                                            kb-del-touch := TouchArea {
                                                clicked => {
                                                    root.kb-edit-idx = -1;
                                                    root.kb-remove(entry.idx);
                                                }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        // Done button
                                        Rectangle {
                                            width: 50px;
                                            height: Typography.compact-control;
                                            border-radius: 4px;
                                            background: kb-done-touch.has-hover ? Theme.success : Theme.bg;

                                            Text {
                                                text: "Done";
                                                color: kb-done-touch.has-hover ? Theme.bg : Theme.success;
                                                font-size: Typography.secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                width: parent.width;
                                                height: parent.height;
                                            }

                                            kb-done-touch := TouchArea {
                                                clicked => { root.kb-edit-idx = -1; }
                                                mouse-cursor: pointer;
                                            }
                                        }
                                    }
                                }

                                kb-row-touch := TouchArea {
                                    // Only handle clicks in normal mode
                                    enabled: root.kb-edit-idx != entry.idx;
                                }
                            }

                            if root.kb-bindings.length == 0: Text {
                                text: "No keybindings found. Check that bindings.conf exists.";
                                color: Theme.fg_dim;
                                font-size: Typography.body;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // Add new binding row
                if root.kb-adding: Rectangle {
                    height: 70px;
                    border-radius: 6px;
                    background: Theme.panel;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 8px;
                            height: Typography.compact-control;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: Typography.compact-control;
                                border-radius: 4px;
                                background: Theme.bg;

                                TextInput {
                                    x: 8px;
                                    y: 5px;
                                    width: parent.width - 16px;
                                    height: parent.height;
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    text <=> root.kb-new-desc;
                                    input-type: text;
                                }

                                Text {
                                    visible: root.kb-new-desc == "";
                                    x: 8px;
                                    y: 5px;
                                    height: parent.height;
                                    text: "Description (e.g. Launch Firefox)";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            height: Typography.compact-control;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: Typography.compact-control;
                                border-radius: 4px;
                                background: Theme.bg;

                                TextInput {
                                    x: 8px;
                                    y: 5px;
                                    width: parent.width - 16px;
                                    height: parent.height;
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    text <=> root.kb-new-cmd;
                                    input-type: text;
                                }

                                Text {
                                    visible: root.kb-new-cmd == "";
                                    x: 8px;
                                    y: 5px;
                                    height: parent.height;
                                    text: "Command (e.g. firefox)";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 50px;
                                height: Typography.compact-control;
                                border-radius: 4px;
                                background: kb-add-ok-touch.has-hover ? Theme.success : Theme.bg_lighter;

                                Text {
                                    text: "Add";
                                    color: kb-add-ok-touch.has-hover ? Theme.bg : Theme.fg;
                                    font-size: Typography.secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }

                                kb-add-ok-touch := TouchArea {
                                    clicked => {
                                        if root.kb-new-desc != "" && root.kb-new-cmd != "" {
                                            root.kb-add(root.kb-new-desc, root.kb-new-cmd);
                                            root.kb-new-desc = "";
                                            root.kb-new-cmd = "";
                                            root.kb-adding = false;
                                        }
                                    }
                                    mouse-cursor: pointer;
                                }
                            }

                            Rectangle {
                                width: 60px;
                                height: Typography.compact-control;
                                border-radius: 4px;
                                background: kb-add-cancel-touch.has-hover ? Theme.bg_lighter : transparent;

                                Text {
                                    text: "Cancel";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }

                                kb-add-cancel-touch := TouchArea {
                                    clicked => { root.kb-adding = false; }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                // Footer: status + action buttons
                HorizontalLayout {
                    height: Typography.compact-control;
                    spacing: 6px;

                    Text {
                        text: root.kb-status-text;
                        color: Theme.fg_dim;
                        font-size: Typography.secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // Add binding
                    Rectangle {
                        height: Typography.compact-control;
                        min-width: 80px;
                        border-radius: 4px;
                        background: kb-add-btn-touch.has-hover ? Theme.accent : Theme.bg_light;

                        Text {
                            text: "+ Add";
                            color: kb-add-btn-touch.has-hover ? Theme.bg : Theme.fg;
                            font-size: Typography.secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }

                        kb-add-btn-touch := TouchArea {
                            clicked => { root.kb-adding = !root.kb-adding; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Open in editor
                    Rectangle {
                        height: Typography.compact-control;
                        min-width: 80px;
                        border-radius: 4px;
                        background: kb-editor-touch.has-hover ? Theme.bg_lighter : Theme.bg_light;

                        Text {
                            text: "Edit File";
                            color: kb-editor-touch.has-hover ? Theme.fg : Theme.fg_dim;
                            font-size: Typography.secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }

                        kb-editor-touch := TouchArea {
                            clicked => { root.kb-open-editor(); }
                            mouse-cursor: pointer;
                        }
                    }

                    // Save
                    Rectangle {
                        height: Typography.compact-control;
                        min-width: 60px;
                        border-radius: 4px;
                        background: !root.kb-has-changes
                            ? Theme.bg_light.darker(0.2)
                            : kb-save-touch.has-hover ? Theme.success : Theme.bg_light;

                        Text {
                            text: "Save";
                            color: !root.kb-has-changes
                                ? Theme.fg_dim.darker(0.3)
                                : kb-save-touch.has-hover ? Theme.bg : Theme.fg;
                            font-size: Typography.secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }

                        kb-save-touch := TouchArea {
                            enabled: root.kb-has-changes;
                            mouse-cursor: root.kb-has-changes ? pointer : default;
                            clicked => { root.kb-save(); }
                        }
                    }

                    // Revert
                    Rectangle {
                        height: Typography.compact-control;
                        min-width: 60px;
                        border-radius: 4px;
                        background: !root.kb-has-changes
                            ? Theme.bg_light.darker(0.2)
                            : kb-revert-touch.has-hover ? Theme.warning : Theme.bg_light;

                        Text {
                            text: "Revert";
                            color: !root.kb-has-changes
                                ? Theme.fg_dim.darker(0.3)
                                : kb-revert-touch.has-hover ? Theme.bg : Theme.fg;
                            font-size: Typography.secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }

                        kb-revert-touch := TouchArea {
                            enabled: root.kb-has-changes;
                            mouse-cursor: root.kb-has-changes ? pointer : default;
                            clicked => { root.kb-revert(); }
                        }
                    }
                }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab5-flick.viewport-width;
                    viewport-x <=> tab5-flick.viewport-x;
                    visible-width: tab5-flick.width;
                }

                ScrollIndicator {
                    x: parent.width - 5px;
                    y: 0;
                    height: parent.height;
                    viewport-height: tab5-flick.viewport-height;
                    viewport-y: tab5-flick.viewport-y;
                    visible-height: tab5-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // TASKBAR TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 6: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab6-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 12px;

                Text {
                    text: "Taskbar";
                    color: Theme.fg;
                    font-size: Typography.heading;
                    font-weight: 600;
                }

                if root.tb-status != "": Text {
                    text: root.tb-status;
                    color: Theme.accent;
                    font-size: Typography.secondary;
                    wrap: word-wrap;
                }
                if root.tb-busy: Text {
                    text: "Saving...";
                    color: Theme.fg_dim;
                    font-size: Typography.secondary;
                }

                // ── Workspace Count card ──
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Workspace Count" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Workspace Count" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Text {
                            text: "Workspace Count";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        Text {
                            text: "Total workspaces across monitors (1–10). Automatic placement keeps at least one per monitor; occupied or visible workspaces remain when reducing the count.";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "1";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 220px;
                                height: Typography.compact-control;
                                border-radius: 4px;
                                background: Theme.bg_lighter.transparentize(50%);

                                // Track
                                Rectangle {
                                    x: 8px;
                                    y: (parent.height - 4px) / 2;
                                    width: parent.width - 16px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.bg_lighter;

                                    // Filled portion
                                    Rectangle {
                                        x: 0;
                                        y: 0;
                                        width: parent.width * (root.tb-ws-count - 1) / 9;
                                        height: parent.height;
                                        border-radius: 2px;
                                        background: Theme.accent;
                                    }
                                }

                                // Thumb
                                Rectangle {
                                    x: 8px + (parent.width - 16px - self.width) * (root.tb-ws-count - 1) / 9;
                                    y: (parent.height - self.height) / 2;
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: ws-slider-touch.has-hover ? Theme.accent.brighter(20%)
                                                : ws-slider-touch.pressed ? Theme.accent.brighter(40%)
                                                : Theme.accent;

                                    ws-slider-touch := TouchArea {
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Click area for the entire slider track
                                ws-track-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        // Map click x to 1–10
                                        root.tb-set-ws-count(clamp(round(1 + 9 * (self.mouse-x - 8px) / (self.width - 16px)), 1, 10));
                                    }
                                    moved => {
                                        if self.pressed {
                                            root.tb-set-ws-count(clamp(round(1 + 9 * (self.mouse-x - 8px) / (self.width - 16px)), 1, 10));
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "10";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                vertical-alignment: center;
                            }

                            // Current value badge
                            Rectangle {
                                width: 32px;
                                height: 24px;
                                border-radius: 4px;
                                background: Theme.accent.transparentize(70%);

                                Text {
                                    text: root.tb-ws-count;
                                    color: Theme.accent;
                                    font-size: Typography.body;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Workspace Position card ──
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Workspace Position" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Workspace Position" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Workspace Position";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        Text {
                            text: "Place workspace indicators in the center of the bar or on the left next to the start button.";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            wrap: word-wrap;
                        }

                        // Center option
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.tb-ws-position-index == 0
                                ? Theme.accent.transparentize(70%)
                                : ws-pos-center-touch.has-hover ? Theme.bg_lighter : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px;
                                        border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.tb-ws-position-index == 0 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.tb-ws-position-index == 0;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Center"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Workspace dots centered in the taskbar"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }

                            ws-pos-center-touch := TouchArea {
                                clicked => {
                                    root.tb-set-ws-position(0);
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Left option
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.tb-ws-position-index == 1
                                ? Theme.accent.transparentize(70%)
                                : ws-pos-left-touch.has-hover ? Theme.bg_lighter : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px;
                                        border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.tb-ws-position-index == 1 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.tb-ws-position-index == 1;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Left"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Workspace dots next to the start button"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }

                            ws-pos-left-touch := TouchArea {
                                clicked => {
                                    root.tb-set-ws-position(1);
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }

                // ── Workspace Spacing card ──
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Workspace Spacing" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Workspace Spacing" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }
                    private property <string> _hl: root.highlight-setting;
                    init => { if _hl == "Workspace Spacing" { tab6-flick.viewport-y = -max(0px, self.y - 20px); } }
                    changed _hl => { if _hl == "Workspace Spacing" { tab6-flick.viewport-y = -max(0px, self.y - 20px); } }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Workspace Spacing";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        Text {
                            text: "Gap in pixels between workspace indicators (1-10).";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "1";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 220px;
                                height: Typography.compact-control;
                                border-radius: 4px;
                                background: Theme.bg_lighter.transparentize(50%);

                                // Track
                                Rectangle {
                                    x: 8px;
                                    y: (parent.height - 4px) / 2;
                                    width: parent.width - 16px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.bg_lighter;

                                    // Filled portion
                                    Rectangle {
                                        x: 0;
                                        y: 0;
                                        width: parent.width * (root.tb-ws-spacing - 1) / 9;
                                        height: parent.height;
                                        border-radius: 2px;
                                        background: Theme.accent;
                                    }
                                }

                                // Thumb
                                Rectangle {
                                    x: 8px + (parent.width - 16px - self.width) * (root.tb-ws-spacing - 1) / 9;
                                    y: (parent.height - self.height) / 2;
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: ws-spacing-slider-touch.has-hover ? Theme.accent.brighter(20%)
                                                : ws-spacing-slider-touch.pressed ? Theme.accent.brighter(40%)
                                                : Theme.accent;

                                    ws-spacing-slider-touch := TouchArea {
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Click area for the entire slider track
                                ws-spacing-track-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.tb-set-ws-spacing(clamp(round(1 + 9 * (self.mouse-x - 8px) / (self.width - 16px)), 1, 10));
                                    }
                                    moved => {
                                        if self.pressed {
                                            root.tb-set-ws-spacing(clamp(round(1 + 9 * (self.mouse-x - 8px) / (self.width - 16px)), 1, 10));
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "10";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                vertical-alignment: center;
                            }

                            // Current value badge
                            Rectangle {
                                width: 38px;
                                height: 24px;
                                border-radius: 4px;
                                background: Theme.accent.transparentize(70%);

                                Text {
                                    text: root.tb-ws-spacing + "px";
                                    color: Theme.accent;
                                    font-size: Typography.body;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Workspace Style card ──
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Workspace Style" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Workspace Style" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }
                    private property <string> _hl: root.highlight-setting;
                    init => { if _hl == "Workspace Style" { tab6-flick.viewport-y = -max(0px, self.y - 20px); } }
                    changed _hl => { if _hl == "Workspace Style" { tab6-flick.viewport-y = -max(0px, self.y - 20px); } }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Workspace Style";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        // Numbers option
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.tb-ws-style-index == 0
                                ? Theme.accent.transparentize(70%)
                                : ws-style-numbers-touch.has-hover ? Theme.bg_lighter : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px;
                                        border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.tb-ws-style-index == 0 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.tb-ws-style-index == 0;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Numbers"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Workspace numbers"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }

                            ws-style-numbers-touch := TouchArea {
                                clicked => {
                                    root.tb-set-ws-style(0);
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Squares option
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.tb-ws-style-index == 1
                                ? Theme.accent.transparentize(70%)
                                : ws-style-squares-touch.has-hover ? Theme.bg_lighter : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px;
                                        border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.tb-ws-style-index == 1 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.tb-ws-style-index == 1;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Squares"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Compact squares for each workspace"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }

                            ws-style-squares-touch := TouchArea {
                                clicked => {
                                    root.tb-set-ws-style(1);
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }

                // ── Clock Format card ──────────────────────────────────
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: root.highlight-setting == "Clock Format" && root.highlight-blink-on ? 2px : 0px;
                    border-color: root.highlight-setting == "Clock Format" && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }
                    private property <string> _hl: root.highlight-setting;
                    init => {
                        if _hl == "Clock Format" || _hl == "Time Format" || _hl == "Date Format"
                            || _hl == "24-hour" || _hl == "AM PM" {
                            tab6-flick.viewport-y = -max(0px, self.y - 20px);
                        }
                    }
                    changed _hl => {
                        if _hl == "Clock Format" || _hl == "Time Format" || _hl == "Date Format"
                            || _hl == "24-hour" || _hl == "AM PM" {
                            tab6-flick.viewport-y = -max(0px, self.y - 20px);
                        }
                    }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Clock Format";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        Text {
                            text: "Choose what appears in the taskbar clock. Two-line formats show time larger with a smaller line below.";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            wrap: word-wrap;
                        }

                        // ── Display format options ──────────────────────

                        // Time only
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.tb-clock-format-index == 0
                                ? Theme.accent.transparentize(70%)
                                : clock-fmt-time-touch.has-hover ? Theme.bg_lighter : transparent;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 10px;
                                VerticalLayout {
                                    alignment: center; width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.tb-clock-format-index == 0 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.tb-clock-format-index == 0;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px; background: Theme.accent;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 1px;
                                    Text { text: "Time only"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "e.g.  3:42 PM"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }
                            clock-fmt-time-touch := TouchArea {
                                clicked => { root.tb-set-clock-format(0); }
                                mouse-cursor: pointer;
                            }
                        }

                        // Time & day of week
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.tb-clock-format-index == 1
                                ? Theme.accent.transparentize(70%)
                                : clock-fmt-dow-touch.has-hover ? Theme.bg_lighter : transparent;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 10px;
                                VerticalLayout {
                                    alignment: center; width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.tb-clock-format-index == 1 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.tb-clock-format-index == 1;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px; background: Theme.accent;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 1px;
                                    Text { text: "Time & day of week"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "e.g.  3:42 PM  /  Wed"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }
                            clock-fmt-dow-touch := TouchArea {
                                clicked => { root.tb-set-clock-format(1); }
                                mouse-cursor: pointer;
                            }
                        }

                        // Time & date
                        Rectangle {
                            height: Typography.choice-row;
                            border-radius: 4px;
                            background: root.tb-clock-format-index == 2
                                ? Theme.accent.transparentize(70%)
                                : clock-fmt-date-touch.has-hover ? Theme.bg_lighter : transparent;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 10px;
                                VerticalLayout {
                                    alignment: center; width: 14px;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: root.tb-clock-format-index == 2 ? Theme.accent : Theme.fg_dim;
                                        background: transparent;
                                        Rectangle {
                                            visible: root.tb-clock-format-index == 2;
                                            x: 3px; y: 3px; width: 8px; height: 8px;
                                            border-radius: 4px; background: Theme.accent;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 1px;
                                    Text { text: "Time & date"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "e.g.  3:42 PM  /  3/26"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                            }
                            clock-fmt-date-touch := TouchArea {
                                clicked => { root.tb-set-clock-format(2); }
                                mouse-cursor: pointer;
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg_lighter; }

                        // ── Time format (24h vs AM/PM) ──────────────────
                        Text {
                            text: "Time Format";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            // 24-hour
                            Rectangle {
                                height: Typography.choice-row; border-radius: 4px; horizontal-stretch: 1;
                                background: root.tb-clock-24h
                                    ? Theme.accent.transparentize(70%)
                                    : clock-24h-touch.has-hover ? Theme.bg_lighter : transparent;
                                HorizontalLayout {
                                    padding-left: 10px; spacing: 8px;
                                    VerticalLayout {
                                        alignment: center; width: 14px;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 7px;
                                            border-width: 1.5px;
                                            border-color: root.tb-clock-24h ? Theme.accent : Theme.fg_dim;
                                            background: transparent;
                                            Rectangle {
                                                visible: root.tb-clock-24h;
                                                x: 3px; y: 3px; width: 8px; height: 8px;
                                                border-radius: 4px; background: Theme.accent;
                                            }
                                        }
                                    }
                                    Text { text: "24-hour"; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                                }
                                clock-24h-touch := TouchArea {
                                    clicked => { root.tb-set-clock-24h(true); }
                                    mouse-cursor: pointer;
                                }
                            }

                            // AM / PM
                            Rectangle {
                                height: Typography.choice-row; border-radius: 4px; horizontal-stretch: 1;
                                background: !root.tb-clock-24h
                                    ? Theme.accent.transparentize(70%)
                                    : clock-ampm-touch.has-hover ? Theme.bg_lighter : transparent;
                                HorizontalLayout {
                                    padding-left: 10px; spacing: 8px;
                                    VerticalLayout {
                                        alignment: center; width: 14px;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 7px;
                                            border-width: 1.5px;
                                            border-color: !root.tb-clock-24h ? Theme.accent : Theme.fg_dim;
                                            background: transparent;
                                            Rectangle {
                                                visible: !root.tb-clock-24h;
                                                x: 3px; y: 3px; width: 8px; height: 8px;
                                                border-radius: 4px; background: Theme.accent;
                                            }
                                        }
                                    }
                                    Text { text: "AM / PM"; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                                }
                                clock-ampm-touch := TouchArea {
                                    clicked => { root.tb-set-clock-24h(false); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }

                        // ── Date format (only when clock_format == date) ─
                        if root.tb-clock-format-index == 2: Rectangle { height: 1px; background: Theme.bg_lighter; }

                        if root.tb-clock-format-index == 2: Text {
                            text: "Date Format";
                            color: Theme.fg_dim;
                            font-size: Typography.secondary;
                            font-weight: 600;
                        }

                        if root.tb-clock-format-index == 2: GridLayout {
                            spacing: 8px;

                            Row {
                                // M/D
                                Rectangle {
                                    height: Typography.choice-row; border-radius: 4px;
                                    background: root.tb-clock-date-fmt-index == 0
                                        ? Theme.accent.transparentize(70%)
                                        : clock-date-md-touch.has-hover ? Theme.bg_lighter : transparent;
                                    HorizontalLayout {
                                        padding-left: 10px; spacing: 8px;
                                        VerticalLayout {
                                            alignment: center; width: 14px;
                                            Rectangle {
                                                width: 14px; height: 14px; border-radius: 7px;
                                                border-width: 1.5px;
                                                border-color: root.tb-clock-date-fmt-index == 0 ? Theme.accent : Theme.fg_dim;
                                                background: transparent;
                                                Rectangle {
                                                    visible: root.tb-clock-date-fmt-index == 0;
                                                    x: 3px; y: 3px; width: 8px; height: 8px;
                                                    border-radius: 4px; background: Theme.accent;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center; spacing: 1px;
                                            Text { text: "M/D"; color: Theme.fg; font-size: Typography.body; }
                                            Text { text: "3/26"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                        }
                                    }
                                    clock-date-md-touch := TouchArea {
                                        clicked => { root.tb-set-clock-date-fmt(0); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // D/M
                                Rectangle {
                                    height: Typography.choice-row; border-radius: 4px;
                                    background: root.tb-clock-date-fmt-index == 1
                                        ? Theme.accent.transparentize(70%)
                                        : clock-date-dm-touch.has-hover ? Theme.bg_lighter : transparent;
                                    HorizontalLayout {
                                        padding-left: 10px; spacing: 8px;
                                        VerticalLayout {
                                            alignment: center; width: 14px;
                                            Rectangle {
                                                width: 14px; height: 14px; border-radius: 7px;
                                                border-width: 1.5px;
                                                border-color: root.tb-clock-date-fmt-index == 1 ? Theme.accent : Theme.fg_dim;
                                                background: transparent;
                                                Rectangle {
                                                    visible: root.tb-clock-date-fmt-index == 1;
                                                    x: 3px; y: 3px; width: 8px; height: 8px;
                                                    border-radius: 4px; background: Theme.accent;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center; spacing: 1px;
                                            Text { text: "D/M"; color: Theme.fg; font-size: Typography.body; }
                                            Text { text: "26/3"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                        }
                                    }
                                    clock-date-dm-touch := TouchArea {
                                        clicked => { root.tb-set-clock-date-fmt(1); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }

                            Row {
                                // YYYY-MM-DD
                                Rectangle {
                                    height: Typography.choice-row; border-radius: 4px;
                                    background: root.tb-clock-date-fmt-index == 2
                                        ? Theme.accent.transparentize(70%)
                                        : clock-date-iso-touch.has-hover ? Theme.bg_lighter : transparent;
                                    HorizontalLayout {
                                        padding-left: 10px; spacing: 8px;
                                        VerticalLayout {
                                            alignment: center; width: 14px;
                                            Rectangle {
                                                width: 14px; height: 14px; border-radius: 7px;
                                                border-width: 1.5px;
                                                border-color: root.tb-clock-date-fmt-index == 2 ? Theme.accent : Theme.fg_dim;
                                                background: transparent;
                                                Rectangle {
                                                    visible: root.tb-clock-date-fmt-index == 2;
                                                    x: 3px; y: 3px; width: 8px; height: 8px;
                                                    border-radius: 4px; background: Theme.accent;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center; spacing: 1px;
                                            Text { text: "YYYY-MM-DD"; color: Theme.fg; font-size: Typography.body; }
                                            Text { text: "2026-03-26"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                        }
                                    }
                                    clock-date-iso-touch := TouchArea {
                                        clicked => { root.tb-set-clock-date-fmt(2); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Mon D
                                Rectangle {
                                    height: Typography.choice-row; border-radius: 4px;
                                    background: root.tb-clock-date-fmt-index == 3
                                        ? Theme.accent.transparentize(70%)
                                        : clock-date-mon-touch.has-hover ? Theme.bg_lighter : transparent;
                                    HorizontalLayout {
                                        padding-left: 10px; spacing: 8px;
                                        VerticalLayout {
                                            alignment: center; width: 14px;
                                            Rectangle {
                                                width: 14px; height: 14px; border-radius: 7px;
                                                border-width: 1.5px;
                                                border-color: root.tb-clock-date-fmt-index == 3 ? Theme.accent : Theme.fg_dim;
                                                background: transparent;
                                                Rectangle {
                                                    visible: root.tb-clock-date-fmt-index == 3;
                                                    x: 3px; y: 3px; width: 8px; height: 8px;
                                                    border-radius: 4px; background: Theme.accent;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center; spacing: 1px;
                                            Text { text: "Mon D"; color: Theme.fg; font-size: Typography.body; }
                                            Text { text: "Mar 26"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                        }
                                    }
                                    clock-date-mon-touch := TouchArea {
                                        clicked => { root.tb-set-clock-date-fmt(3); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab6-flick.viewport-width;
                    viewport-x <=> tab6-flick.viewport-x;
                    visible-width: tab6-flick.width;
                }

                ScrollIndicator {
                    x: parent.width - 5px;
                    y: 0;
                    height: parent.height;
                    viewport-height: tab6-flick.viewport-height;
                    viewport-y: tab6-flick.viewport-y;
                    visible-height: tab6-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // WI-FI TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 7: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab7-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 12px;

                    // ── Header: title + scan button ──
                    HorizontalLayout {
                        height: Typography.compact-control;
                        spacing: 8px;

                        Text {
                            text: "Wi-Fi";
                            color: Theme.fg;
                            font-size: Typography.heading;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        // Status text
                        Text {
                            text: root.wifi-status;
                            color: root.wifi-status-is-error ? #f38ba8 : Theme.fg_dim;
                            font-size: Typography.secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        // Scan / refresh button
                        Rectangle {
                            width: 60px;
                            height: Typography.compact-control;
                            border-radius: 4px;
                            background: wifi-scan-touch.has-hover ? Theme.bg_lighter : Theme.bg_light;

                            Text {
                                text: root.wifi-scanning ? "Scanning…" : "Scan";
                                color: root.wifi-scanning ? Theme.fg_dim : Theme.fg;
                                font-size: Typography.secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            wifi-scan-touch := TouchArea {
                                clicked => {
                                    if !root.wifi-scanning {
                                        root.wifi-scan();
                                    }
                                }
                                mouse-cursor: root.wifi-scanning ? default : pointer;
                            }
                        }
                    }

                    // ── Airplane Mode card ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: root.highlight-setting == "Airplane Mode" && root.highlight-blink-on ? 2px : 0px;
                        border-color: root.highlight-setting == "Airplane Mode" && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: "\u{2708}  Airplane Mode";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                // Toggle pill
                                Rectangle {
                                    width: 40px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.wifi-airplane-mode ? Theme.accent : Theme.bg_lighter;
                                    animate background { duration: 200ms; }

                                    Rectangle {
                                        x: root.wifi-airplane-mode ? parent.width - self.width - 3px : 3px;
                                        y: 3px;
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: white;
                                        animate x { duration: 200ms; easing: ease-in-out; }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.wifi-set-airplane(!root.wifi-airplane-mode);
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }

                            if root.wifi-airplane-mode: Text {
                                text: "Wi-Fi is disabled. Turn off airplane mode to see networks.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                            }
                        }
                    }

                    // ── No hardware warning ──
                    if root.wifi-no-hardware: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        height: 48px;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "\u{26A0}  No Wi-Fi adapter detected";
                                color: #f38ba8;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // ── Network list card ──
                    if !root.wifi-airplane-mode && !root.wifi-no-hardware && root.wifi-selected-idx == -1: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: root.highlight-setting == "Wi-Fi" && root.highlight-blink-on ? 2px : 0px;
                        border-color: root.highlight-setting == "Wi-Fi" && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            Text {
                                text: "Available Networks";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }

                            if root.wifi-networks.length == 0 && !root.wifi-scanning: Text {
                                text: "No networks found. Press Scan to search.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                            }

                            if root.wifi-scanning && root.wifi-networks.length == 0: Text {
                                text: "Scanning for networks…";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                            }

                            for net[idx] in root.wifi-networks: Rectangle {
                                height: 36px;
                                border-radius: 4px;
                                background: wifi-net-touch.has-hover ? Theme.bg.transparentize(70%) : transparent;

                                VerticalLayout {
                                    padding: 6px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;

                                    // ── Row: signal bars, SSID, security badge, connected badge ──
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        SignalBars {
                                            signal: net.signal;
                                        }

                                        Text {
                                            text: net.ssid;
                                            color: net.connected ? Theme.accent : Theme.fg;
                                            font-size: Typography.body;
                                            font-weight: net.connected ? 600 : 400;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        if net.saved && !net.connected: Text {
                                            text: "Saved";
                                            color: Theme.fg_dim;
                                            font-size: Typography.caption;
                                            vertical-alignment: center;
                                        }

                                        if net.connected: Text {
                                            text: "\u{2713} Connected";
                                            color: Theme.accent;
                                            font-size: Typography.caption;
                                            vertical-alignment: center;
                                        }

                                        if net.security != "Open": Rectangle {
                                            width: sec-label.width + 10px;
                                            height: 18px;
                                            border-radius: 3px;
                                            background: Theme.bg_lighter;

                                            sec-label := Text {
                                                text: "\u{1F512} " + net.security;
                                                color: Theme.fg_dim;
                                                font-size: Typography.caption;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Chevron indicating navigation to detail page
                                        Text {
                                            text: "\u{203A}";
                                            color: Theme.fg_dim;
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                wifi-net-touch := TouchArea {
                                    clicked => {
                                        root.wifi-selected-idx = idx;
                                        root.wifi-password-input = "";
                                        root.wifi-show-password = false;
                                        root.wifi-qr-visible = false;
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    // ── Network detail page (replaces list when a network is selected) ──
                    if root.wifi-selected-idx != -1
                       && root.wifi-selected-idx < root.wifi-networks.length: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;

                            // ── Header: back button + SSID ──
                            HorizontalLayout {
                                spacing: 10px;
                                height: 32px;

                                Rectangle {
                                    width: 60px;
                                    height: Typography.compact-control;
                                    border-radius: 4px;
                                    background: wifi-back-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                    Text {
                                        text: "\u{2039} Back";
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    wifi-back-touch := TouchArea {
                                        clicked => {
                                            root.wifi-selected-idx = -1;
                                            root.wifi-password-input = "";
                                            root.wifi-show-password = false;
                                            root.wifi-qr-visible = false;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }

                                Text {
                                    text: root.wifi-networks[root.wifi-selected-idx].ssid;
                                    color: Theme.fg;
                                    font-size: Typography.heading;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }

                                SignalBars {
                                    signal: root.wifi-networks[root.wifi-selected-idx].signal;
                                }
                            }

                            // ── Status row: badges ──
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                if root.wifi-networks[root.wifi-selected-idx].connected: Rectangle {
                                    width: cb-label.width + 14px;
                                    height: 20px;
                                    border-radius: 3px;
                                    background: Theme.accent.transparentize(70%);

                                    cb-label := Text {
                                        text: "\u{2713} Connected";
                                        color: Theme.accent;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.wifi-networks[root.wifi-selected-idx].saved
                                   && !root.wifi-networks[root.wifi-selected-idx].connected: Rectangle {
                                    width: sv-label.width + 14px;
                                    height: 20px;
                                    border-radius: 3px;
                                    background: Theme.bg_lighter;

                                    sv-label := Text {
                                        text: "Saved";
                                        color: Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: sec-d-label.width + 14px;
                                    height: 20px;
                                    border-radius: 3px;
                                    background: Theme.bg_lighter;

                                    sec-d-label := Text {
                                        text: root.wifi-networks[root.wifi-selected-idx].security == "Open"
                                              ? "Open"
                                              : "\u{1F512} " + root.wifi-networks[root.wifi-selected-idx].security;
                                        color: Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // ── Password field (for secured networks) ──
                            if root.wifi-networks[root.wifi-selected-idx].security != "Open": VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: root.wifi-networks[root.wifi-selected-idx].saved
                                          ? "Update password"
                                          : "Password";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                }

                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: Theme.bg;

                                    wifi-pw-input-d := TextInput {
                                        x: 10px;
                                        y: 0px;
                                        width: parent.width - 44px;
                                        height: parent.height;
                                        color: Theme.fg;
                                        font-size: Typography.body;
                                        input-type: root.wifi-show-password ? text : password;
                                        text <=> root.wifi-password-input;
                                        single-line: true;
                                        accepted => {
                                            if !root.wifi-connecting {
                                                root.wifi-connect(root.wifi-selected-idx,
                                                                  root.wifi-password-input, 0);
                                            }
                                        }
                                    }

                                    // Focus grabber (everything except the eye-toggle area)
                                    pw-focus-d := TouchArea {
                                        x: 0;
                                        y: 0;
                                        width: parent.width - 32px;
                                        height: parent.height;
                                        clicked => { wifi-pw-input-d.focus(); }
                                        mouse-cursor: text;
                                    }

                                    // Eye toggle
                                    TouchArea {
                                        x: parent.width - 32px;
                                        y: 2px;
                                        width: 28px;
                                        height: Typography.compact-control;
                                        clicked => { root.wifi-show-password = !root.wifi-show-password; }
                                        mouse-cursor: pointer;

                                        Text {
                                            text: root.wifi-show-password ? "\u{1F441}" : "\u{25CF}";
                                            color: Theme.fg_dim;
                                            font-size: Typography.body;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.wifi-networks[root.wifi-selected-idx].saved
                                   && root.wifi-password-input == "": Text {
                                    text: "Leave blank to use saved password.";
                                    color: Theme.fg_dim;
                                    font-size: Typography.caption;
                                }
                            }

                            // ── Action buttons ──
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                // Connect (or Update Password when saved/connected with new pw)
                                Rectangle {
                                    width: 110px;
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.wifi-connecting ? Theme.bg_lighter : Theme.accent;

                                    Text {
                                        text: root.wifi-connecting
                                              ? "Connecting…"
                                              : (root.wifi-networks[root.wifi-selected-idx].saved
                                                 && root.wifi-password-input != ""
                                                 ? "Update & Connect"
                                                 : (root.wifi-networks[root.wifi-selected-idx].connected
                                                    ? "Reconnect"
                                                    : "Connect"));
                                        color: root.wifi-connecting ? Theme.fg_dim : Theme.bg;
                                        font-size: Typography.secondary;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            if !root.wifi-connecting {
                                                root.wifi-connect(root.wifi-selected-idx,
                                                                  root.wifi-password-input, 0);
                                            }
                                        }
                                        mouse-cursor: root.wifi-connecting ? default : pointer;
                                    }
                                }

                                // Disconnect (if currently connected)
                                if root.wifi-networks[root.wifi-selected-idx].connected: Rectangle {
                                    width: 90px;
                                    height: 32px;
                                    border-radius: 4px;
                                    background: wifi-dc-touch-d.has-hover ? #f38ba8 : Theme.bg_lighter;

                                    Text {
                                        text: "Disconnect";
                                        color: wifi-dc-touch-d.has-hover ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    wifi-dc-touch-d := TouchArea {
                                        clicked => { root.wifi-disconnect(); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Forget (if saved)
                                if root.wifi-networks[root.wifi-selected-idx].saved: Rectangle {
                                    width: 70px;
                                    height: 32px;
                                    border-radius: 4px;
                                    background: wifi-forget-touch-d.has-hover ? Theme.bg_lighter : Theme.bg;

                                    Text {
                                        text: "Forget";
                                        color: Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    wifi-forget-touch-d := TouchArea {
                                        clicked => {
                                            root.wifi-forget(root.wifi-selected-idx);
                                            root.wifi-selected-idx = -1;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Share via QR (only for saved/connected networks — needs stored password)
                                if root.wifi-networks[root.wifi-selected-idx].saved
                                   || root.wifi-networks[root.wifi-selected-idx].connected
                                   || root.wifi-networks[root.wifi-selected-idx].security == "Open": Rectangle {
                                    width: 110px;
                                    height: 32px;
                                    border-radius: 4px;
                                    background: wifi-qr-touch-d.has-hover ? Theme.bg_lighter : Theme.bg;

                                    Text {
                                        text: "\u{25A3}  Share QR";
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    wifi-qr-touch-d := TouchArea {
                                        clicked => {
                                            root.wifi-generate-qr(root.wifi-selected-idx);
                                            root.wifi-qr-visible = true;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }

                    // ── QR Code overlay card ──
                    if root.wifi-qr-visible: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: "QR Code";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                // Close QR
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: wifi-qr-close-touch.has-hover ? Theme.bg_lighter : transparent;

                                    Text {
                                        text: "\u{2715}";
                                        color: Theme.fg_dim;
                                        font-size: Typography.body;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    wifi-qr-close-touch := TouchArea {
                                        clicked => { root.wifi-qr-visible = false; }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }

                            if root.wifi-qr-error != "": Text {
                                text: root.wifi-qr-error;
                                color: #f38ba8;
                                font-size: Typography.secondary;
                            }

                            // QR image
                            if root.wifi-qr-error == "": Rectangle {
                                width: 180px;
                                height: 180px;
                                border-radius: 8px;
                                background: white;

                                Image {
                                    width: 160px;
                                    height: 160px;
                                    source: root.wifi-qr-image;
                                    image-fit: contain;
                                }
                            }

                            // Export button
                            if root.wifi-qr-error == "" && root.wifi-selected-idx >= 0: Rectangle {
                                height: Typography.compact-control;
                                min-width: 120px;
                                border-radius: 4px;
                                background: wifi-export-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    Text {
                                        text: "Save QR to Downloads";
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                wifi-export-touch := TouchArea {
                                    clicked => { root.wifi-export-qr(root.wifi-selected-idx); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    // ── Connect via URI card ──
                    if !root.wifi-airplane-mode && !root.wifi-no-hardware: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "Connect via Wi-Fi URI";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: Typography.compact-control;
                                    border-radius: 4px;
                                    background: Theme.bg;

                                    wifi-uri-field := TextInput {
                                        x: 8px;
                                        y: 5px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        text <=> root.wifi-uri-input;
                                    }
                                }

                                // Apply URI
                                Rectangle {
                                    width: 54px;
                                    height: Typography.compact-control;
                                    border-radius: 4px;
                                    background: wifi-uri-apply-touch.has-hover ? Theme.accent : Theme.bg_lighter;

                                    Text {
                                        text: "Apply";
                                        color: wifi-uri-apply-touch.has-hover ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    wifi-uri-apply-touch := TouchArea {
                                        clicked => { root.wifi-apply-uri(root.wifi-uri-input); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Scan from screen
                                Rectangle {
                                    width: 90px;
                                    height: Typography.compact-control;
                                    border-radius: 4px;
                                    background: wifi-screenscan-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                    Text {
                                        text: "\u{1F4F7} Scan Screen";
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    wifi-screenscan-touch := TouchArea {
                                        clicked => { root.wifi-scan-screenshot(); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }

                            Text {
                                text: "Paste a WIFI:T:WPA;S:MyNetwork;P:password;; URI or scan a QR code from the screen.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ── Saved Networks card ──
                    // Every 802-11-wireless profile NetworkManager remembers,
                    // even those not currently in range. Lets the user audit
                    // and prune stale credentials.
                    if !root.wifi-no-hardware: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: space-between;

                                Text {
                                    text: "Saved Networks";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    // Refresh button
                                    Rectangle {
                                        width: 70px;
                                        height: Typography.compact-control;
                                        border-radius: 4px;
                                        background: wifi-saved-refresh-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                        Text {
                                            text: "Refresh";
                                            color: Theme.fg;
                                            font-size: Typography.secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        wifi-saved-refresh-touch := TouchArea {
                                            clicked => { root.wifi-list-saved(); }
                                            mouse-cursor: pointer;
                                        }
                                    }

                                    // Forget all button (only when there is something to forget)
                                    if root.wifi-saved-networks.length > 0: Rectangle {
                                        width: 90px;
                                        height: Typography.compact-control;
                                        border-radius: 4px;
                                        background: wifi-forget-all-touch.has-hover ? Theme.danger : Theme.bg_lighter;

                                        Text {
                                            text: "Forget All";
                                            color: wifi-forget-all-touch.has-hover ? Theme.bg : Theme.fg;
                                            font-size: Typography.secondary;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        wifi-forget-all-touch := TouchArea {
                                            clicked => { root.wifi-forget-all(); }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }
                            }

                            if root.wifi-saved-networks.length == 0: Text {
                                text: "No saved networks.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                            }

                            for ssid[idx] in root.wifi-saved-networks: Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: Theme.bg;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    alignment: space-between;

                                    Text {
                                        text: ssid;
                                        color: Theme.fg;
                                        font-size: Typography.body;
                                        vertical-alignment: center;
                                        // Mark the currently active one
                                        font-weight: ssid == root.wifi-current-ssid ? 600 : 400;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Rectangle {
                                        width: 70px;
                                        height: 24px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        background: wifi-saved-forget-touch.has-hover ? Theme.danger : Theme.bg_lighter;

                                        Text {
                                            text: "Forget";
                                            color: wifi-saved-forget-touch.has-hover ? Theme.bg : Theme.fg;
                                            font-size: Typography.secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        wifi-saved-forget-touch := TouchArea {
                                            clicked => { root.wifi-forget-by-ssid(ssid); }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab7-flick.viewport-width;
                    viewport-x <=> tab7-flick.viewport-x;
                    visible-width: tab7-flick.width;
                }

                ScrollIndicator {
                    x: parent.width - 5px;
                    y: 0;
                    height: parent.height;
                    viewport-height: tab7-flick.viewport-height;
                    viewport-y: tab7-flick.viewport-y;
                    visible-height: tab7-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // BLUETOOTH TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 8: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab8-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 12px;

                    // ── Header: title + scan button ──
                    HorizontalLayout {
                        height: Typography.compact-control;
                        spacing: 8px;

                        Text {
                            text: "Bluetooth";
                            color: Theme.fg;
                            font-size: Typography.heading;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        // Status text
                        Text {
                            text: root.bt-status;
                            color: root.bt-status-is-error ? #f38ba8 : Theme.fg_dim;
                            font-size: Typography.secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        // Scan button
                        Rectangle {
                            width: 60px;
                            height: Typography.compact-control;
                            border-radius: 4px;
                            background: bt-scan-touch.has-hover ? Theme.bg_lighter : Theme.bg_light;

                            Text {
                                text: root.bt-scanning ? "Scanning…" : "Scan";
                                color: root.bt-scanning ? Theme.fg_dim : Theme.fg;
                                font-size: Typography.secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            bt-scan-touch := TouchArea {
                                clicked => {
                                    if !root.bt-scanning {
                                        root.bt-scan();
                                    }
                                }
                                mouse-cursor: root.bt-scanning ? default : pointer;
                            }
                        }
                    }

                    // ── Power toggle card ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: root.highlight-setting == "Bluetooth" && root.highlight-blink-on ? 2px : 0px;
                        border-color: root.highlight-setting == "Bluetooth" && root.highlight-blink-on ? Theme.accent : transparent;
                        animate border-width { duration: 400ms; easing: ease-in-out; }
                        animate border-color { duration: 400ms; easing: ease-in-out; }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: "\u{1F4E1}  Bluetooth Power";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                // Toggle pill
                                Rectangle {
                                    width: 40px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.bt-powered ? Theme.accent : Theme.bg_lighter;
                                    animate background { duration: 200ms; }

                                    Rectangle {
                                        x: root.bt-powered ? parent.width - self.width - 3px : 3px;
                                        y: 3px;
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: white;
                                        animate x { duration: 200ms; easing: ease-in-out; }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.bt-set-powered(!root.bt-powered);
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }

                            if !root.bt-powered && !root.bt-no-hardware: Text {
                                text: "Bluetooth is off. Turn it on to discover and connect to devices.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                            }
                        }
                    }

                    // ── No hardware warning ──
                    if root.bt-no-hardware: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        height: 48px;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "\u{26A0}  No Bluetooth adapter detected";
                                color: #f38ba8;
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // ── Discoverable toggle ──
                    if root.bt-powered && !root.bt-no-hardware: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: "Discoverable";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.bt-discoverable ? "Visible to other devices" : "Hidden";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 40px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.bt-discoverable ? Theme.accent : Theme.bg_lighter;
                                    animate background { duration: 200ms; }

                                    Rectangle {
                                        x: root.bt-discoverable ? parent.width - self.width - 3px : 3px;
                                        y: 3px;
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: white;
                                        animate x { duration: 200ms; easing: ease-in-out; }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.bt-set-discoverable(!root.bt-discoverable);
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }

                    // ── Device list card ──
                    if root.bt-powered && !root.bt-no-hardware: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            Text {
                                text: "Devices";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }

                            if root.bt-devices.length == 0 && !root.bt-scanning: Text {
                                text: "No devices found. Press Scan to search.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                            }

                            if root.bt-scanning && root.bt-devices.length == 0: Text {
                                text: "Scanning for devices…";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                            }

                            for dev[idx] in root.bt-devices: Rectangle {
                                height: root.bt-selected-idx == idx ? 50px : 36px;
                                border-radius: 4px;
                                background: root.bt-selected-idx == idx
                                    ? Theme.bg.transparentize(40%)
                                    : bt-dev-touch.has-hover ? Theme.bg.transparentize(70%) : transparent;
                                animate height { duration: 150ms; easing: ease-in-out; }

                                VerticalLayout {
                                    padding: 6px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;

                                    // ── Row: icon, name, paired/connected badges ──
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        // Device icon
                                        Text {
                                            text: dev.icon;
                                            font-size: Typography.heading;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: dev.name;
                                            color: dev.connected ? Theme.accent : Theme.fg;
                                            font-size: Typography.body;
                                            font-weight: dev.connected ? 600 : 400;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        if dev.paired && !dev.connected: Text {
                                            text: "Paired";
                                            color: Theme.fg_dim;
                                            font-size: Typography.caption;
                                            vertical-alignment: center;
                                        }

                                        if dev.connected: Text {
                                            text: "\u{2713} Connected";
                                            color: Theme.accent;
                                            font-size: Typography.caption;
                                            vertical-alignment: center;
                                        }

                                        // Signal bars (reuse from WiFi)
                                        if dev.signal > 0: SignalBars {
                                            signal: dev.signal;
                                        }
                                    }

                                    // ── Expanded: action buttons ──
                                    if root.bt-selected-idx == idx: HorizontalLayout {
                                        spacing: 6px;

                                        // Connect / Disconnect
                                        if !dev.connected: Rectangle {
                                            width: 66px;
                                            height: Typography.compact-control;
                                            border-radius: 4px;
                                            background: root.bt-connecting ? Theme.bg_lighter : Theme.accent;

                                            Text {
                                                text: root.bt-connecting ? "…" : "Connect";
                                                color: root.bt-connecting ? Theme.fg_dim : Theme.bg;
                                                font-size: Typography.secondary;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            TouchArea {
                                                clicked => {
                                                    if !root.bt-connecting {
                                                        root.bt-connect(idx);
                                                    }
                                                }
                                                mouse-cursor: root.bt-connecting ? default : pointer;
                                            }
                                        }

                                        if dev.connected: Rectangle {
                                            width: 80px;
                                            height: Typography.compact-control;
                                            border-radius: 4px;
                                            background: bt-dc-touch.has-hover ? #f38ba8 : Theme.bg_lighter;

                                            Text {
                                                text: "Disconnect";
                                                color: bt-dc-touch.has-hover ? Theme.bg : Theme.fg;
                                                font-size: Typography.secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            bt-dc-touch := TouchArea {
                                                clicked => { root.bt-disconnect(idx); }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        // Pair (if not paired)
                                        if !dev.paired: Rectangle {
                                            width: 46px;
                                            height: Typography.compact-control;
                                            border-radius: 4px;
                                            background: bt-pair-touch.has-hover ? Theme.accent : Theme.bg_lighter;

                                            Text {
                                                text: "Pair";
                                                color: bt-pair-touch.has-hover ? Theme.bg : Theme.fg;
                                                font-size: Typography.secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            bt-pair-touch := TouchArea {
                                                clicked => { root.bt-pair(idx); }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        // Trust (if paired but not trusted)
                                        if dev.paired && !dev.trusted: Rectangle {
                                            width: 52px;
                                            height: Typography.compact-control;
                                            border-radius: 4px;
                                            background: bt-trust-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                            Text {
                                                text: "Trust";
                                                color: Theme.fg_dim;
                                                font-size: Typography.secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            bt-trust-touch := TouchArea {
                                                clicked => { root.bt-trust(idx); }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        // Forget (if paired)
                                        if dev.paired: Rectangle {
                                            width: 52px;
                                            height: Typography.compact-control;
                                            border-radius: 4px;
                                            background: bt-forget-touch.has-hover ? Theme.bg_lighter : Theme.bg;

                                            Text {
                                                text: "Forget";
                                                color: Theme.fg_dim;
                                                font-size: Typography.secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            bt-forget-touch := TouchArea {
                                                clicked => { root.bt-forget(idx); }
                                                mouse-cursor: pointer;
                                            }
                                        }
                                    }
                                }

                                bt-dev-touch := TouchArea {
                                    clicked => {
                                        if root.bt-selected-idx == idx {
                                            root.bt-selected-idx = -1;
                                        } else {
                                            root.bt-selected-idx = idx;
                                        }
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab8-flick.viewport-width;
                    viewport-x <=> tab8-flick.viewport-x;
                    visible-width: tab8-flick.width;
                }

                ScrollIndicator {
                    x: parent.width - 5px;
                    y: 0;
                    height: parent.height;
                    viewport-height: tab8-flick.viewport-height;
                    viewport-y: tab8-flick.viewport-y;
                    visible-height: tab8-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // GLASSES (XR) TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 9: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab9-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);
                    viewport-height: tab9-content.preferred-height;

                tab9-content := VerticalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 12px;

                    Text {
                        text: "XR Glasses";
                        color: Theme.fg;
                        font-size: Typography.heading;
                        font-weight: 600;
                    }

                    // ── Status card ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 10px; height: 10px; border-radius: 5px;
                                    y: 4px;
                                    background: root.xr-glasses-connected ? Theme.success : Theme.fg_dim;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.xr-glasses-connected
                                        ? (root.xr-running ? "VITURE glasses connected — virtual monitors active"
                                                           : "VITURE glasses connected — renderer idle")
                                        : "No VITURE glasses detected";
                                    color: Theme.fg;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                Rectangle {
                                    width: 64px; height: 24px; border-radius: 4px;
                                    background: xr-refresh-touch.has-hover ? Theme.bg_lighter : Theme.bg;
                                    Text { text: "Refresh"; color: Theme.fg; font-size: Typography.secondary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height; }
                                    xr-refresh-touch := TouchArea { clicked => { root.xr-refresh(); } mouse-cursor: pointer; }
                                }
                            }

                            if root.xr-status != "": Text {
                                text: root.xr-status;
                                color: root.xr-status-is-error ? #f38ba8 : Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ── Enable card (auto-launch + start now) ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text { text: "Virtual monitors"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Auto-launch when glasses connect"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                                // Toggle pill
                                Rectangle {
                                    width: 40px; height: 22px; border-radius: 11px;
                                    background: root.xr-enabled ? Theme.accent : Theme.bg_lighter;
                                    animate background { duration: 200ms; }
                                    Rectangle {
                                        x: root.xr-enabled ? parent.width - self.width - 3px : 3px;
                                        y: 3px; width: 16px; height: 16px; border-radius: 8px; background: white;
                                        animate x { duration: 200ms; easing: ease-in-out; }
                                    }
                                    TouchArea {
                                        clicked => { root.xr-enabled = !root.xr-enabled; root.xr-set-enabled(root.xr-enabled); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }

                    // ── Recenter button ──
                    Rectangle {
                        height: Typography.choice-row;
                        border-radius: 6px;
                        background: xr-recenter-touch.has-hover ? Theme.accent : Theme.bg_light;
                        HorizontalLayout {
                            alignment: center; spacing: 8px;
                            Text { text: "\u{1F3AF}"; font-size: Typography.heading; vertical-alignment: center; }
                            Text { text: "Recenter view"; color: xr-recenter-touch.has-hover ? Theme.bg : Theme.fg;
                                font-size: Typography.body; vertical-alignment: center; }
                        }
                        xr-recenter-touch := TouchArea {
                            clicked => { root.xr-recenter(); }
                            mouse-cursor: root.xr-running ? pointer : default;
                        }
                    }

                    // ── Monitor count ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 12px; spacing: 8px;
                            Text { text: "Number of screens"; color: Theme.fg_dim; font-size: Typography.secondary; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 4px;
                                for opt[idx] in [{ l: "Single", v: 1 }, { l: "Triple (arc)", v: 3 }]: Rectangle {
                                    height: Typography.compact-control; horizontal-stretch: 1; border-radius: 4px;
                                    background: root.xr-monitor-count == opt.v ? Theme.accent
                                        : mc-touch.has-hover ? Theme.bg_lighter : Theme.bg;
                                    Text { text: opt.l; color: root.xr-monitor-count == opt.v ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary; horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height; }
                                    mc-touch := TouchArea {
                                        clicked => { root.xr-monitor-count = opt.v; root.xr-set-monitors(opt.v); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }

                    // ── Layout + radius ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 12px; spacing: 8px;
                            Text { text: "Layout"; color: Theme.fg_dim; font-size: Typography.secondary; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 4px;
                                for opt[idx] in ["Arc", "Flat"]: Rectangle {
                                    height: Typography.compact-control; horizontal-stretch: 1; border-radius: 4px;
                                    background: root.xr-layout-index == idx ? Theme.accent
                                        : lay-touch.has-hover ? Theme.bg_lighter : Theme.bg;
                                    Text { text: opt; color: root.xr-layout-index == idx ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary; horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height; }
                                    lay-touch := TouchArea {
                                        clicked => { root.xr-layout-index = idx; root.xr-set-layout(idx); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                            if root.xr-layout-index == 0: HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Curve radius"; color: Theme.fg_dim; font-size: Typography.secondary;
                                    vertical-alignment: center; width: 90px; }
                                ThemeSlider {
                                    horizontal-stretch: 1;
                                    minimum: 1.0; maximum: 4.0; value: root.xr-radius;
                                    changed(v) => { root.xr-radius = v; root.xr-set-radius(v); }
                                }
                                Text { text: round(root.xr-radius * 10) / 10 + "m"; color: Theme.fg;
                                    font-size: Typography.secondary; vertical-alignment: center; width: 36px; }
                            }
                        }
                    }

                    // ── Display tuning: FOV / curvature / smoothing ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 12px; spacing: 10px;
                            Text { text: "Display"; color: Theme.fg_dim; font-size: Typography.secondary; font-weight: 600; }

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Field of view"; color: Theme.fg; font-size: Typography.secondary;
                                    vertical-alignment: center; width: 90px; }
                                ThemeSlider {
                                    horizontal-stretch: 1;
                                    minimum: 30.0; maximum: 70.0; value: root.xr-fov;
                                    changed(v) => { root.xr-fov = v; root.xr-set-fov(v); }
                                }
                                Text { text: round(root.xr-fov) + "\u{00B0}"; color: Theme.fg;
                                    font-size: Typography.secondary; vertical-alignment: center; width: 36px; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Screen curve"; color: Theme.fg; font-size: Typography.secondary;
                                    vertical-alignment: center; width: 90px; }
                                ThemeSlider {
                                    horizontal-stretch: 1;
                                    minimum: 0.0; maximum: 1.0; value: root.xr-curvature;
                                    changed(v) => { root.xr-curvature = v; root.xr-set-curvature(v); }
                                }
                                Text { text: round(root.xr-curvature * 100) + "%"; color: Theme.fg;
                                    font-size: Typography.secondary; vertical-alignment: center; width: 36px; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Smoothing"; color: Theme.fg; font-size: Typography.secondary;
                                    vertical-alignment: center; width: 90px; }
                                ThemeSlider {
                                    horizontal-stretch: 1;
                                    minimum: 0.0; maximum: 1.0; value: root.xr-smoothing;
                                    changed(v) => { root.xr-smoothing = v; root.xr-set-smoothing(v); }
                                }
                                Text { text: round(root.xr-smoothing * 100) + "%"; color: Theme.fg;
                                    font-size: Typography.secondary; vertical-alignment: center; width: 36px; }
                            }
                        }
                    }

                    // ── 3D / Stereo toggle ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 12px; spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 2px;
                                    Text { text: "Side-by-side 3D"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Stereoscopic output for 3D content"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                                Rectangle {
                                    width: 40px; height: 22px; border-radius: 11px;
                                    background: root.xr-stereo ? Theme.accent : Theme.bg_lighter;
                                    animate background { duration: 200ms; }
                                    Rectangle {
                                        x: root.xr-stereo ? parent.width - self.width - 3px : 3px;
                                        y: 3px; width: 16px; height: 16px; border-radius: 8px; background: white;
                                        animate x { duration: 200ms; easing: ease-in-out; }
                                    }
                                    TouchArea {
                                        clicked => { root.xr-stereo = !root.xr-stereo; root.xr-set-stereo(root.xr-stereo); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }

                    // ── Head-tracking (mode B) toggle ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 12px; spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 2px;
                                    Text { text: "Head-tracking output"; color: Theme.fg; font-size: Typography.body; }
                                    Text { text: "Send head-look to flight/space sims (OpenTrack)"; color: Theme.fg_dim; font-size: Typography.secondary; }
                                }
                                Rectangle {
                                    width: 40px; height: 22px; border-radius: 11px;
                                    background: root.xr-headtracking ? Theme.accent : Theme.bg_lighter;
                                    animate background { duration: 200ms; }
                                    Rectangle {
                                        x: root.xr-headtracking ? parent.width - self.width - 3px : 3px;
                                        y: 3px; width: 16px; height: 16px; border-radius: 8px; background: white;
                                        animate x { duration: 200ms; easing: ease-in-out; }
                                    }
                                    TouchArea {
                                        clicked => { root.xr-headtracking = !root.xr-headtracking; root.xr-set-headtracking(root.xr-headtracking); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }

                    // ── Advanced: capture backend ──
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 12px; spacing: 8px;
                            Text { text: "Advanced — capture backend"; color: Theme.fg_dim; font-size: Typography.secondary; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 4px;
                                for opt[idx] in ["Auto", "Modern", "wlroots"]: Rectangle {
                                    height: Typography.compact-control; horizontal-stretch: 1; border-radius: 4px;
                                    background: root.xr-capture-index == idx ? Theme.accent
                                        : cap-touch.has-hover ? Theme.bg_lighter : Theme.bg;
                                    Text { text: opt; color: root.xr-capture-index == idx ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary; horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height; }
                                    cap-touch := TouchArea {
                                        clicked => { root.xr-capture-index = idx; root.xr-set-capture(idx); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Zero-copy (dmabuf)"; color: Theme.fg; font-size: Typography.secondary;
                                    horizontal-stretch: 1; vertical-alignment: center; }
                                Rectangle {
                                    width: 40px; height: 22px; border-radius: 11px;
                                    background: root.xr-prefer-dmabuf ? Theme.accent : Theme.bg_lighter;
                                    animate background { duration: 200ms; }
                                    Rectangle {
                                        x: root.xr-prefer-dmabuf ? parent.width - self.width - 3px : 3px;
                                        y: 3px; width: 16px; height: 16px; border-radius: 8px; background: white;
                                        animate x { duration: 200ms; easing: ease-in-out; }
                                    }
                                    TouchArea {
                                        clicked => { root.xr-prefer-dmabuf = !root.xr-prefer-dmabuf; root.xr-set-prefer-dmabuf(root.xr-prefer-dmabuf); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab9-flick.viewport-width;
                    viewport-x <=> tab9-flick.viewport-x;
                    visible-width: tab9-flick.width;
                }

                xr-scroll := Rectangle {
                    width: 3px;
                    x: parent.width - 3px;
                    background: Theme.bg_lighter;
                    visible: tab9-flick.viewport-height > tab9-flick.height;
                    Rectangle {
                        width: parent.width;
                        background: Theme.fg_dim;
                        height: parent.height * (tab9-flick.height / max(tab9-flick.viewport-height, 1px));
                        y: -tab9-flick.viewport-y * (parent.height / max(tab9-flick.viewport-height, 1px));
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════
            // HINTS TAB (Vimium-style keyboard navigation)
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 10: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab10-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 10px;

                        Text {
                            text: "\u{1F3AF}  Keyboard hints";
                            color: Theme.fg;
                            font-size: Typography.title;
                            font-weight: 700;
                        }

                        Text {
                            text: "Vimium-style overlay: press a keybind and every clickable widget on screen gets a two-letter label. Type the label to click, right-click, hover, drag, or scroll — no mouse required.";
                            color: Theme.fg_dim;
                            font-size: Typography.body;
                            wrap: word-wrap;
                        }

                        // ── Enable toggle card ──
                        Rectangle {
                            border-radius: 6px;
                            background: Theme.panel;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Enable keyboard hints"; color: Theme.fg; font-size: Typography.body; }
                                        Text { text: "Runs a small daemon (~15 MB idle) that holds the AT-SPI connection warm."; color: Theme.fg_dim; font-size: Typography.secondary; wrap: word-wrap; }
                                    }
                                    Rectangle {
                                        width: 40px; height: 22px; border-radius: 11px;
                                        background: root.hints-enabled ? Theme.accent : Theme.bg_lighter;
                                        animate background { duration: 200ms; }
                                        Rectangle {
                                            x: root.hints-enabled ? parent.width - self.width - 3px : 3px;
                                            y: 3px; width: 16px; height: 16px; border-radius: 8px; background: white;
                                            animate x { duration: 200ms; easing: ease-in-out; }
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.hints-enabled = !root.hints-enabled;
                                                root.hints-set-enabled(root.hints-enabled);
                                            }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }
                            }
                        }

                        // ── Keybindings reference card ──
                        Rectangle {
                            border-radius: 6px;
                            background: Theme.panel;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                Text {
                                    text: "Default keybindings";
                                    color: Theme.fg;
                                    font-size: Typography.body;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Rebind under the Keybindings tab.";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                }

                                Rectangle { height: 4px; background: transparent; }

                                for entry in [
                                    { key: "Super + ;",         action: "Click at hint" },
                                    { key: "Super + Shift + ;", action: "Right-click at hint" },
                                    { key: "Super + Ctrl + ;",  action: "Hover over hint" },
                                    { key: "Super + Alt + ;",   action: "Drag between two hints" },
                                    { key: "Super + H",         action: "Cursor mode (hjkl to move, Space to click)" },
                                    { key: "Super + Shift + H", action: "Scroll mode (j/k up/down, h/l left/right)" },
                                    { key: "Escape",            action: "Exit hint mode" }
                                ] : HorizontalLayout {
                                    spacing: 12px;
                                    Rectangle {
                                        width: 160px;
                                        background: Theme.bg;
                                        border-radius: 4px;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 4px; padding-bottom: 4px;
                                            Text {
                                                text: entry.key;
                                                color: Theme.fg;
                                                font-size: Typography.secondary;
                                                font-family: "monospace";
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Text {
                                        text: entry.action;
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        // ── Accessibility footnote ──
                        Rectangle {
                            border-radius: 6px;
                            background: Theme.panel;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text {
                                    text: "\u{2139}  Compatibility";
                                    color: Theme.fg;
                                    font-size: Typography.body;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "GTK apps work out of the box. Qt apps need QT_ACCESSIBILITY=1 in their environment. Electron/Chromium apps need --force-renderer-accessibility. If no hints appear on a specific app, that app is not exposing its widgets to AT-SPI.";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab10-flick.viewport-width;
                    viewport-x <=> tab10-flick.viewport-x;
                    visible-width: tab10-flick.width;
                }
                ScrollIndicator {
                    x: parent.width - 5px;
                    height: parent.height;
                    viewport-height: tab10-flick.viewport-height;
                    viewport-y: tab10-flick.viewport-y;
                    visible-height: tab10-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // KEYPAD TAB (CH552 macro keypads, control-surface daemon)
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 11: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab11-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    // Wide previews (many columns) scroll instead of being clipped.
                    viewport-width: max(self.width, 640px, tab11-content.min-width);
                    viewport-height: tab11-content.preferred-height;

                tab11-content := VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 10px;
                    padding-bottom: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.kp-wizard-open ? "Keypad firmware" : "Keypad";
                            color: Theme.fg;
                            font-size: Typography.heading;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        KeypadButton { text: "Refresh"; clicked => { root.kp-refresh(); } }
                    }

                    // ── Which keypads this supports ──
                    if !root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.info;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 10px;
                            Text {
                                text: "\u{2139}";
                                color: Theme.info;
                                font-size: Typography.heading;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: "Supports CH552-based macro keypads only: USB ID 1189:8890, the inexpensive \"MINI KeyBoard\"-style pads with 3 to 16 keys and up to 3 knobs.";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "Is yours one? Plug it in: a supported keypad shows up as connected just below. In a terminal, keypad-ctl present (or lsusb) finds USB ID 1189:8890. Other keypads won't show up here.";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                KeypadButton {
                                    text: "How to tell";
                                    clicked => { root.kp-open-scope-help(); }
                                }
                            }
                        }
                    }

                    if root.kp-status != "" && !root.kp-wizard-open: Text {
                        text: root.kp-status;
                        color: root.kp-status-is-error ? Theme.danger : Theme.fg_dim;
                        font-size: Typography.secondary;
                        wrap: word-wrap;
                    }

                    // ── Device: keypad (sysfs) and the keypad app ──
                    if !root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                // Filled dot = connected, ring = not connected.
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    y: 5px;
                                    border-radius: 5px;
                                    border-width: 2px;
                                    border-color: root.kp-connected || root.kp-bootloader ? Theme.success : Theme.fg_dim;
                                    background: root.kp-connected || root.kp-bootloader ? Theme.success : transparent;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.kp-device-title;
                                    color: Theme.fg;
                                    font-size: Typography.body;
                                    wrap: word-wrap;
                                }
                            }
                            if root.kp-device-detail != "": Text {
                                text: root.kp-device-detail;
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.kp-app-text;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                if root.kp-show-start: KeypadButton {
                                    text: "Start";
                                    primary: true;
                                    clicked => { root.kp-start-app(); }
                                }
                            }
                        }
                    }

                    // ── Variant ──
                    if !root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "Keypad variant";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }
                            if root.kp-variant-detected != "": HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Detected from the keypad: " + root.kp-variant-detected;
                                    color: Theme.fg;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                if !root.kp-variant-picker: KeypadButton {
                                    text: "Override…";
                                    clicked => { root.kp-override-variant(); }
                                }
                            }
                            if root.kp-variant-picker: KeypadVariantDropdown {
                                model: root.kp-variants;
                                current-index: root.kp-variant-index;
                                selected(i) => { root.kp-select-variant(i); }
                            }
                            if root.kp-variant-picker && root.kp-custom: HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                KeypadStepper {
                                    label: "Keys";
                                    value: root.kp-custom-keys;
                                    minimum: root.kp-custom-knobs > 0 ? 0 : 1;
                                    maximum: 16;
                                    changed(v) => { root.kp-set-custom(v, root.kp-custom-knobs, root.kp-custom-cols); }
                                }
                                KeypadStepper {
                                    label: "Knobs";
                                    value: root.kp-custom-knobs;
                                    minimum: root.kp-custom-keys > 0 ? 0 : 1;
                                    maximum: 3;
                                    changed(v) => { root.kp-set-custom(root.kp-custom-keys, v, root.kp-custom-cols); }
                                }
                                KeypadStepper {
                                    label: "Columns";
                                    value: root.kp-custom-cols;
                                    minimum: 1;
                                    maximum: 8;
                                    changed(v) => { root.kp-set-custom(root.kp-custom-keys, root.kp-custom-knobs, v); }
                                }
                            }
                            if root.kp-layout-note != "": Text {
                                text: root.kp-layout-note;
                                color: Theme.warning;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ── Layout + live identify ──
                    if !root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Layout: click a key or knob to map it";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                KeypadButton {
                                    text: root.kp-identify ? "Stop identifying" : "Press to identify";
                                    primary: root.kp-identify;
                                    clicked => { root.kp-toggle-identify(); }
                                }
                            }
                            if root.kp-live-note != "": Text {
                                text: root.kp-live-note;
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                            KeypadCanvas {
                                controls: root.kp-controls;
                                cols: root.kp-cols;
                                rows: root.kp-rows;
                                knobs: root.kp-knobs;
                                clicked(id) => { root.kp-select-control(id); }
                            }
                        }
                    }

                    // ── Mapping editor ──
                    if !root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "Mapping";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Profile";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                ResDropdown {
                                    horizontal-stretch: 1;
                                    model: root.kp-profile-names;
                                    current-index: root.kp-profile-index;
                                    selected(i) => { root.kp-select-profile(i); }
                                }
                                KeypadButton { text: "Add app"; clicked => { root.kp-start-add-profile(); } }
                                if !root.kp-profile-global: KeypadButton {
                                    text: "Remove";
                                    clicked => { root.kp-remove-profile(); }
                                }
                            }

                            if root.kp-adding-profile: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "New app";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                if root.kp-app-classes.length > 0: ResDropdown {
                                    width: 160px;
                                    model: root.kp-app-classes;
                                    current-index: -1;
                                    selected(i) => { root.kp-pick-app(i); }
                                }
                                KeypadInput {
                                    horizontal-stretch: 1;
                                    text <=> root.kp-new-app;
                                    placeholder: "Window class, e.g. org.kde.kdenlive";
                                    accepted => { root.kp-confirm-add-profile(); }
                                }
                                KeypadButton { text: "Add"; primary: true; clicked => { root.kp-confirm-add-profile(); } }
                                KeypadButton { text: "Cancel"; clicked => { root.kp-cancel-add-profile(); } }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Name";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                KeypadInput {
                                    horizontal-stretch: 1;
                                    text <=> root.kp-profile-name;
                                    placeholder: "Shown in the profile list and on the cheatsheet";
                                    accepted => { root.kp-apply-profile-details(); }
                                }
                                if root.kp-profile-global: KeypadButton { text: "Apply"; clicked => { root.kp-apply-profile-details(); } }
                            }
                            if !root.kp-profile-global: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Window class";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                KeypadInput {
                                    horizontal-stretch: 1;
                                    text <=> root.kp-profile-class;
                                    placeholder: "Regular expression, e.g. ^firefox$";
                                    accepted => { root.kp-apply-profile-details(); }
                                }
                            }
                            if !root.kp-profile-global: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Window title";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                KeypadInput {
                                    horizontal-stretch: 1;
                                    text <=> root.kp-profile-title;
                                    placeholder: "Optional regular expression: only while the title matches, e.g. YouTube";
                                    accepted => { root.kp-apply-profile-details(); }
                                }
                                KeypadButton { text: "Apply"; clicked => { root.kp-apply-profile-details(); } }
                            }
                            if !root.kp-profile-global: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Controls this profile leaves unset do what Global maps them to";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                KeypadToggle {
                                    on: root.kp-profile-fallthrough;
                                    toggled(on) => { root.kp-set-fallthrough(on); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "API plugin";
                                    width: 100px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                for plugin[idx] in ["None (key mapping)", "Kdenlive (D-Bus API)"]: Rectangle {
                                    height: Typography.compact-control;
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: (idx == 1) == root.kp-profile-kdenlive ? Theme.accent
                                        : plugin-touch.has-hover ? Theme.bg_lighter : Theme.bg;
                                    Text {
                                        text: plugin;
                                        color: (idx == 1) == root.kp-profile-kdenlive ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    plugin-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.kp-set-kdenlive(idx == 1); }
                                    }
                                }
                            }

                            if root.kp-profile-kdenlive: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Type the plain shortcuts while Kdenlive's control-surface interface is off";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                KeypadToggle {
                                    on: root.kp-profile-key-fallback;
                                    toggled(on) => { root.kp-set-key-fallback(on); }
                                }
                            }
                            if root.kp-profile-kdenlive: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Enable \"control-surface interface\" in Kdenlive's settings for API actions.";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                KeypadButton {
                                    text: "Load recommended layout";
                                    clicked => { root.kp-load-kdenlive-preset(); }
                                }
                            }
                            if root.kp-profile-note != "": Text {
                                text: root.kp-profile-note;
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 1px; background: Theme.bg_lighter; }

                            Text {
                                text: root.kp-selected-title;
                                color: Theme.fg;
                                font-size: Typography.body;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            if root.kp-selected-knob: HorizontalLayout {
                                spacing: 4px;
                                for event[idx] in ["Turn left", "Turn right", "Press"]: Rectangle {
                                    height: Typography.compact-control;
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.kp-knob-event == idx ? Theme.accent
                                        : event-touch.has-hover ? Theme.bg_lighter : Theme.bg;
                                    Text {
                                        text: event;
                                        color: root.kp-knob-event == idx ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    event-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.kp-select-knob-event(idx); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Action";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                ResDropdown {
                                    horizontal-stretch: 1;
                                    enabled: root.kp-editor-mode != 3 || root.kp-action-names.length > 1;
                                    model: root.kp-action-names;
                                    current-index: root.kp-action-index;
                                    selected(i) => { root.kp-select-action(i); }
                                }
                            }
                            if root.kp-editor-mode == 1: KeypadInput {
                                text <=> root.kp-action-text;
                                placeholder: root.kp-editor-hint;
                                accepted => { root.kp-apply-binding(); }
                            }
                            if root.kp-editor-mode == 2: ResDropdown {
                                model: root.kp-choice-names;
                                current-index: root.kp-choice-index;
                                selected(i) => { root.kp-select-choice(i); }
                            }
                            if root.kp-editor-mode == 3: Text {
                                text: root.kp-advanced-text;
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                            if root.kp-editor-hint != "": Text {
                                text: root.kp-editor-hint;
                                color: Theme.fg_dim;
                                font-size: Typography.caption;
                                wrap: word-wrap;
                            }
                            if root.kp-label-enabled && root.kp-sheet-supported: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Sheet label";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                KeypadInput {
                                    horizontal-stretch: 1;
                                    text <=> root.kp-label-text;
                                    placeholder: "Optional, e.g. Save; empty: made from the action";
                                    accepted => { root.kp-apply-binding(); }
                                }
                            }
                            if root.kp-label-enabled && root.kp-sheet-supported: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Icon";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: Typography.compact-control;
                                    height: Typography.compact-control;
                                    border-radius: 4px;
                                    background: Theme.bg;
                                    border-width: 1px;
                                    border-color: Theme.bg_lighter;
                                    Text {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        text: root.kp-icon-glyph;
                                        font-family: KeypadIcons.family;
                                        font-size: 20px;
                                        color: Theme.accent;
                                    }
                                }
                                Text {
                                    text: root.kp-icon-caption;
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                KeypadButton {
                                    text: root.kp-icon-picker-open ? "Close" : "Choose…";
                                    clicked => { root.kp-toggle-icon-picker(); }
                                }
                            }
                            if root.kp-label-enabled && root.kp-sheet-supported && root.kp-icon-picker-open: KeypadIconPicker {
                                icons: root.kp-icon-results;
                                current: root.kp-icon-name;
                                query <=> root.kp-icon-query;
                                search(t) => { root.kp-search-icons(t); }
                                picked(name) => { root.kp-pick-icon(name); }
                            }
                            if root.kp-label-enabled: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Only if installed";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                KeypadInput {
                                    horizontal-stretch: 1;
                                    text <=> root.kp-needs-text;
                                    placeholder: root.kp-needs-placeholder;
                                    accepted => { root.kp-apply-binding(); }
                                }
                            }
                            HorizontalLayout {
                                alignment: end;
                                if root.kp-editor-mode != 3: KeypadButton {
                                    text: "Apply to control";
                                    primary: true;
                                    clicked => { root.kp-apply-binding(); }
                                }
                            }
                        }
                    }

                    // ── Cheatsheet ──
                    if !root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Cheatsheet";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.kp-sheet-supported: KeypadButton {
                                    text: "Show on screen";
                                    clicked => { root.kp-show-sheet(); }
                                }
                            }
                            if !root.kp-sheet-supported: Text {
                                text: "The cheatsheet overlay shows what every key and knob does in the current app. It needs a newer keypad app (control-surface with cheatsheet support).";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                            if root.kp-sheet-supported: Text {
                                text: "An overlay of what every key and knob does in the app you're using. Map a key or knob press to \"Show the cheatsheet\" to bring it up.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                            if root.kp-sheet-supported && !root.kp-icons-shown: Text {
                                text: "Icons on the overlay need a newer keypad app. Icons you choose are saved and appear once it's updated.";
                                color: Theme.fg_dim;
                                font-size: Typography.caption;
                                wrap: word-wrap;
                            }
                            if root.kp-sheet-supported: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Opacity";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                ThemeSlider {
                                    horizontal-stretch: 1;
                                    minimum: 0.05;
                                    maximum: 1.0;
                                    step: 0.05;
                                    value: root.kp-sheet-opacity;
                                    changed(v) => { root.kp-set-sheet-opacity(v); }
                                }
                                Text {
                                    text: round(root.kp-sheet-opacity * 100) + "%";
                                    width: 44px;
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                            }
                            if root.kp-sheet-supported: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Hide";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                ResDropdown {
                                    horizontal-stretch: 1;
                                    model: root.kp-sheet-hide-names;
                                    current-index: root.kp-sheet-hide-index;
                                    selected(i) => { root.kp-set-sheet-hide(i); }
                                }
                            }
                            if root.kp-sheet-supported: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "Position";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                KeypadPositionPicker {
                                    current: root.kp-sheet-position;
                                    selected(i) => { root.kp-set-sheet-position(i); }
                                }
                            }
                            if root.kp-sheet-supported: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Click-through overlay: clicks reach the window below it";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                KeypadToggle {
                                    on: root.kp-sheet-click-through;
                                    toggled(on) => { root.kp-set-sheet-click-through(on); }
                                }
                            }
                            if root.kp-sheet-supported: Text {
                                text: root.kp-sheet-click-through
                                    ? "It hides by itself (see Hide) or when you press your cheatsheet key. Needs smplOS's updated bar (eww with click-through); an older bar keeps the overlay clickable."
                                    : "Click anywhere on the overlay to close it.";
                                color: Theme.fg_dim;
                                font-size: Typography.caption;
                                wrap: word-wrap;
                            }
                            if root.kp-sheet-supported && root.kp-sheet-contexts.length > 0: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Preview in";
                                    width: 96px;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                }
                                ResDropdown {
                                    horizontal-stretch: 1;
                                    model: root.kp-sheet-contexts;
                                    current-index: root.kp-sheet-context;
                                    selected(i) => { root.kp-set-sheet-context(i); }
                                }
                            }
                            if root.kp-sheet-supported: Text {
                                text: "Preview for the selected profile, with your unsaved changes:";
                                color: Theme.fg_dim;
                                font-size: Typography.caption;
                            }
                            if root.kp-sheet-supported: KeypadSheetPreview {
                                cells: root.kp-sheet-cells;
                                cols: root.kp-sheet-cols;
                                rows: root.kp-sheet-rows;
                                title: root.kp-sheet-title;
                                notice: root.kp-sheet-notice;
                                sheet-opacity: root.kp-sheet-opacity;
                            }
                        }
                    }

                    // ── Bindings of the selected profile ──
                    if !root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 2px;

                            Text {
                                text: "Mapped in this profile";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }
                            if root.kp-binding-rows.length == 0: Text {
                                text: "Nothing mapped yet.";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                            }
                            for row in root.kp-binding-rows: Rectangle {
                                height: Typography.row;
                                border-radius: 4px;
                                background: row-touch.has-hover ? Theme.hover : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 12px;
                                    Text {
                                        text: row.glyph;
                                        width: 20px;
                                        font-family: KeypadIcons.family;
                                        font-size: 16px;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: row.label;
                                        width: 170px;
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.summary;
                                        color: row.advanced ? Theme.fg_dim : Theme.fg;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.kp-select-control(row.slot); }
                                }
                            }
                        }
                    }

                    // ── Advanced: what would otherwise be hand-edited in the file ──
                    if !root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Advanced";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                KeypadButton {
                                    text: root.kp-advanced-open ? "Hide" : "Show";
                                    clicked => { root.kp-advanced-open = !root.kp-advanced-open; }
                                }
                            }
                            if !root.kp-advanced-open: Text {
                                text: "Input mode, knob and Kdenlive tuning, and the overlay switch. Saved like everything else here; no need to edit the file.";
                                color: Theme.fg_dim;
                                font-size: Typography.caption;
                                wrap: word-wrap;
                            }

                            if root.kp-advanced-open: Text {
                                text: "Input mode";
                                color: Theme.fg;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }
                            if root.kp-advanced-open: HorizontalLayout {
                                spacing: 4px;
                                for mode[idx] in ["Automatic", "Keymap (compatible)", "Raw (fastest, firmware 2.0.2+)"]: Rectangle {
                                    height: Typography.compact-control;
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.kp-input-index == idx ? Theme.accent
                                        : mode-touch.has-hover ? Theme.bg_lighter : Theme.bg;
                                    Text {
                                        text: mode;
                                        color: root.kp-input-index == idx ? Theme.bg : Theme.fg;
                                        font-size: Typography.secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    mode-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.kp-set-input-mode(idx); }
                                    }
                                }
                            }
                            if root.kp-advanced-open: Text {
                                text: root.kp-input-help;
                                color: Theme.fg_dim;
                                font-size: Typography.caption;
                                wrap: word-wrap;
                            }
                            if root.kp-advanced-open: HorizontalLayout {
                                spacing: 6px;
                                // Health by shape: a check mark or an exclamation mark.
                                Text {
                                    text: root.kp-input-healthy ? "\u{2713}" : "!";
                                    width: 14px;
                                    color: root.kp-input-healthy ? Theme.success : Theme.warning;
                                    font-size: Typography.secondary;
                                    font-weight: 700;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text {
                                        text: root.kp-input-now;
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        wrap: word-wrap;
                                    }
                                    if root.kp-input-health != "": Text {
                                        text: root.kp-input-health;
                                        color: Theme.fg_dim;
                                        font-size: Typography.caption;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.kp-advanced-open: Rectangle { height: 1px; background: Theme.bg_lighter; }
                            if root.kp-advanced-open: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Knobs";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.kp-tunings-custom: KeypadButton {
                                    text: "Reset to defaults";
                                    clicked => { root.kp-reset-tunings(); }
                                }
                            }
                            if root.kp-advanced-open: VerticalLayout {
                                spacing: 8px;
                            for t in root.kp-knob-tunings: VerticalLayout {
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: t.label;
                                        width: 120px;
                                        color: Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }
                                    ThemeSlider {
                                        horizontal-stretch: 1;
                                        minimum: t.min;
                                        maximum: t.max;
                                        step: t.step;
                                        value: t.value;
                                        changed(v) => { root.kp-set-tuning(t.key, v); }
                                    }
                                    Text {
                                        text: t.display;
                                        width: 110px;
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    Rectangle { width: 128px; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: t.help;
                                        color: Theme.fg_dim;
                                        font-size: Typography.caption;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            }
                            if root.kp-advanced-open: Text {
                                text: "Kdenlive (API plugin)";
                                color: Theme.fg;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }
                            if root.kp-advanced-open: VerticalLayout {
                                spacing: 8px;
                            for t in root.kp-kdenlive-tunings: VerticalLayout {
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: t.label;
                                        width: 120px;
                                        color: Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }
                                    ThemeSlider {
                                        horizontal-stretch: 1;
                                        minimum: t.min;
                                        maximum: t.max;
                                        step: t.step;
                                        value: t.value;
                                        changed(v) => { root.kp-set-tuning(t.key, v); }
                                    }
                                    Text {
                                        text: t.display;
                                        width: 110px;
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    Rectangle { width: 128px; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: t.help;
                                        color: Theme.fg_dim;
                                        font-size: Typography.caption;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            }

                            if root.kp-advanced-open: Rectangle { height: 1px; background: Theme.bg_lighter; }
                            if root.kp-advanced-open: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Draw the cheatsheet overlay through the bar (off: cheatsheet keys show nothing)";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                KeypadToggle {
                                    on: root.kp-sheet-overlay;
                                    toggled(on) => { root.kp-set-sheet-overlay(on); }
                                }
                            }
                            if root.kp-advanced-open: Text {
                                text: "Everything else (Kdenlive context layers and modes, per-binding speed) stays in the file: Open file below. Saving here keeps it.";
                                color: Theme.fg_dim;
                                font-size: Typography.caption;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ── Save ──
                    if !root.kp-wizard-open: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.kp-dirty ? "Unsaved changes" : root.kp-config-exists ? root.kp-config-path : "Not saved yet";
                            color: root.kp-dirty ? Theme.warning : Theme.fg_dim;
                            font-size: Typography.secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        KeypadButton { text: "Open file"; enabled: root.kp-config-exists; clicked => { root.kp-open-config(); } }
                        KeypadButton { text: "Revert"; enabled: root.kp-dirty; clicked => { root.kp-revert(); } }
                        KeypadButton {
                            text: root.kp-saving ? "Saving…" : "Save";
                            primary: true;
                            enabled: (root.kp-dirty || !root.kp-config-exists) && !root.kp-saving;
                            clicked => { root.kp-save(); }
                        }
                    }

                    // ── Firmware ──
                    if !root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text {
                                text: "Firmware";
                                color: Theme.fg_dim;
                                font-size: Typography.secondary;
                                font-weight: 600;
                            }
                            Text {
                                text: root.kp-firmware-text;
                                color: Theme.fg;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: start;
                                KeypadButton {
                                    text: root.kp-firmware == "open" ? "Update firmware…" : "Install open firmware…";
                                    clicked => { root.kp-open-wizard(); }
                                }
                            }
                        }
                    }

                    // ── Firmware wizard ──
                    if root.kp-wizard-open: Rectangle {
                        border-radius: 6px;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.kp-wizard-title;
                                    color: Theme.fg;
                                    font-size: Typography.body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.kp-dry-run: Rectangle {
                                    height: 22px;
                                    width: dry-label.preferred-width + 16px;
                                    border-radius: 11px;
                                    border-width: 1px;
                                    border-color: Theme.warning;
                                    dry-label := Text {
                                        text: "Dry run";
                                        color: Theme.warning;
                                        font-size: Typography.caption;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }

                            // Step dots: filled = done or current, ring = ahead.
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for i in 7: Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    border-width: 2px;
                                    border-color: i <= root.kp-wizard-step ? Theme.accent : Theme.bg_lighter;
                                    background: i <= root.kp-wizard-step ? Theme.accent : transparent;
                                }
                            }

                            if root.kp-wizard-step == 0: VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Macro keypads ship with their maker's stock firmware. The open firmware (the control-surface build of CH552-OpenMacroPad, CC BY-SA 3.0) describes its own layout, keeps its key map on the keypad, and lets smplOS read every key and knob directly.";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                                Rectangle {
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.warning;
                                    VerticalLayout {
                                        padding: 10px;
                                        Text {
                                            text: "\u{26A0} The stock firmware can't be read out or backed up. Once you flash, there is no way back to it. The keypad itself can always be reflashed: its update mode is built into the chip.";
                                            color: Theme.warning;
                                            font-size: Typography.secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    KeypadToggle {
                                        on: root.kp-wizard-ack;
                                        toggled(on) => { root.kp-set-wizard-ack(on); }
                                    }
                                    Text {
                                        text: "I understand that the stock firmware can't be restored";
                                        color: Theme.fg;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                    }
                                }
                                if root.kp-dry-run: Text {
                                    text: "This version runs the flash step as a dry run: it checks everything and shows what would happen, but writes nothing to the keypad.";
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                            }

                            if root.kp-wizard-step == 1: VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Choose the firmware to install.";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                }
                                if root.kp-fw-names.length > 0: ResDropdown {
                                    model: root.kp-fw-names;
                                    current-index: root.kp-fw-index;
                                    selected(i) => { root.kp-select-firmware(i); }
                                }
                                Text {
                                    text: root.kp-fw-detail;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                            }

                            if root.kp-wizard-step == 2: Text {
                                text: "Unplug the keypad from USB.";
                                color: Theme.fg;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }

                            if root.kp-wizard-step == 3: VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Hold down the top-left key, keep holding it, and plug the keypad back in. Release the key after a second. In update mode the keypad does nothing on its own, and it leaves update mode by itself after a few seconds of inactivity.";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                                // The key to hold, marked by a filled square and an arrow.
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    for i in 5: Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: i == 0 ? Theme.accent : Theme.bg_lighter;
                                        background: i == 0 ? Theme.accent : Theme.bg;
                                    }
                                    Text {
                                        text: "\u{2190} hold this key";
                                        color: Theme.fg_dim;
                                        font-size: Typography.secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if root.kp-wizard-step == 4: VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.kp-dry-run
                                        ? "Dry run: checks the image and the keypad in update mode, then lists the erase, program and verify steps without running wchisp."
                                        : "Flashing erases the code flash, writes the firmware and verifies it with wchisp. The chip's configuration registers are never changed. Keep the keypad plugged in.";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    KeypadButton {
                                        text: root.kp-flash-running ? "Working…" : root.kp-dry-run ? "Flash (dry run)" : "Flash";
                                        primary: true;
                                        enabled: !root.kp-flash-running;
                                        clicked => { root.kp-flash(); }
                                    }
                                }
                                for line in root.kp-flash-log: Text {
                                    text: line;
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                            }

                            if root.kp-wizard-step == 5: Text {
                                text: "Unplug the keypad and plug it in again normally, without holding any key.";
                                color: Theme.fg;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }

                            if root.kp-wizard-step == 6: VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Press every key and turn and press every knob. Each confirmed input gets a check mark (" + root.kp-verify-seen + " of " + root.kp-verify-total + ").";
                                    color: Theme.fg;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                                if root.kp-live-note != "": Text {
                                    text: root.kp-live-note;
                                    color: Theme.fg_dim;
                                    font-size: Typography.secondary;
                                    wrap: word-wrap;
                                }
                                KeypadCanvas {
                                    controls: root.kp-controls;
                                    cols: root.kp-cols;
                                    rows: root.kp-rows;
                                    knobs: root.kp-knobs;
                                    show-summary: false;
                                }
                            }

                            if root.kp-wizard-hint != "": Text {
                                text: root.kp-wizard-hint;
                                color: Theme.info;
                                font-size: Typography.secondary;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                KeypadButton {
                                    text: "Cancel";
                                    enabled: !root.kp-flash-running;
                                    clicked => { root.kp-close-wizard(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                KeypadButton {
                                    text: "Back";
                                    enabled: root.kp-wizard-step > 0 && !root.kp-flash-running;
                                    clicked => { root.kp-wizard-back(); }
                                }
                                KeypadButton {
                                    text: root.kp-wizard-step == 6 ? "Finish" : "Next";
                                    primary: true;
                                    enabled: root.kp-wizard-can-next;
                                    clicked => { root.kp-wizard-next(); }
                                }
                            }
                        }
                    }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab11-flick.viewport-width;
                    viewport-x <=> tab11-flick.viewport-x;
                    visible-width: tab11-flick.width;
                }
                ScrollIndicator {
                    x: parent.width - 5px;
                    height: parent.height;
                    viewport-height: tab11-flick.viewport-height;
                    viewport-y: tab11-flick.viewport-y;
                    visible-height: tab11-flick.height;
                }
            }

            // ══════════════════════════════════════════════════════════════
            // ABOUT TAB
            // ══════════════════════════════════════════════════════════════

            if root.active-tab == 0: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tab0-flick := Flickable {
                    width: parent.width - 6px;
                    height: parent.height;
                    viewport-width: max(self.width, 640px);

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 12px;

                Rectangle { vertical-stretch: 1; }

                // Logo / name
                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "smplOS";
                        color: Theme.accent;
                        font-size: 28px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.about-version;
                        color: Theme.fg_dim;
                        font-size: Typography.body;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "A simple, fast Arch-based desktop";
                        color: Theme.fg_dim;
                        font-size: Typography.secondary;
                        horizontal-alignment: center;
                    }
                }

                // System info card
                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    border-width: (root.highlight-setting == "About smplOS" || root.highlight-setting == "Version" || root.highlight-setting == "Hostname" || root.highlight-setting == "Kernel" || root.highlight-setting == "Uptime" || root.highlight-setting == "Compositor") && root.highlight-blink-on ? 2px : 0px;
                    border-color: (root.highlight-setting == "About smplOS" || root.highlight-setting == "Version" || root.highlight-setting == "Hostname" || root.highlight-setting == "Kernel" || root.highlight-setting == "Uptime" || root.highlight-setting == "Compositor") && root.highlight-blink-on ? Theme.accent : transparent;
                    animate border-width { duration: 400ms; easing: ease-in-out; }
                    animate border-color { duration: 400ms; easing: ease-in-out; }

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        // Hostname
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Hostname"; color: Theme.fg_dim; font-size: Typography.body; vertical-alignment: center; width: 80px; }
                            Text { text: root.about-hostname; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                        }

                        Rectangle { height: 1px; background: Theme.bg_lighter; }

                        // Kernel
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Kernel"; color: Theme.fg_dim; font-size: Typography.body; vertical-alignment: center; width: 80px; }
                            Text { text: root.about-kernel; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                        }

                        Rectangle { height: 1px; background: Theme.bg_lighter; }

                        // Uptime
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Uptime"; color: Theme.fg_dim; font-size: Typography.body; vertical-alignment: center; width: 80px; }
                            Text { text: root.about-uptime; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                        }

                        Rectangle { height: 1px; background: Theme.bg_lighter; }

                        // Compositor
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Compositor"; color: Theme.fg_dim; font-size: Typography.body; vertical-alignment: center; width: 80px; }
                            Text { text: "Hyprland"; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                        }

                        Rectangle { height: 1px; background: Theme.bg_lighter; }

                        // CPU
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "CPU"; color: Theme.fg_dim; font-size: Typography.body; vertical-alignment: center; width: 80px; }
                            Text { text: root.about-cpu; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                        }

                        Rectangle { height: 1px; background: Theme.bg_lighter; }

                        // RAM
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Memory"; color: Theme.fg_dim; font-size: Typography.body; vertical-alignment: center; width: 80px; }
                            Text { text: root.about-ram; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                        }

                        if root.about-gpu != "": Rectangle { height: 1px; background: Theme.bg_lighter; }

                        // GPU (if detected)
                        if root.about-gpu != "": HorizontalLayout {
                            spacing: 8px;
                            Text { text: "GPU"; color: Theme.fg_dim; font-size: Typography.body; vertical-alignment: center; width: 80px; }
                            Text { text: root.about-gpu; color: Theme.fg; font-size: Typography.body; vertical-alignment: center; }
                        }
                    }
                }

                Text {
                    text: "Part of smplOS";
                    color: Theme.fg_dim;
                    font-size: Typography.secondary;
                    horizontal-alignment: center;
                }

                Rectangle { vertical-stretch: 1; }
                }
                }

                HorizontalScrollIndicator {
                    y: parent.height - self.height;
                    width: parent.width - 10px;
                    viewport-width: tab0-flick.viewport-width;
                    viewport-x <=> tab0-flick.viewport-x;
                    visible-width: tab0-flick.width;
                }

                ScrollIndicator {
                    x: parent.width - 5px;
                    y: 0;
                    height: parent.height;
                    viewport-height: tab0-flick.viewport-height;
                    viewport-y: tab0-flick.viewport-y;
                    visible-height: tab0-flick.height;
                }
            }
        }
    }

    // ── Help overlay ─────────────────────────────────────────────────────────

    Rectangle {
        visible: root.show-help;
        width: 100%;
        height: 100%;
        background: transparent;

        Flickable {
            width: parent.width;
            height: parent.height;
            viewport-width: self.width;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;

                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text {
                        text: "Settings";
                        color: Theme.accent;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.app-version;
                        color: Theme.fg_dim;
                        font-size: Typography.body;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    border-radius: 6px;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: "Keyboard shortcuts";
                            color: Theme.accent;
                            font-size: Typography.body;
                            font-weight: 600;
                        }
                        Text {
                            text: "1-8       Switch tabs\nCtrl+F  Search settings\nAlt+C   Open layout dropdown\nAlt+A   Add selected layout\nAlt+D   Remove second layout\nAlt+I    Identify monitors\nAlt+R   Refresh monitors\nAlt+P   Move workspace 1 here\nEsc      Close overlay / app\n?         Toggle this Help";
                            color: Theme.fg;
                            font-size: Typography.body;
                            wrap: word-wrap;
                        }
                    }
                }

                Text {
                    text: "Part of smplOS";
                    color: Theme.fg_dim;
                    font-size: Typography.secondary;
                    horizontal-alignment: center;
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    // ── Inline search results dropdown ─────────────────────────────────────────

    if !root.show-help && root.search-results.length > 0 && root.global-search-text != "": Rectangle {
        x: root.width - 12px - 260px;
        y: 44px;
        width: 260px;
        height: min(280px, root.search-results.length * 34px + 8px);
        border-radius: 6px;
        background: Theme.bg_light;
        clip: true;

        // Prevent clicks from falling through
        TouchArea {}

        Flickable {
            width: parent.width;
            height: parent.height;

            VerticalLayout {
                spacing: 0px;
                padding: 4px;

                for result[idx] in root.search-results: Rectangle {
                    height: Typography.compact-control;
                    border-radius: 4px;
                    background: idx == root.search-selected-index ? Theme.accent :
                                sr-touch.has-hover ? Theme.bg_lighter : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: result.label;
                                color: idx == root.search-selected-index ? Theme.bg : Theme.fg;
                                font-size: Typography.body;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: result.tab-name;
                                color: idx == root.search-selected-index ? Theme.bg : Theme.fg_dim;
                                font-size: Typography.secondary;
                            }
                        }
                    }

                    sr-touch := TouchArea {
                        clicked => {
                            root.active-tab = result.tab-index;
                            root.global-search-text = "";
                            root.filter-search("");
                            focus-scope.focus();
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // ── Keyboard layout dropdown overlay ─────────────────────────────────────

    Rectangle {
        visible: root.dropdown-open && !root.show-help && root.active-tab == 1;
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => {
                root.dropdown-open = false;
                focus-scope.focus();
            }
        }

        Rectangle {
            x: 160px;
            y: 91px;
            width: root.width - 170px;
            height: 200px;
            border-radius: 4px;
            background: Theme.bg_light;
            border-width: 1px;
            border-color: Theme.bg_lighter;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                Rectangle {
                    height: Typography.compact-control;
                    border-radius: 4px;
                    background: Theme.bg;

                    search-input := TextInput {
                        x: 8px;
                        y: 6px;
                        width: parent.width - 16px;
                        height: parent.height;
                        color: Theme.fg;
                        font-size: Typography.body;
                        text <=> root.search-text;
                        edited => {
                            root.filter-layouts(self.text);
                            root.highlighted-dropdown-index = 0;
                            dropdown-flick.viewport-y = 0;
                        }
                        key-pressed(e) => {
                            if e.text == Key.DownArrow {
                                if root.highlighted-dropdown-index < root.available-layouts.length - 1 {
                                    root.highlighted-dropdown-index += 1;
                                }
                                dropdown-flick.viewport-y = root.dropdown-scroll-offset(
                                    root.highlighted-dropdown-index,
                                    Typography.compact-control / 1px, Typography.dropdown-spacing / 1px,
                                    dropdown-flick.height / 1px, dropdown-flick.viewport-height / 1px,
                                    dropdown-flick.viewport-y / 1px) * 1px;
                                return accept;
                            }
                            if e.text == Key.UpArrow {
                                if root.highlighted-dropdown-index > 0 {
                                    root.highlighted-dropdown-index -= 1;
                                }
                                dropdown-flick.viewport-y = root.dropdown-scroll-offset(
                                    root.highlighted-dropdown-index,
                                    Typography.compact-control / 1px, Typography.dropdown-spacing / 1px,
                                    dropdown-flick.height / 1px, dropdown-flick.viewport-height / 1px,
                                    dropdown-flick.viewport-y / 1px) * 1px;
                                return accept;
                            }
                            if e.text == Key.Return {
                                if root.available-layouts.length > 0 {
                                    root.selected-dropdown-index = root.highlighted-dropdown-index;
                                    root.dropdown-open = false;
                                    root.add-layout(root.highlighted-dropdown-index);
                                    focus-scope.focus();
                                }
                                return accept;
                            }
                            if e.text == Key.Escape {
                                root.dropdown-open = false;
                                focus-scope.focus();
                                return accept;
                            }
                            reject
                        }
                    }

                    Text {
                        visible: root.search-text == "";
                        x: 8px;
                        y: 6px;
                        height: parent.height;
                        text: "Search layouts...";
                        color: Theme.fg_dim;
                        font-size: Typography.body;
                        vertical-alignment: center;
                    }
                }

                dropdown-flick := Flickable {
                    VerticalLayout {
                        spacing: Typography.dropdown-spacing;
                        for item[idx] in root.available-layouts: Rectangle {
                            height: Typography.compact-control;
                            border-radius: 3px;
                            background: idx == root.highlighted-dropdown-index
                                ? Theme.accent.transparentize(50%)
                                : item-touch.has-hover ? Theme.accent.transparentize(70%) : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: item;
                                    color: idx == root.selected-dropdown-index ? Theme.accent : Theme.fg;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            item-touch := TouchArea {
                                moved => {
                                    root.highlighted-dropdown-index = idx;
                                }
                                clicked => {
                                    root.selected-dropdown-index = idx;
                                    root.dropdown-open = false;
                                    root.add-layout(idx);
                                    focus-scope.focus();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Dictation language dropdown overlay ───────────────────────────────────

    Rectangle {
        visible: root.dictation-lang-dropdown-open && root.active-tab == 2 && !root.show-help;
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => {
                root.dictation-lang-dropdown-open = false;
                focus-scope.focus();
            }
        }

        Rectangle {
            x: 160px;
            y: 91px;
            width: root.width - 170px;
            height: 200px;
            border-radius: 4px;
            background: Theme.bg_light;
            border-width: 1px;
            border-color: Theme.bg_lighter;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                Rectangle {
                    height: Typography.compact-control;
                    border-radius: 4px;
                    background: Theme.bg;

                    dictation-lang-search-input := TextInput {
                        x: 8px;
                        y: 6px;
                        width: parent.width - 16px;
                        height: parent.height;
                        color: Theme.fg;
                        font-size: Typography.body;
                        text <=> root.dictation-lang-search;
                        edited => {
                            root.filter-dictation-langs(self.text);
                            root.dictation-lang-highlighted-idx = 0;
                            dict-lang-flick.viewport-y = 0;
                        }
                        key-pressed(e) => {
                            if e.text == Key.DownArrow {
                                if root.dictation-lang-highlighted-idx < root.dictation-lang-list.length - 1 {
                                    root.dictation-lang-highlighted-idx += 1;
                                }
                                dict-lang-flick.viewport-y = root.dropdown-scroll-offset(
                                    root.dictation-lang-highlighted-idx,
                                    Typography.compact-control / 1px, Typography.dropdown-spacing / 1px,
                                    dict-lang-flick.height / 1px, dict-lang-flick.viewport-height / 1px,
                                    dict-lang-flick.viewport-y / 1px) * 1px;
                                return accept;
                            }
                            if e.text == Key.UpArrow {
                                if root.dictation-lang-highlighted-idx > 0 {
                                    root.dictation-lang-highlighted-idx -= 1;
                                }
                                dict-lang-flick.viewport-y = root.dropdown-scroll-offset(
                                    root.dictation-lang-highlighted-idx,
                                    Typography.compact-control / 1px, Typography.dropdown-spacing / 1px,
                                    dict-lang-flick.height / 1px, dict-lang-flick.viewport-height / 1px,
                                    dict-lang-flick.viewport-y / 1px) * 1px;
                                return accept;
                            }
                            if e.text == Key.Return {
                                if root.dictation-lang-list.length > 0 {
                                    root.select-dictation-lang(root.dictation-lang-highlighted-idx);
                                    root.dictation-lang-dropdown-open = false;
                                    focus-scope.focus();
                                }
                                return accept;
                            }
                            if e.text == Key.Escape {
                                root.dictation-lang-dropdown-open = false;
                                focus-scope.focus();
                                return accept;
                            }
                            reject
                        }
                    }

                    Text {
                        visible: root.dictation-lang-search == "";
                        x: 8px;
                        y: 6px;
                        height: parent.height;
                        text: "Search languages...";
                        color: Theme.fg_dim;
                        font-size: Typography.body;
                        vertical-alignment: center;
                    }
                }

                dict-lang-flick := Flickable {
                    VerticalLayout {
                        spacing: Typography.dropdown-spacing;
                        for item[idx] in root.dictation-lang-list: Rectangle {
                            height: Typography.compact-control;
                            border-radius: 3px;
                            background: idx == root.dictation-lang-highlighted-idx
                                ? Theme.accent.transparentize(50%)
                                : dict-lang-touch.has-hover ? Theme.accent.transparentize(70%) : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: item;
                                    color: Theme.fg;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            dict-lang-touch := TouchArea {
                                moved => {
                                    root.dictation-lang-highlighted-idx = idx;
                                }
                                clicked => {
                                    root.select-dictation-lang(idx);
                                    root.dictation-lang-dropdown-open = false;
                                    focus-scope.focus();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Loading spinner ──────────────────────────────────────────────────────

    if root.loading && root.active-tab == 1 && !root.show-help: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg.transparentize(30%);

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: "Loading layouts...";
                    color: Theme.fg_dim;
                    font-size: Typography.body;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
