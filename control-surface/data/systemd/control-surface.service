# Installed by scripts/install-user.sh but NOT enabled. After `scripts/verify-pad.sh`:
#   systemctl --user enable --now control-surface.service
[Unit]
Description=Control surface daemon for the CH552 macro pad (1189:8890)
Documentation=https://github.com/smpl-os/smpl-apps/blob/main/control-surface/README.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# The daemon waits (no pad, no compositor yet, a broken config, no uinput)
# rather than exiting; this only caps a crash loop.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/control-surfaced run --quiet
# smplOS draws the cheatsheet with its eww; to have the daemon push it there:
#   ExecStart=%h/.local/bin/control-surfaced run --quiet --eww-window pad-cheatsheet --eww-config %h/.config/eww
Restart=on-failure
RestartSec=2
# Grabs only 1189:8890 evdev nodes and creates one uinput keyboard; both rely on
# the session's input-group membership and the uaccess ACL on /dev/uinput.
# No sandboxing on purpose: "command" bindings start ordinary desktop apps as
# children of this service and would inherit any restriction set here.

[Install]
WantedBy=graphical-session.target
